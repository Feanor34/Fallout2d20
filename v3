        }

        function handleSurvivorTraitChange(cb) {
            const checked = document.querySelectorAll('.survivor-trait-check:checked');
            if (checked.length > 2) {
                cb.checked = false;
                alert("Solo podés seleccionar hasta 2 rasgos de origen.");
            }
        }

        function handleRobotModuleChange(cb) {
            const checked = document.querySelectorAll('.robot-mod-check:checked');
            if (checked.length > 3) {
                cb.checked = false;
                alert("Debés seleccionar exactamente 3 módulos de manos.");
            }
        }

        function validateStep1() {
            const nombre = document.getElementById('pj-nombre').value.trim();
            if (!nombre) {
                alert("Debes ingresar el nombre del personaje.");
                return false;
            }
            if (!selectedOrigin) {
                alert("Debes seleccionar un Origen de personaje.");
                return false;
            }
            if (selectedOrigin === 'Robot') {
                const checkedMods = document.querySelectorAll('.robot-mod-check:checked');
                if (checkedMods.length !== 3) {
                    alert("Debés seleccionar exactamente 3 módulos de manos para el Robot.");
                    return false;
                }
            }
            return true;
        }

        function validateAndGoStep2() {
            if (validateStep1()) {
                initSpecialStep();
                nextWizardStep(2);
            }
        }

        // --- PASO 2: ATRIBUTOS S.P.E.C.I.A.L. ---
        function initSpecialStep() {
            const originData = originLimits[selectedOrigin];
            
            // Asignación de bases por origen
            let fueBase = originData.base.FUE;
            let endBase = originData.base.END;

            document.getElementById('att-fue').value = fueBase;
            document.getElementById('att-per').value = originData.base.PER;
            document.getElementById('att-end').value = endBase;
            document.getElementById('att-car').value = originData.base.CAR;
            document.getElementById('att-int').value = originData.base.INT;
            document.getElementById('att-agi').value = originData.base.AGI;
            document.getElementById('att-sue').value = originData.base.SUE;

            let totalAllowed = 40;
            // Si el trait Gifted de Superviviente está activo
            const gifted = Array.from(document.querySelectorAll('.survivor-trait-check:checked')).some(c => c.value === 'gifted');
            if (selectedOrigin === 'Superviviente' && gifted) {
                totalAllowed += 2; // +1 en dos atributos
            }

            document.getElementById('special-total-allowed').innerText = totalAllowed;
            document.getElementById('origin-limits-info').innerText = 
                `Origen: ${selectedOrigin}. Máximos por Atributo -> FUE:${originData.max.FUE}, PER:${originData.max.PER}, END:${originData.max.END}, CAR:${originData.max.CAR}, INT:${originData.max.INT}, AGI:${originData.max.AGI}, SUE:${originData.max.SUE}. Total permitido: ${totalAllowed} pts.`;
            
            updateSpecial();
        }

        function updateSpecial() {
            if (!selectedOrigin) return;
            const limits = originLimits[selectedOrigin];
            const attrs = ['fue', 'per', 'end', 'car', 'int', 'agi', 'sue'];
            let total = 0;

            attrs.forEach(attr => {
                const input = document.getElementById(`att-${attr}`);
                let val = parseInt(input.value) || 4;
                const upperKey = attr.toUpperCase();
                const maxVal = limits.max[upperKey];

                if (val < limits.min) val = limits.min;
                if (val > maxVal) val = maxVal;
                
                input.value = val;
                total += val;
            });

            const totalAllowed = parseInt(document.getElementById('special-total-allowed').innerText);
            const pointsLeft = totalAllowed - total;
            
            document.getElementById('special-points-left').innerText = pointsLeft;
            document.getElementById('special-points-max').innerText = totalAllowed - 35;
            document.getElementById('special-total-sum').innerText = total;

            if (pointsLeft < 0) {
                document.getElementById('special-tracker').style.borderColor = 'var(--pipboy-alert)';
            } else {
                document.getElementById('special-tracker').style.borderColor = 'var(--pipboy-green)';
            }
        }

        function validateAndGoStep3() {
            updateSpecial();
            const total = parseInt(document.getElementById('special-total-sum').innerText);
            const totalAllowed = parseInt(document.getElementById('special-total-allowed').innerText);
            
            if (total !== totalAllowed) {
                alert(`Debes asignar exactamente todos los puntos disponibles de S.P.E.C.I.A.L. (Total acumulado actual: ${total} / ${totalAllowed}).`);
                return;
            }

            initSkillsStep();
            nextWizardStep(3);
        }

        // --- PASO 3: HABILIDADES Y RANGOS ---
        let skillRanks = {};
        let tagSelection = {};

        function getMaxTags() {
            let maxTags = 3;
            if (selectedOrigin === 'Vault Dweller' && document.getElementById('vd-nino')?.checked) {
                maxTags = 4;
            }
            if (selectedOrigin === 'Superviviente') {
                const educated = Array.from(document.querySelectorAll('.survivor-trait-check:checked')).some(c => c.value === 'educated');
                if (educated) maxTags = 4;
            }
            return maxTags;
        }

        function initSkillsStep() {
            const container = document.getElementById('skills-container');
            container.innerHTML = '';

            const maxTags = getMaxTags();
            document.getElementById('tag-max-display').innerText = maxTags;

            // Si es Ghoul, la habilidad Supervivencia se marca automáticamente como Tag
            if (selectedOrigin === 'Ghoul') {
                tagSelection['Supervivencia'] = true;
            }

            const limitsInfo = document.getElementById('skill-limits-info');
            if (selectedOrigin === 'Supermutante') {
                limitsInfo.innerText = "LÍMITE DE SUPERMUTANTE: Máximo 4 rangos TOTALES absolutos por habilidad (Rango Base + Bonus Tag <= 4).";
                limitsInfo.style.color = "var(--pipboy-alert)";
            } else {
                limitsInfo.innerText = "LÍMITE ESTÁNDAR: Máximo 6 rangos TOTALES por habilidad (Rango Base + Bonus Tag <= 6).";
                limitsInfo.style.color = "var(--pipboy-green)";
            }

            skillListOrdered.forEach(sObj => {
                const skill = sObj.name;
                if (!(skill in skillRanks)) skillRanks[skill] = 0;
                if (!(skill in tagSelection)) tagSelection[skill] = false;

                const isGhoulAutoTag = (selectedOrigin === 'Ghoul' && skill === 'Supervivencia');

                const card = document.createElement('div');
                card.className = 'skill-card';
                card.innerHTML = `
                    <label><strong>${skill}</strong> <span style="font-size:0.8em; color:var(--pipboy-highlight);">(${sObj.attr})</span> ${isGhoulAutoTag ? '<span style="font-size:0.75em; color:var(--pipboy-green);">(Tag Gratis Ghoul)</span>' : ''}</label>
                    <div class="skill-controls">
                        <span style="font-size: 0.8em;">Tag:</span>
                        <input type="checkbox" class="tag-checkbox" ${tagSelection[skill] ? 'checked' : ''} ${isGhoulAutoTag ? 'disabled' : ''} onchange="toggleTag('${skill}', this)">
                        <span style="font-size: 0.8em; margin-left: 5px;">Rango Base:</span>
                        <input type="number" id="skill-val-${skill}" value="${skillRanks[skill]}" min="0" max="6" onchange="updateSkills()">
                    </div>
                `;
                container.appendChild(card);
            });

            const detailedContainer = document.getElementById('skills-detailed-info-list');
            detailedContainer.innerHTML = '';
            skillListOrdered.forEach(sObj => {
                const itemDiv = document.createElement('div');
                itemDiv.className = 'skill-info-block';
                itemDiv.innerHTML = `
                    <strong>${sObj.name} (${sObj.attr})</strong>: ${sObj.desc}<br>
                    <span style="color: var(--pipboy-highlight);">&bull; Equipo obtenido si es Tag: ${tagSkillItems[sObj.name] || 'Ninguno especificado'}</span>
                `;
                detailedContainer.appendChild(itemDiv);
            });

            updateSkills();
        }

        function toggleTag(skill, checkbox) {
            let currentTagsCount = Object.keys(tagSelection).filter(k => {
                if (selectedOrigin === 'Ghoul' && k === 'Supervivencia') return false;
                return tagSelection[k];
            }).length;

            const maxTags = getMaxTags();

            if (checkbox.checked && currentTagsCount >= maxTags) {
                checkbox.checked = false;
                alert(`Solo podés seleccionar un máximo de ${maxTags} Habilidades Etiquetadas (Tags).`);
                return;
            }
            tagSelection[skill] = checkbox.checked;
            updateSkills();
        }

        function updateSkills() {
            const intVal = parseInt(document.getElementById('att-int').value) || 5;
            const totalSkillPointsAvailable = 9 + intVal;
            document.getElementById('skill-points-total').innerText = totalSkillPointsAvailable;

            const currentTagsCount = Object.keys(tagSelection).filter(k => {
                if (selectedOrigin === 'Ghoul' && k === 'Supervivencia') return false;
                return tagSelection[k];
            }).length;
            
            document.getElementById('tag-count').innerText = currentTagsCount;

            let pointsSpent = 0;
            const maxAllowedTotal = (selectedOrigin === 'Supermutante') ? 4 : 6;

            skillListOrdered.forEach(sObj => {
                const skill = sObj.name;
                const input = document.getElementById(`skill-val-${skill}`);
                if (!input) return;

                let val = parseInt(input.value) || 0;
                const isTag = tagSelection[skill];
                const tagBonus = isTag ? 2 : 0;

                // Límite estricto acumulado (Rango Base + Tag)
                if (val + tagBonus > maxAllowedTotal) {
                    val = Math.max(0, maxAllowedTotal - tagBonus);
                    alert(`El total absoluto para ${skill} no puede superar ${maxAllowedTotal} rangos (Rango Base + 2 de Tag). Se ajustó el Rango Base a ${val}.`);
                }

                if (val < 0) val = 0;
                input.value = val;

                skillRanks[skill] = val;
                pointsSpent += val;
            });

            const pointsLeft = totalSkillPointsAvailable - pointsSpent;
            document.getElementById('skill-points-left').innerText = pointsLeft;

            const summaryDiv = document.getElementById('skills-summary-list');
            let summaryHTML = '<ul>';
            
            skillListOrdered.forEach(sObj => {
                const skill = sObj.name;
                const isTag = tagSelection[skill];
                const rank = skillRanks[skill];
                const finalVal = rank + (isTag ? 2 : 0);
                
                if (isTag || rank > 0) {
                    summaryHTML += `<li><strong>${skill}</strong>: Rango Base ${rank} ${isTag ? '(+2 Tag = Total ' + finalVal + ')' : '(Total ' + finalVal + ')'}`;
                    if (isTag && tagSkillItems[skill]) {
                        summaryHTML += ` <br><span style="color: var(--pipboy-highlight);">&bull; Equipo obtenido por Tag: ${tagSkillItems[skill]}</span>`;
                    }
                    summaryHTML += `</li>`;
                }
            });
            summaryHTML += '</ul>';
            summaryDiv.innerHTML = summaryHTML;
        }

        function validateAndGoStep4() {
            updateSkills();
            const currentTagsCount = Object.keys(tagSelection).filter(k => {
                if (selectedOrigin === 'Ghoul' && k === 'Supervivencia') return false;
                return tagSelection[k];
            }).length;

            const maxTags = getMaxTags();

            if (currentTagsCount !== maxTags) {
                alert(`Debés elegir exactamente ${maxTags} Habilidades Etiquetadas (Tags) antes de continuar.`);
                return;
            }

            const pointsLeft = parseInt(document.getElementById('skill-points-left').innerText);
            if (pointsLeft !== 0) {
                alert(`Debes gastar exactamente todos los puntos de habilidad disponibles (Quedan ${pointsLeft} puntos sin asignar).`);
                return;
            }

            initPerksStep();
            nextWizardStep(4);
        }

        // --- PASO 4: PERK INICIAL Y VALIDACIÓN DE REQUISITOS ---
        function checkPerkRequirements(perk) {
            // Obtener Atributos actuales
            const attrs = {
                FUE: parseInt(document.getElementById('att-fue').value) || 0,
                PER: parseInt(document.getElementById('att-per').value) || 0,
                END: parseInt(document.getElementById('att-end').value) || 0,
                CAR: parseInt(document.getElementById('att-car').value) || 0,
                INT: parseInt(document.getElementById('att-int').value) || 0,
                AGI: parseInt(document.getElementById('att-agi').value) || 0,
                SUE: parseInt(document.getElementById('att-sue').value) || 0
            };

            // Evaluar requisitos de S.P.E.C.I.A.L y Rangos Totales de Habilidad
            for (let reqKey in perk.reqs) {
                const reqVal = perk.reqs[reqKey];
                if (reqKey in attrs) {
                    if (attrs[reqKey] < reqVal) return false;
                } else {
                    // Es requisito de habilidad (evalúa el rango TOTAL)
                    const baseRank = skillRanks[reqKey] || 0;
                    const isTag = tagSelection[reqKey] ? 2 : 0;
                    const totalRank = baseRank + isTag;
                    if (totalRank < reqVal) return false;
                }
            }
            return true;
        }

        function initPerksStep() {
            const container = document.getElementById('perks-cards-container');
            container.innerHTML = '';

            perksDetailedList.forEach((perk) => {
                const meetsReqs = checkPerkRequirements(perk);
                const card = document.createElement('div');
                card.className = `perk-card ${selectedPerk === perk.name ? 'selected' : ''} ${meetsReqs ? '' : 'locked'}`;

                if (meetsReqs) {
                    card.onclick = () => selectPerkCard(perk.name, card);
                } else {
                    card.onclick = () => alert(`No cumples los requisitos para este Perk: ${perk.reqText}`);
                }

                card.innerHTML = `
                    <div>
                        <h3>${perk.name}</h3>
                        <span style="font-size:0.75em; display:block; margin-top:2px;">Requisitos: ${perk.reqText} ${meetsReqs ? '✔' : '❌ (No cumplido)'}</span>
                    </div>
                    <p>${perk.desc}</p>
                `;
                container.appendChild(card);
            });
        }

        function selectPerkCard(perkName, cardElement) {
            selectedPerk = perkName;
            document.querySelectorAll('.perk-card').forEach(c => c.classList.remove('selected'));
            cardElement.classList.add('selected');
        }

        function validateAndGoStep5() {
            if (!selectedPerk) {
                alert("Debés seleccionar 1 Perk inicial para continuar.");
                return;
            }
            
            const selectedPerkObj = perksDetailedList.find(p => p.name === selectedPerk);
            if (selectedPerkObj && !checkPerkRequirements(selectedPerkObj)) {
                alert("El Perk seleccionado ya no cumple los requisitos vigentes.");
                return;
            }

            initDerivedStatsStep();
            nextWizardStep(5);
        }

        // --- PASO 5: ESTADÍSTICAS DERIVADAS Y EQUIPO ---
        function initDerivedStatsStep() {
            const fue = parseInt(document.getElementById('att-fue').value) || 5;
            const per = parseInt(document.getElementById('att-per').value) || 5;
            const end = parseInt(document.getElementById('att-end').value) || 5;
            const agi = parseInt(document.getElementById('att-agi').value) || 5;
            const sue = parseInt(document.getElementById('att-sue').value) || 5;

            let hpMax = end + fue;
            const iniciativa = per + agi;
            const defensa = (agi >= 9) ? 2 : 1;
            
            // Evaluar Suerte si tiene el trait Gifted
            const gifted = Array.from(document.querySelectorAll('.survivor-trait-check:checked')).some(c => c.value === 'gifted');
            let maxLuck = (selectedOrigin === 'Superviviente' && gifted) ? Math.max(0, sue - 1) : sue;

            // Evaluar Carga con Small Frame
            const smallFrame = Array.from(document.querySelectorAll('.survivor-trait-check:checked')).some(c => c.value === 'small_frame');
            let cargaMaxText = `${150 + (fue * (smallFrame ? 5 : 10))} lbs`;
            if (selectedOrigin === 'Robot') {
                cargaMaxText = "150 lbs (Fijo por Propulsión a jet)";
            }

            // Cálculo de Daño Cuerpo a Cuerpo (incluyendo Heavy Handed)
            let baseMeleeVal = 0;
            if (fue >= 9) baseMeleeVal = 2;
            else if (fue >= 7) baseMeleeVal = 1;
            else if (fue <= 3) baseMeleeVal = -1;

            const heavyHandedActive = Array.from(document.querySelectorAll('.survivor-trait-check:checked')).some(c => c.value === 'heavy_handed');
            if (heavyHandedActive) {
                baseMeleeVal += 1;
            }
            let meleeBonus = baseMeleeVal >= 0 ? `+${baseMeleeVal}` : `${baseMeleeVal}`;

            // Renderizado de Estadísticas Derivadas en el Paso 5
            const list = document.getElementById('derived-stats-list');
            list.innerHTML = `
                <li><strong>Puntos de Vida Máximos (HP):</strong> ${hpMax} (Resistencia + Fuerza)</li>
                <li><strong>Iniciativa Base:</strong> ${iniciativa} (Percepción + Agilidad)</li>
                <li><strong>Defensa Base:</strong> ${defensa}</li>
                <li><strong>Reserva Inicial de Suerte:</strong> ${maxLuck} Puntos ${gifted ? '(Reducido en 1 por Gifted)' : ''}</li>
                <li><strong>Capacidad de Carga Máxima:</strong> ${cargaMaxText}</li>
                <li><strong>Bono al daño cuerpo a cuerpo:</strong> ${meleeBonus}</li>
            `;

            // Renderizado de Trinkets (Soporte para lista y Trinket personalizado)
            const trContainer = document.getElementById('trinkets-cards-container');
            if (trContainer) {
                trContainer.innerHTML = '';
                if (!selectedTrinket && trinketsList.length > 0) selectedTrinket = trinketsList[0];

                const customCard = document.createElement('div');
                customCard.className = `selectable-card ${selectedTrinket && selectedTrinket.startsWith('CUSTOM:') ? 'selected' : ''}`;
                customCard.innerHTML = `
                    <h3>Trinket personalizado</h3>
                    <input type="text" id="custom-trinket-input" placeholder="[ Escribe tu Trinket ]" value="${selectedTrinket && selectedTrinket.startsWith('CUSTOM:') ? selectedTrinket.replace('CUSTOM:', '') : ''}" oninput="updateCustomTrinket(this)">
                `;
                customCard.onclick = (e) => {
                    if (e.target.tagName !== 'INPUT') {
                        const inp = document.getElementById('custom-trinket-input');
                        selectedTrinket = "CUSTOM:" + inp.value;
                        document.querySelectorAll('#trinkets-cards-container .selectable-card').forEach(c => c.classList.remove('selected'));
                        customCard.classList.add('selected');
                    }
                };
                trContainer.appendChild(customCard);

                trinketsList.forEach(t => {
                    const card = document.createElement('div');
                    card.className = `selectable-card ${selectedTrinket === t ? 'selected' : ''}`;
                    card.onclick = () => {
                        selectedTrinket = t;
                        document.querySelectorAll('#trinkets-cards-container .selectable-card').forEach(c => c.classList.remove('selected'));
                        card.classList.add('selected');
                    };
                    card.innerHTML = `
                        <h3>Objeto Personal</h3>
                        <p>${t}</p>
                    `;
                    trContainer.appendChild(card);
                });
            }
        }

        function updateCustomTrinket(input) {
            selectedTrinket = "CUSTOM:" + input.value;
            const customCard = input.closest('.selectable-card');
            document.querySelectorAll('#trinkets-cards-container .selectable-card').forEach(c => c.classList.remove('selected'));
            customCard.classList.add('selected');
        }

        function rollTrinket() {
            const idx = Math.floor(Math.random() * trinketsList.length);
            selectedTrinket = trinketsList[idx];
            initDerivedStatsStep(); // Actualiza la UI visual de las tarjetas al tirar los dados
        }

        // --- PASO 6: FICHA CONSOLIDADA FINAL ---
        function generateFinalSheet() {
