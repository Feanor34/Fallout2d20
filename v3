                        <li><strong>Propulsión a jet:</strong> Ignoras terrenos difíciles. Capacidad de carga 150 lbs fija.</li>
                        <li><strong>Mantenimiento Mecánico:</strong> Solo te recuperas con Reparaciones.</li>
                    </ul>
                    <h3 style="margin-top:10px;">Seleccioná tus 3 Módulos de Manos:</h3>
                    <table>
                        <thead>
                            <tr><th>Sel.</th><th>Módulo</th><th>Efecto</th></tr>
                        </thead>
                        <tbody>`;
                robotModulesOptions.forEach((mod) => {
                    html += `
                        <tr>
                            <td><input type="checkbox" class="robot-mod-check" value="${mod.name}" onchange="handleRobotModuleChange(this)"></td>
                            <td><strong>${mod.name}</strong></td>
                            <td>${mod.desc}</td>
                        </tr>`;
