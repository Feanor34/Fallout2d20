        if (wantLevelUp && levelUpPerkChosen) {
            perksText += `• ${levelUpPerkChosen} — Rango 1 (Subida de Nivel)\n`;
        }

        const limits = originLimits[selectedOrigin] || { max: { FUE: 10, PER: 10, END: 10, CAR: 10, INT: 10, AGI: 10, SUE: 10 } };

        let hpMax = end + fue + (wantLevelUp ? 1 : 0);
        const iniciativa = per + agi;
        const defensa = (agi >= 9) ? 2 : 1;
        const smallFrame = Array.from(document.querySelectorAll('.survivor-trait-check:checked')).some(c => c.value === 'small_frame');
        const gifted = Array.from(document.querySelectorAll('.survivor-trait-check:checked')).some(c => c.value === 'gifted');
        let maxLuck = (selectedOrigin === 'Superviviente' && gifted) ? Math.max(0, sue - 1) : sue;
        const cargaMax = (selectedOrigin === 'Robot') ? 150 : (150 + fue * (smallFrame ? 5 : 10));

        let chapas = 15;
        if (selectedEquipment === 'Colono') chapas = 45;
        if (selectedEquipment === 'Comerciante') chapas = 50;
        if (selectedEquipment === 'Vagabundo') chapas = 30;

        const sheetText = 
`==================================================
        FICHA DE PERSONAJE - FALLOUT RPG
==================================================
NOMBRE: ${nombre}
ORIGEN: ${selectedOrigin} | NIVEL: ${wantLevelUp ? "2" : "1"}

--------------------------------------------------
RASGOS
--------------------------------------------------
${traitsText.trim()}

--------------------------------------------------
ATRIBUTOS S.P.E.C.I.A.L.
--------------------------------------------------
Fuerza (FUE): ${fue} (Máx: ${limits.max.FUE}) | Percepción (PER): ${per} (Máx: ${limits.max.PER})
Resistencia (END): ${end} (Máx: ${limits.max.END}) | Carisma (CAR): ${car} (Máx: ${limits.max.CAR})
Inteligencia (INT): ${intVal} (Máx: ${limits.max.INT}) | Agilidad (AGI): ${agi} (Máx: ${limits.max.AGI})
Suerte (SUE): ${sue} (Máx: ${limits.max.SUE})

--------------------------------------------------
ESTADÍSTICAS DERIVADAS
--------------------------------------------------
• Puntos de Vida: ${hpMax}
• Puntos de Suerte: ${maxLuck}
• Peso transportable: ${cargaMax} lb
• Defensa: ${defensa}
• Iniciativa: ${iniciativa}

--------------------------------------------------
HABILIDADES
--------------------------------------------------
${skillsText.trim()}

--------------------------------------------------
PERKS
--------------------------------------------------
${perksText.trim()}

--------------------------------------------------
EQUIPAMIENTO
--------------------------------------------------
• Paquete Inicial: ${selectedEquipment}
• Objeto Personal / Trinket: ${selectedTrinket || 'Ninguno'}

--------------------------------------------------
CHAPAS Y EXPERIENCIA
--------------------------------------------------
CHAPAS: ${chapas}
EXPERIENCIA: 0
==================================================`;

        document.getElementById('final-sheet-display').innerText = sheetText;
        nextWizardStep(7);
    }
    </script>
