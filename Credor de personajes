        // Funcion que asegura que el paso 1 sea valido, con nombre y origen asignados
        function validateStep1() {
            const nombre = document.getElementById('pj-nombre').value.trim();
            if (!nombre) {
                alert("Debes ingresar el nombre del personaje.");
                return false;
            }
            if (!selectedOrigin) {
                alert("Debes seleccionar un Origen de personaje.");
                return false;
            }
            if (selectedOrigin === 'Mister_Handy') {
                const checkedMods = document.querySelectorAll('.robot-mod-check:checked');
                if (checkedMods.length !== 3) {
                    alert("Debés seleccionar exactamente 3 módulos de manos para el Mister Handy.");
                    return false;
                }
            }
            return true;
        }

        // Funcion que asegura que el paso 1 este completo, y avanza al 2
        function validateAndGoStep2() {
            if (validateStep1()) {
                initSpecialStep();
                nextWizardStep(2);
            }
        }

        // Funcion que revisa que Sobreviviente haya seleccionado gifted o no
        function isGiftedSelected() {
            if (selectedOrigin !== 'Superviviente') return false;
            return Array.from(document.querySelectorAll('.survivor-trait-check:checked')).some(c => c.value === 'gifted');
        }

        // Funcion que establece los SPECIAL
        function initSpecialStep() {
            const originData = originLimits[selectedOrigin];
            
            document.getElementById('att-fue').value = originData.base.FUE;
            document.getElementById('att-per').value = originData.base.PER;
            document.getElementById('att-end').value = originData.base.END;
            document.getElementById('att-car').value = originData.base.CAR;
            document.getElementById('att-int').value = originData.base.INT;
            document.getElementById('att-agi').value = originData.base.AGI;
            document.getElementById('att-sue').value = originData.base.SUE;

            const pointsToSpend = isGiftedSelected() ? 7 : 5;
            let attrs = ['fue', 'per', 'end', 'car', 'int', 'agi', 'sue'];
            let baseSum = 0;
            attrs.forEach(attr => {
                baseSum += originData.base[attr.toUpperCase()];
            });

            document.getElementById('special-total-allowed').innerText = baseSum + pointsToSpend;
            document.getElementById('special-points-left').innerText = pointsToSpend;
            
            updateSpecial();
        }

        // Funcion que actualiza los SPECIAL
        function updateSpecial() {
            if (!selectedOrigin) return;
            const limits = originLimits[selectedOrigin];
            const attrs = ['fue', 'per', 'end', 'car', 'int', 'agi', 'sue'];
            let totalAttributes = 0;

            attrs.forEach(attr => {
                const input = document.getElementById(`att-${attr}`);
                let val = parseInt(input.value) || 4;
                const upperKey = attr.toUpperCase();
                const maxVal = limits.max[upperKey];
                
                // Definimos el mínimo absoluto permitido como 4 (respetando tu regla)
                const minVal = 4;

                if (val < minVal) val = minVal;
                if (val > maxVal) val = maxVal;
                
                input.value = val;
                totalAttributes += val;
            });

            let baseSum = 0;
            attrs.forEach(attr => {
                baseSum += limits.base[attr.toUpperCase()];
            });

            const pointsToSpend = isGiftedSelected() ? 7 : 5;
            let pointsSpent = totalAttributes - baseSum;
            const pointsLeft = pointsToSpend - pointsSpent;
            
            document.getElementById('special-points-left').innerText = pointsLeft;
            if (document.getElementById('special-points-max')) {
                document.getElementById('special-points-max').innerText = pointsToSpend;
            }
            if (document.getElementById('special-total-allowed')) {
                document.getElementById('special-total-allowed').innerText = baseSum + pointsToSpend;
            }
            document.getElementById('special-total-sum').innerText = totalAttributes;

            if (pointsLeft < 0 || pointsLeft > pointsToSpend) {
                document.getElementById('special-tracker').style.borderColor = 'var(--pipboy-alert)';
            } else {
                document.getElementById('special-tracker').style.borderColor = 'var(--pipboy-green)';
            }
        }

        // Funcion que asegura que el paso 2 este completo y avanza al 3
        function validateAndGoStep3() {
            const limits = originLimits[selectedOrigin];
            const attrs = ['fue', 'per', 'end', 'car', 'int', 'agi', 'sue'];
            let totalAttributes = 0;

            // Validación de que ningún atributo sea menor al mínimo permitido (4) o que respete los rangos del origen (máximos y mínimos).
            for (let attr of attrs) {
                const input = document.getElementById(`att-${attr}`);
                const val = parseInt(input.value) || 0;
                const upperKey = attr.toUpperCase();
                const minVal = Math.max(4, limits.base[upperKey]); // Asegura que el mínimo absoluto sea 4 (o el base si fuera menor, pero respetando la regla de mínimo 4)
                const maxVal = limits.max[upperKey];

                if (val < 4) {
                    alert(`El atributo ${upperKey} no puede tener menos de 4 puntos (mínimo permitido).`);
                    return false;
                }

                if (val > maxVal) {
                    alert(`El atributo ${upperKey} excede el máximo permitido (${maxVal}) para este origen.`);
                    return false;
                }

                totalAttributes += val;
            }

            let baseSum = 0;
            attrs.forEach(attr => {
                baseSum += limits.base[attr.toUpperCase()];
            });

            const pointsToSpend = isGiftedSelected() ? 7 : 5;
            let pointsSpent = totalAttributes - baseSum;

            if (pointsSpent !== pointsToSpend) {
                alert(`Debes asignar exactamente todos los puntos disponibles. (Has gastado ${pointsSpent} de ` + pointsToSpend + ` puntos)`);
                return false;
            }

            initSkillsStep();
            nextWizardStep(3);
            return true;
        }

        let skillRanks = {};
        let tagSelection = {};

        // Funcion que asegura que el personaje sea ghoul o vault dweller necrotico
        function isGhoulOrNecroticVaultDweller() {
            if (selectedOrigin === 'Ghoul') return true;
            if (selectedOrigin === 'Vault_Dweller' && (document.getElementById('vd-gh')?.checked || document.getElementById('vd-ghoul')?.checked)) return true;
            return false;
        }

        // Funcion que asegura que la cantidad de tags sea correcta
        function getMaxTags() {
            let maxTags = 3;
            if (selectedOrigin === 'Vault_Dweller' && document.getElementById('vd-nino')?.checked) {
                maxTags = 4;
            }
            if (selectedOrigin === 'Superviviente') {
                const educated = Array.from(document.querySelectorAll('.survivor-trait-check:checked')).some(c => c.value === 'educated');
                if (educated) maxTags = 4;
            }
            return maxTags;
        }

        // Funcion que asegura que los puntos de habilidad maximas correspondan con el origen
        function initSkillsStep() {
            const container = document.getElementById('skills-container');
            container.innerHTML = '';

            const maxTags = getMaxTags();
            document.getElementById('tag-max-display').innerText = maxTags;

            if (isGhoulOrNecroticVaultDweller()) {
                tagSelection['Supervivencia'] = true;
            }

            const limitsInfo = document.getElementById('skill-limits-info');
            if (selectedOrigin === 'Supermutante') {
                limitsInfo.innerText = "LÍMITE DE SUPERMUTANTE: Máximo 4 rangos TOTALES absolutos por habilidad (Rango Base + Bonus Tag <= 4).";
                limitsInfo.style.color = "var(--pipboy-alert)";
            } else {
                limitsInfo.innerText = "LÍMITE ESTÁNDAR: Máximo 6 rangos TOTALES por habilidad (Rango Base + Bonus Tag <= 6).";
                limitsInfo.style.color = "var(--pipboy-green)";
            }

            skillListOrdered.forEach(sObj => {
                const skill = sObj.name;
                if (!(skill in skillRanks)) skillRanks[skill] = 0;
                if (!(skill in tagSelection)) tagSelection[skill] = false;

                const isAutoTag = (isGhoulOrNecroticVaultDweller() && skill === 'Supervivencia');

                const card = document.createElement('div');
                card.className = 'skill-card';
                card.innerHTML = `
                    <label><strong>${skill}</strong> <span style="font-size:0.8em; color:var(--pipboy-highlight);">(${sObj.attr})</span> ${isAutoTag ? '<span style="font-size:0.75em; color:var(--pipboy-green);">(Tag Gratis Post Humano)</span>' : ''}</label>
                    <div class="skill-controls">
                        <span style="font-size: 0.8em;">Tag:</span>
                        <input type="checkbox" class="tag-checkbox" ${tagSelection[skill] ? 'checked' : ''} ${isAutoTag ? 'disabled' : ''} onchange="toggleTag('${skill}', this)">
                        <span style="font-size: 0.8em; margin-left: 5px;">Rango Base:</span>
                        <input type="number" id="skill-val-${skill}" value="${skillRanks[skill]}" min="0" max="6" onchange="updateSkills()">
                    </div>
                `;
                container.appendChild(card);
            });

            const detailedContainer = document.getElementById('skills-detailed-info-list');
            detailedContainer.innerHTML = '';
            skillListOrdered.forEach(sObj => {
                const itemDiv = document.createElement('div');
                itemDiv.className = 'skill-info-block';
                itemDiv.innerHTML = `
                    <strong>${sObj.name} (${sObj.attr})</strong>: ${sObj.desc}<br>
                    <span style="color: var(--pipboy-highlight);">&bull; Equipo obtenido si es Tag: ${tagSkillItems[sObj.name] || 'Ninguno especificado'}</span>
                `;
                detailedContainer.appendChild(itemDiv);
            });

            updateSkills();
        }

        // Funcion que asegura que los tags sean usados, y que los tags automaticos sean colocados
        function toggleTag(skill, checkbox) {
            let currentTagsCount = Object.keys(tagSelection).filter(k => {
                if (isGhoulOrNecroticVaultDweller() && k === 'Supervivencia') return false;
                return tagSelection[k];
            }).length;

            const maxTags = getMaxTags();

            if (checkbox.checked && currentTagsCount >= maxTags) {
                checkbox.checked = false;
                alert(`Solo podés seleccionar un máximo de ${maxTags} Habilidades Etiquetadas (Tags).`);
                return;
            }
            tagSelection[skill] = checkbox.checked;
            updateSkills();
        }

        // Funcion que asegura que los puntos de habilidad se actualicen
        function updateSkills() {
            const intVal = parseInt(document.getElementById('att-int').value) || 5;
            const totalSkillPointsAvailable = 9 + intVal;
            document.getElementById('skill-points-total').innerText = totalSkillPointsAvailable;

            const currentTagsCount = Object.keys(tagSelection).filter(k => {
                if (isGhoulOrNecroticVaultDweller() && k === 'Supervivencia') return false;
                return tagSelection[k];
            }).length;
            
            document.getElementById('tag-count').innerText = currentTagsCount;

            let pointsSpent = 0;
            const maxAllowedTotal = (selectedOrigin === 'Supermutante') ? 4 : 6;

            skillListOrdered.forEach(sObj => {
                const skill = sObj.name;
                const input = document.getElementById(`skill-val-${skill}`);
                if (!input) return;

                let val = parseInt(input.value) || 0;
                const isTag = tagSelection[skill];
                const tagBonus = isTag ? 2 : 0;

                if (val + tagBonus > maxAllowedTotal) {
                    val = Math.max(0, maxAllowedTotal - tagBonus);
                    alert(`El total absoluto para ${skill} no puede superar ${maxAllowedTotal} rangos (Rango Base + 2 de Tag). Se ajustó el Rango Base a ${val}.`);
                }

                if (val < 0) val = 0;
                input.value = val;

                skillRanks[skill] = val;
                pointsSpent += val;
            });

            const pointsLeft = totalSkillPointsAvailable - pointsSpent;
            document.getElementById('skill-points-left').innerText = pointsLeft;

            const summaryDiv = document.getElementById('skills-summary-list');
            let summaryHTML = '<ul>';
            
            skillListOrdered.forEach(sObj => {
                const skill = sObj.name;
                const isTag = tagSelection[skill];
                const rank = skillRanks[skill];
                const finalVal = rank + (isTag ? 2 : 0);
                
                if (isTag || rank > 0) {
                    summaryHTML += `<li><strong>${skill}</strong>: Rango Base ${rank} ${isTag ? '(+2 Tag = Total ' + finalVal + ')' : '(Total ' + finalVal + ')'}`;
                    if (isTag && tagSkillItems[skill]) {
                        summaryHTML += ` <br><span style="color: var(--pipboy-highlight);">&bull; Equipo obtenido por Tag: ${tagSkillItems[skill]}</span>`;
                    }
                    summaryHTML += `</li>`;
                }
            });
            summaryHTML += '</ul>';
            summaryDiv.innerHTML = summaryHTML;
        }

        // Funcion que asegura que el paso 3 este completo y avance al 4
        function validateAndGoStep4() {
            updateSkills();
            const currentTagsCount = Object.keys(tagSelection).filter(k => {
                if (isGhoulOrNecroticVaultDweller() && k === 'Supervivencia') return false;
                return tagSelection[k];
            }).length;

            const maxTags = getMaxTags();

            if (currentTagsCount !== maxTags) {
                alert(`Debés elegir exactamente ${maxTags} Habilidades Etiquetadas (Tags) antes de continuar.`);
                return;
            }

            const pointsLeft = parseInt(document.getElementById('skill-points-left').innerText);
            if (pointsLeft !== 0) {
                alert(`Debes gastar exactamente todos los puntos de habilidad disponibles (Quedan ${pointsLeft} puntos sin asignar).`);
                return;
            }

            initPerksStep();
            nextWizardStep(4);
