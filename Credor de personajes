            { id: "perk080", img: "046", name: "Puño de Hierro", rank: 1, ranks: 2, reqs: { FUE: 6, Nivel: 1 }, reqText: "FUE 6, Nivel 1+", desc: "Tus ataques desarmados infligen +1 DCD de daño." },
            { id: "perk081", img: "046", name: "Puño de Hierro", rank: 2, ranks: 2, reqs: { FUE: 6, Nivel: 6 }, reqText: "FUE 6, Nivel 6+", desc: "Tus ataques desarmados infligen +1 DCD de daño y obtienen el efecto de daño Vicioso." },

            { id: "perk082", img: "047", name: "Vendedor de Jerky de Junktown", rank: 1, ranks: 1, reqs: { CAR: 8 }, reqText: "CAR 8", desc: "La dificultad de cualquier prueba de CHA + Trueque que realices para comprar o vender bienes se reduce en 1, hasta un mínimo de 0." },

            { id: "perk083", img: "048", name: "Reparación Improvisada", rank: 1, ranks: 1, reqs: {}, reqText: "Ninguno", desc: "Podés reparar un objeto sin tener que gastar ningún componente. Sin embargo, la reparación es temporal y el objeto volverá a romperse con la próxima complicación que sufras mientras lo utilizás. El rango de complicación de todas las pruebas de habilidad para utilizar el objeto aumenta en 1, hasta una tirada de 19–20." },

            { id: "perk084", img: "049", name: "Comandante Láser", rank: 1, ranks: 2, reqs: { PER: 8, Nivel: 2 }, reqText: "PER 8, Nivel 2+", desc: "Cuando realizás un ataque con un arma de energía a distancia, el daño aumenta en +1 DCD." },
            { id: "perk085", img: "049", name: "Comandante Láser", rank: 2, ranks: 2, reqs: { PER: 8, Nivel: 6 }, reqText: "PER 8, Nivel 6+", desc: "Cuando realizás un ataque con un arma de energía a distancia, el daño aumenta en +2 DCD." },

            { id: "perk086", img: "050", name: "Estómago de Plomo", rank: 1, ranks: 2, reqs: { END: 6, Nivel: 1 }, reqText: "END 6, Nivel 1+", desc: "Podés volver a tirar el CD utilizado para determinar si sufrís daño por radiación proveniente de comida o bebida irradiada." },
            { id: "perk087", img: "050", name: "Estómago de Plomo", rank: 2, ranks: 2, reqs: { END: 6, Nivel: 5 }, reqText: "END 6, Nivel 5+", desc: "Sos inmune al daño por radiación producido por consumir comida o bebida irradiada." },

            { id: "perk088", img: "051", name: "Dador de Vida", rank: 1, ranks: 5, reqs: { Nivel: 5 }, reqText: "Nivel 5+", desc: "Aumentá tus puntos de vida máximos en una cantidad igual a tu rango de Resistencia." },
            { id: "perk089", img: "051", name: "Dador de Vida", rank: 2, ranks: 5, reqs: { Nivel: 10 }, reqText: "Nivel 10+", desc: "Aumentá tus puntos de vida máximos en una cantidad igual a tu rango de Resistencia." },
            { id: "perk090", img: "051", name: "Dador de Vida", rank: 3, ranks: 5, reqs: { Nivel: 15 }, reqText: "Nivel 15+", desc: "Aumentá tus puntos de vida máximos en una cantidad igual a tu rango de Resistencia." },
            { id: "perk091", img: "051", name: "Dador de Vida", rank: 4, ranks: 5, reqs: { Nivel: 20 }, reqText: "Nivel 20+", desc: "Aumentá tus puntos de vida máximos en una cantidad igual a tu rango de Resistencia." },
            { id: "perk092", img: "051", name: "Dador de Vida", rank: 5, ranks: 5, reqs: { Nivel: 25 }, reqText: "Nivel 25+", desc: "Aumentá tus puntos de vida máximos en una cantidad igual a tu rango de Resistencia." },

            { id: "perk093", img: "052", name: "Paso Ligero", rank: 1, ranks: 1, reqs: {}, reqText: "Ninguno", desc: "Cuando tirás para generar complicaciones en cualquier prueba de habilidad basada en Agilidad, podés ignorar una complicación por cada 1 PA gastado. Además, podés volver a tirar 1d20 en cualquier prueba de AGI + Atletismo para evitar trampas activadas por placas de presión o mecanismos similares." },

            { id: "perk094", img: "053", name: "Maestro Ladrón", rank: 1, ranks: 1, reqs: { PER: 8, AGI: 9 }, reqText: "PER 8, AGI 9", desc: "Cuando intentás forzar una cerradura o robarle algo a alguien, la dificultad de la prueba de habilidad del oponente para detectarte aumenta en +1." },

            { id: "perk095", img: "054", name: "Médico", rank: 1, ranks: 1, reqs: { INT: 8 }, reqText: "INT 8", desc: "Cuando utilizás la acción Primeros auxilios para intentar tratar una herida, podés volver a tirar 1d20." },

            { id: "perk096", img: "055", name: "Fusión", rank: 1, ranks: 1, reqs: { PER: 10 }, reqText: "PER 10", desc: "Cuando matás a un enemigo con un arma de energía, explota. Tirá una cantidad de DCD igual a la mitad del valor de daño del arma (redondeado hacia abajo). Por cada Efecto obtenido, una criatura a alcance Corto del enemigo que explota, comenzando por la más cercana, sufre daño de energía igual al total obtenido en los DCD." },

            { id: "perk097", img: "056", name: "Señor de la Arena", rank: 1, ranks: 1, reqs: { AGI: 9 }, reqText: "AGI 9", desc: "Cuando realizás un ataque de sigilo con un arma silenciada o suprimida, el daño aumenta en +2 CD. No podés obtener este beneficio mientras llevás Servoarmadura." },

            { id: "perk098", img: "057", name: "Objetivo Móvil", rank: 1, ranks: 1, reqs: { AGI: 6 }, reqText: "AGI 6", desc: "Cuando realizás la acción Correr, tu Defensa aumenta en +1 hasta el comienzo de tu próximo turno." },

            { id: "perk099", img: "058", name: "Extraño Misterioso", rank: 1, ranks: 1, reqs: { LCK: 7 }, reqText: "LCK 7", desc: "De vez en cuando, un Extraño Misterioso viene en tu ayuda, con resultados letales. Al comienzo de un encuentro de combate, podés gastar 1 Punto de Suerte. Si lo hacés, en cualquier momento durante la escena el DJ puede hacer que aparezca el Extraño Misterioso, realice un único ataque a distancia contra un enemigo al que hayas atacado o que te haya atacado recientemente, y luego desaparezca. Si gastás un Punto de Suerte y el Extraño Misterioso no aparece, el DJ debe devolverte el Punto de Suerte que gastaste. El Extraño tiene AGI 10, una habilidad de Armas Pequeñas de 6 y considera Armas Pequeñas como una Habilidad Etiquetada. Siempre tira 3d20 para sus ataques, en lugar de 2d20, y su ataque —utilizando un revólver Magnum .44 personalizado— inflige 8 CD de daño físico Perforante 1, Vicioso. Siempre aparece dentro del alcance ideal de su arma. Cualquier intento de encontrar adónde fue el Extraño después de su ataque falla." },

            { id: "perk100", img: "059", name: "¡Rabia Nerd!", rank: 1, ranks: 3, reqs: { INT: 8, Nivel: 2 }, reqText: "INT 8, Nivel 2+", desc: "Mientras tu salud esté reducida a menos de ¼ de su máximo, agregás +1 a tu DR física, +1 a tu DR de energía y +1 CD al daño de todos tus ataques." },
            { id: "perk101", img: "059", name: "¡Rabia Nerd!", rank: 2, ranks: 3, reqs: { INT: 8, Nivel: 7 }, reqText: "INT 8, Nivel 7+", desc: "Mientras tu salud esté reducida a menos de ¼ de su máximo, agregás +2 a tu DR física, +2 a tu DR de energía y +2 CD al daño de todos tus ataques." },
            { id: "perk102", img: "059", name: "¡Rabia Nerd!", rank: 3, ranks: 3, reqs: { INT: 8, Nivel: 12 }, reqText: "INT 8, Nivel 12+", desc: "Mientras tu salud esté reducida a menos de ¼ de su máximo, agregás +3 a tu DR física, +3 a tu DR de energía y +3 CD al daño de todos tus ataques." },

            { id: "perk103", img: "060", name: "Persona Nocturna", rank: 1, ranks: 1, reqs: { PER: 7 }, reqText: "PER 7", desc: "Reducís en 1 cualquier aumento de dificultad debido a la oscuridad." },

            { id: "perk104", img: "061", name: "Ninja", rank: 1, ranks: 1, reqs: { AGI: 8 }, reqText: "AGI 8", desc: "Cuando realizás un ataque de sigilo con un arma cuerpo a cuerpo o un ataque desarmado, el daño aumenta en +2 CD. No podés obtener este beneficio mientras llevás Servoarmadura." },

            { id: "perk105", img: "062", name: "Físico Nuclear", rank: 1, ranks: 1, reqs: { INT: 9 }, reqText: "INT 9", desc: "Siempre que utilizás un arma que inflige daño por radiación o que tiene el efecto de daño Radiactivo, cada Efecto que obtenés inflige un punto adicional de daño por radiación. Además, los núcleos de fusión que utilizás tienen 3 cargas adicionales." },

            { id: "perk106", img: "063", name: "Tren del Dolor", rank: 1, ranks: 2, reqs: { FUE: 9, END: 7, Nivel: 1 }, reqText: "FUE 9, END 7, Nivel 1+", desc: "Podés realizar una Carga como acción mayor si llevás Servoarmadura o sos un supermutante. Esta es una acción de movimiento y no podés Moverte ni Correr durante el mismo turno. Cuando realizás esta acción, te movés hasta estar al alcance de un enemigo a alcance Medio (1 zona) y realizás una prueba de FUE + Atletismo con una dificultad de 2. Si tenés éxito, el enemigo sufre daño igual a tu daño desarmado normal y queda derribado. A criterio del DJ, especialmente las criaturas grandes o robustas no pueden ser derribadas mediante esta acción." },
            { id: "perk107", img: "063", name: "Tren del Dolor", rank: 2, ranks: 2, reqs: { FUE: 9, END: 7, Nivel: 6 }, reqText: "FUE 9, END 7, Nivel 6+", desc: "Podés realizar una Carga como acción mayor si llevás Servoarmadura o sos un supermutante. Cuando realizás esta acción y tenés éxito, el enemigo sufre daño igual a tu daño desarmado normal, queda derribado y el ataque agrega +1 DCD y el efecto de daño Aturdir." },

            { id: "perk108", img: "064", name: "Palma Paralizante", rank: 1, ranks: 1, reqs: { FUE: 8 }, reqText: "FUE 8", desc: "Cuando realizás un ataque desarmado y elegís golpear una ubicación específica, tu ataque obtiene el efecto de daño Aturdir." },

            { id: "perk109", img: "065", name: "Chico/Chica de Fiesta", rank: 1, ranks: 1, reqs: { END: 6, CAR: 7 }, reqText: "END 6, CAR 7", desc: "No podés volverte adicto a las bebidas alcohólicas y, siempre que tomás una bebida alcohólica, recuperás +2 PG." },

            { id: "perk110", img: "066", name: "Explorador", rank: 1, ranks: 1, reqs: { PER: 6, END: 6 }, reqText: "PER 6, END 6", desc: "Cuando viajás largas distancias a través del Yermo, una prueba exitosa de PER + Supervivencia (con una dificultad determinada por el DJ según el terreno) reduce a la mitad el tiempo de viaje." },

            { id: "perk111", img: "067", name: "Farmacéutico", rank: 1, ranks: 1, reqs: { LCK: 6 }, reqText: "LCK 6", desc: "Cuando saqueás una ubicación que contiene medicina o químicos, encontrás un objeto adicional, determinado aleatoriamente, sin gastar PA." },

            { id: "perk112", img: "068", name: "Carterista", rank: 1, ranks: 3, reqs: { PER: 8, AGI: 8, Nivel: 1 }, reqText: "PER 8, AGI 8, Nivel 1+", desc: "Podés ignorar la primera complicación que obtengas al realizar una prueba de AGI + Sigilo para robar un objeto de la persona de alguien o colocarle algo." },
            { id: "perk113", img: "068", name: "Carterista", rank: 2, ranks: 3, reqs: { PER: 8, AGI: 8, Nivel: 4 }, reqText: "PER 8, AGI 8, Nivel 4+", desc: "Podés volver a tirar 1d20 de tu reserva de dados cuando intentás robarle algo a alguien." },
            { id: "perk114", img: "068", name: "Carterista", rank: 3, ranks: 3, reqs: { PER: 8, AGI: 8, Nivel: 7 }, reqText: "PER 8, AGI 8, Nivel 7+", desc: "Reducís en 1 la dificultad de los intentos de robarle algo a alguien." },

            { id: "perk115", img: "069", name: "Golpe Perforante", rank: 1, ranks: 1, reqs: { FUE: 7 }, reqText: "FUE 7", desc: "Tus ataques utilizando ataques desarmados y armas cuerpo a cuerpo con filo obtienen el efecto de daño Perforante 1, o agregan +1 al valor de cualquier efecto de daño Perforante X que ya tuvieran." },

            { id: "perk116", img: "070", name: "Pirotécnico", rank: 1, ranks: 3, reqs: { END: 6, Nivel: 2 }, reqText: "END 6, Nivel 2+", desc: "El daño que infligís utilizando armas basadas en fuego aumenta en +1 CD." },
            { id: "perk117", img: "070", name: "Pirotécnico", rank: 2, ranks: 3, reqs: { END: 6, Nivel: 6 }, reqText: "END 6, Nivel 6+", desc: "El daño que infligís utilizando armas basadas en fuego aumenta en +2 CD." },
            { id: "perk118", img: "070", name: "Pirotécnico", rank: 3, ranks: 3, reqs: { END: 6, Nivel: 10 }, reqText: "END 6, Nivel 10+", desc: "El daño que infligís utilizando armas basadas en fuego aumenta en +3 CD." },

            { id: "perk119", img: "071", name: "Desenfunde Rápido", rank: 1, ranks: 1, reqs: { AGI: 6 }, reqText: "AGI 6", desc: "Cada turno, podés sacar un único arma u objeto que lleves encima sin utilizar una acción menor." },

            { id: "perk120", img: "072", name: "Manos Rápidas", rank: 1, ranks: 1, reqs: { AGI: 8 }, reqText: "AGI 8", desc: "Podés recargar armas de fuego más rápido. Cuando realizás un ataque a distancia, podés gastar 2 PA para aumentar en +2 la Cadencia de Fuego de tu arma para ese ataque." },

            { id: "perk121", img: "073", name: "Resistencia a la Radiación", rank: 1, ranks: 2, reqs: { END: 8, Nivel: 1 }, reqText: "END 8, Nivel 1+", desc: "Tu Resistencia al Daño por radiación, en todas las ubicaciones impactadas, aumenta en +1." },
            { id: "perk122", img: "073", name: "Resistencia a la Radiación", rank: 2, ranks: 2, reqs: { END: 8, Nivel: 5 }, reqText: "END 8, Nivel 5+", desc: "Tu Resistencia al Daño por radiación, en todas las ubicaciones impactadas, aumenta en +2." },

            { id: "perk123", img: "074", name: "Refractor", rank: 1, ranks: 2, reqs: { PER: 6, LCK: 7, Nivel: 1 }, reqText: "PER 6, LCK 7, Nivel 1+", desc: "Tu Resistencia al Daño de energía en todas las ubicaciones impactadas aumenta en +1." },
            { id: "perk124", img: "074", name: "Refractor", rank: 2, ranks: 2, reqs: { PER: 6, LCK: 7, Nivel: 5 }, reqText: "PER 6, LCK 7, Nivel 5+", desc: "Tu Resistencia al Daño de energía en todas las ubicaciones impactadas aumenta en +2." },

            { id: "perk125", img: "075", name: "Rebote", rank: 1, ranks: 1, reqs: { LCK: 10, Nivel: 5 }, reqText: "LCK 10, Nivel 5+", desc: "Si un enemigo realiza un ataque a distancia contra vos y obtiene una complicación, podés gastar un Punto de Suerte para hacer que su rebote lo impacte. Resolvé la tirada de daño contra el enemigo atacante." },

            { id: "perk126", img: "076", name: "Fusilero", rank: 1, ranks: 2, reqs: { AGI: 7, Nivel: 2 }, reqText: "AGI 7, Nivel 2+", desc: "Cuando realizás un ataque a distancia con cualquier arma de dos manos con una Cadencia de Fuego de 2 o menos (excepto armas pesadas), agregás +1 CD al daño del arma. En este rango, el arma no obtiene todavía Perforante." },
            { id: "perk127", img: "076", name: "Fusilero", rank: 2, ranks: 2, reqs: { AGI: 7, Nivel: 6 }, reqText: "AGI 7, Nivel 6+", desc: "Cuando realizás un ataque a distancia con cualquier arma de dos manos con una Cadencia de Fuego de 2 o menos (excepto armas pesadas), agregás +2 CD al daño del arma. Además, agregás el efecto de daño Perforante 1, o +1 al valor de cualquier efecto de daño Perforante X que el arma ya tuviera." },

            { id: "perk128", img: "077", name: "Experto en Robótica", rank: 1, ranks: 3, reqs: { INT: 8, Nivel: 2 }, reqText: "INT 8, Nivel 2+", desc: "Podés modificar armadura de robots, soportes de armas y módulos con mods de rango 1." },
            { id: "perk129", img: "077", name: "Experto en Robótica", rank: 2, ranks: 3, reqs: { INT: 8, Nivel: 6 }, reqText: "INT 8, Nivel 6+", desc: "Obtenés acceso a mods de rango 2 y la dificultad de las pruebas para reparar robots se reduce permanentemente en 1." },
            { id: "perk130", img: "077", name: "Experto en Robótica", rank: 3, ranks: 3, reqs: { INT: 8, Nivel: 10 }, reqText: "INT 8, Nivel 10+", desc: "Obtenés acceso a mods de rango 3 y podés reprogramar robots para cumplir una función diferente o alterar su comportamiento, a criterio del DJ." },

            { id: "perk131", img: "078", name: "¡Ciencia!", rank: 1, ranks: 3, reqs: { INT: 6, Nivel: 2 }, reqText: "INT 6, Nivel 2+", desc: "Podés modificar armas de energía con mods de armas y también podés fabricar ciertos mods avanzados de armadura. Este rango desbloquea mods de rango 1." },
            { id: "perk132", img: "078", name: "¡Ciencia!", rank: 2, ranks: 3, reqs: { INT: 6, Nivel: 6 }, reqText: "INT 6, Nivel 6+", desc: "Podés modificar armas de energía con mods de armas y también podés fabricar ciertos mods avanzados de armadura. Este rango desbloquea mods de rango 2." },
            { id: "perk133", img: "078", name: "¡Ciencia!", rank: 3, ranks: 3, reqs: { INT: 6, Nivel: 10 }, reqText: "INT 6, Nivel 10+", desc: "Podés modificar armas de energía con mods de armas y también podés fabricar ciertos mods avanzados de armadura. Este rango desbloquea mods de rango 3." },

            { id: "perk134", img: "079", name: "Canalla", rank: 1, ranks: 1, reqs: { CAR: 7 }, reqText: "CAR 7", desc: "Cuando realizás una prueba de CAR + Hablar para convencer a alguien de una mentira, podés ignorar la primera complicación que obtengas." },

            { id: "perk135", img: "080", name: "Chatarrero", rank: 1, ranks: 2, reqs: { Nivel: 3 }, reqText: "Nivel 3+", desc: "Cuando desarmás un objeto, podés recuperar materiales de componentes poco comunes además de los comunes (ver pág. 208)." },
            { id: "perk136", img: "080", name: "Chatarrero", rank: 2, ranks: 2, reqs: { Nivel: 8 }, reqText: "Nivel 8+", desc: "Cuando desarmás un objeto, podés recuperar materiales de componentes poco comunes y raros además de los comunes (ver pág. 208)." },

            { id: "perk137", img: "081", name: "Buscador de Munición", rank: 1, ranks: 3, reqs: { LCK: 6, Nivel: 1 }, reqText: "LCK 6, Nivel 1+", desc: "Siempre que tirás para determinar cuánta munición encontrás, encontrás +3 CD de disparos adicionales. La munición adicional es del mismo tipo que la encontrada originalmente." },
            { id: "perk138", img: "081", name: "Buscador de Munición", rank: 2, ranks: 3, reqs: { LCK: 6, Nivel: 6 }, reqText: "LCK 6, Nivel 6+", desc: "Siempre que tirás para determinar cuánta munición encontrás, encontrás +6 CD de disparos adicionales. La munición adicional es del mismo tipo que la encontrada originalmente." },
            { id: "perk139", img: "081", name: "Buscador de Munición", rank: 3, ranks: 3, reqs: { LCK: 6, Nivel: 11 }, reqText: "LCK 6, Nivel 11+", desc: "Siempre que tirás para determinar cuánta munición encontrás, encontrás +10 CD de disparos adicionales. La munición adicional es del mismo tipo que la encontrada originalmente." },

            { id: "perk140", img: "082", name: "Cirujano de Escopeta", rank: 1, ranks: 1, reqs: { FUE: 5, AGI: 7 }, reqText: "FUE 5, AGI 7", desc: "Tus ataques a distancia utilizando escopetas obtienen el efecto de daño Perforante 1, o agregan +1 a cualquier efecto de daño Perforante X que el arma ya tuviera." },

            { id: "perk141", img: "083", name: "Hábil", rank: 1, ranks: 10, reqs: { Nivel: 3 }, reqText: "Nivel 3+", desc: "Agregá +1 rango a dos habilidades o agregá +2 rangos a una habilidad. Ninguna habilidad puede tener más de 6 rangos." },
            { id: "perk142", img: "083", name: "Hábil", rank: 2, ranks: 10, reqs: { Nivel: 6 }, reqText: "Nivel 6+", desc: "Agregá +1 rango a dos habilidades o agregá +2 rangos a una habilidad. Ninguna habilidad puede tener más de 6 rangos." },
            { id: "perk143", img: "083", name: "Hábil", rank: 3, ranks: 10, reqs: { Nivel: 9 }, reqText: "Nivel 9+", desc: "Agregá +1 rango a dos habilidades o agregá +2 rangos a una habilidad. Ninguna habilidad puede tener más de 6 rangos." },
            { id: "perk144", img: "083", name: "Hábil", rank: 4, ranks: 10, reqs: { Nivel: 12 }, reqText: "Nivel 12+", desc: "Agregá +1 rango a dos habilidades o agregá +2 rangos a una habilidad. Ninguna habilidad puede tener más de 6 rangos." },
            { id: "perk145", img: "083", name: "Hábil", rank: 5, ranks: 10, reqs: { Nivel: 15 }, reqText: "Nivel 15+", desc: "Agregá +1 rango a dos habilidades o agregá +2 rangos a una habilidad. Ninguna habilidad puede tener más de 6 rangos." },
            { id: "perk146", img: "083", name: "Hábil", rank: 6, ranks: 10, reqs: { Nivel: 18 }, reqText: "Nivel 18+", desc: "Agregá +1 rango a dos habilidades o agregá +2 rangos a una habilidad. Ninguna habilidad puede tener más de 6 rangos." },
            { id: "perk147", img: "083", name: "Hábil", rank: 7, ranks: 10, reqs: { Nivel: 21 }, reqText: "Nivel 21+", desc: "Agregá +1 rango a dos habilidades o agregá +2 rangos a una habilidad. Ninguna habilidad puede tener más de 6 rangos." },
            { id: "perk148", img: "083", name: "Hábil", rank: 8, ranks: 10, reqs: { Nivel: 24 }, reqText: "Nivel 24+", desc: "Agregá +1 rango a dos habilidades o agregá +2 rangos a una habilidad. Ninguna habilidad puede tener más de 6 rangos." },
            { id: "perk149", img: "083", name: "Hábil", rank: 9, ranks: 10, reqs: { Nivel: 27 }, reqText: "Nivel 27+", desc: "Agregá +1 rango a dos habilidades o agregá +2 rangos a una habilidad. Ninguna habilidad puede tener más de 6 rangos." },
            { id: "perk150", img: "083", name: "Hábil", rank: 10, ranks: 10, reqs: { Nivel: 30 }, reqText: "Nivel 30+", desc: "Agregá +1 rango a dos habilidades o agregá +2 rangos a una habilidad. Ninguna habilidad puede tener más de 6 rangos." },

            { id: "perk151", img: "084", name: "El Tamaño Importa", rank: 1, ranks: 3, reqs: { END: 7, AGI: 6 }, reqText: "END 7, AGI 6", desc: "Cuando realizás un ataque a distancia con cualquier arma pesada, agregás +1 CD al daño del arma." },
            { id: "perk152", img: "084", name: "El Tamaño Importa", rank: 2, ranks: 3, reqs: { END: 7, AGI: 6, Nivel: 4 }, reqText: "END 7, AGI 6, Nivel 4+", desc: "Cuando realizás un ataque a distancia con cualquier arma pesada, agregás +2 CD al daño del arma." },
            { id: "perk153", img: "084", name: "El Tamaño Importa", rank: 3, ranks: 3, reqs: { END: 7, AGI: 6, Nivel: 8 }, reqText: "END 7, AGI 6, Nivel 8+", desc: "Cuando realizás un ataque a distancia con cualquier arma pesada, agregás +3 CD al daño del arma." },

            { id: "perk154", img: "085", name: "Asesino", rank: 1, ranks: 1, reqs: { FUE: 8 }, reqText: "FUE 8", desc: "Cuando infligís cualquier cantidad de daño con un ataque desarmado o un arma cuerpo a cuerpo, podés gastar 1 Punto de Suerte para infligir inmediatamente un golpe crítico —y, por lo tanto, una herida— en la ubicación impactada." },

            { id: "perk155", img: "086", name: "Conversador Suave", rank: 1, ranks: 1, reqs: { CAR: 6 }, reqText: "CAR 6", desc: "Cuando realizás una prueba de Trueque o Hablar como parte de una prueba enfrentada, podés volver a tirar 1d20." },

            { id: "perk156", img: "087", name: "Come Serpientes", rank: 1, ranks: 1, reqs: { END: 7 }, reqText: "END 7", desc: "Tu Resistencia al Daño por veneno aumenta en +2." },

            { id: "perk157", img: "088", name: "Francotirador", rank: 1, ranks: 1, reqs: { PER: 8, AGI: 6 }, reqText: "PER 8, AGI 6", desc: "Cuando realizás la acción menor Apuntar y luego realizás un ataque a distancia con un arma de dos manos que tenga la propiedad Precisa, podés especificar una ubicación para impactar sin aumentar la dificultad del ataque." },

            { id: "perk158", img: "089", name: "Alimentado por el Sol", rank: 1, ranks: 1, reqs: { END: 7 }, reqText: "END 7", desc: "Por cada hora que pasás bajo la luz solar directa, curás 1 punto de daño por radiación." },

            { id: "perk159", img: "090", name: "Puntería Estable", rank: 1, ranks: 1, reqs: { FUE: 8, AGI: 7 }, reqText: "FUE 8, AGI 7", desc: "Cuando realizás la acción menor Apuntar, podés volver a tirar 2d20 en el primer ataque que realices durante este turno, o volver a tirar 1d20 en todos los ataques que realices durante este turno." },

            { id: "perk160", img: "091", name: "Espalda Fuerte", rank: 1, ranks: 3, reqs: { FUE: 5, Nivel: 1 }, reqText: "FUE 5, Nivel 1+", desc: "Tu peso de carga máximo aumenta en +25 lb." },
            { id: "perk161", img: "091", name: "Espalda Fuerte", rank: 2, ranks: 3, reqs: { FUE: 5, Nivel: 3 }, reqText: "FUE 5, Nivel 3+", desc: "Tu peso de carga máximo aumenta en +50 lb." },
            { id: "perk162", img: "091", name: "Espalda Fuerte", rank: 3, ranks: 3, reqs: { FUE: 5, Nivel: 5 }, reqText: "FUE 5, Nivel 5+", desc: "Tu peso de carga máximo aumenta en +75 lb." },

            { id: "perk163", img: "092", name: "¡TAG!", rank: 1, ranks: 1, reqs: { Nivel: 5 }, reqText: "Nivel 5+", desc: "Podés seleccionar una Habilidad Etiquetada adicional. Aumentá el rango de la habilidad en 2, hasta un máximo de 6, y marcala como Habilidad Etiquetada, permitiéndote obtener un éxito crítico con un resultado de d20 igual o inferior al rango de la habilidad." },

            { id: "perk164", img: "093", name: "Presencia Aterradora", rank: 1, ranks: 2, reqs: { FUE: 6, CAR: 8, Nivel: 3 }, reqText: "FUE 6, CAR 8, Nivel 3+", desc: "Cuando realizás una prueba de Hablar para amenazar o asustar a alguien, podés volver a tirar 1d20." },
            { id: "perk165", img: "093", name: "Presencia Aterradora", rank: 2, ranks: 2, reqs: { FUE: 6, CAR: 8, Nivel: 8 }, reqText: "FUE 6, CAR 8, Nivel 8+", desc: "Podés utilizar una acción mayor durante el combate para amenazar a un enemigo a alcance Medio, utilizando una prueba de FUE + Hablar con una dificultad de 2. Si tenés éxito, ese enemigo debe alejarse de vos durante su próximo turno (aunque puede realizar cualquier otra acción que desee)." },

            { id: "perk166", img: "094", name: "Dureza", rank: 1, ranks: 2, reqs: { END: 6, LCK: 6, Nivel: 1 }, reqText: "END 6, LCK 6, Nivel 1+", desc: "Tu Resistencia al Daño físico en todas las ubicaciones impactadas aumenta en +1." },
            { id: "perk167", img: "094", name: "Dureza", rank: 2, ranks: 2, reqs: { END: 6, LCK: 6, Nivel: 5 }, reqText: "END 6, LCK 6, Nivel 5+", desc: "Tu Resistencia al Daño físico en todas las ubicaciones impactadas aumenta en +2." },

            { id: "perk167", img: "095", name: "La Cadena que nos Une a Todos", rank: 1, ranks: 2, reqs: { Nivel: 3 }, reqText: "Iniciado de la Hermandad o No Humano, Nivel 3+", desc: "Cada vez que adquirís esta Ventaja, elegí una rama de servicio apropiada de la Hermandad de la lista de Iniciado de la Hermandad. Estableciste contactos y conexiones con esa rama, y obtenés la capacidad de gastar 2 AP para solicitar refuerzos de esa rama una vez por aventura.\n\nSi todavía no estabas sujeto a la Cadena que nos Une, ahora lo estás. No necesitás tener el origen Iniciado de la Hermandad para adquirir esta Ventaja; solo necesitás ser miembro de la Hermandad, incluso si no sos humano. El hecho de que tengas que adquirir una Ventaja para obtener acceso a los refuerzos no representa que la Hermandad del Medio Oeste sea lenta a la hora de aceptar no humanos, sino que refleja el hecho de que ya obtuviste un Origen que te dio cosas geniales. Un no humano incluso podría unirse a una rama de Mariposa si demostró ser tan competente que la Hermandad no puede darse el lujo de rechazar su ayuda." },
            { id: "perk168", img: "095", name: "La Cadena que nos Une a Todos", rank: 2, ranks: 2, reqs: { Nivel: 6 }, reqText: "Iniciado de la Hermandad o No Humano, Nivel 6+", desc: "Cada vez que adquirís esta Ventaja, elegí una rama de servicio apropiada de la Hermandad de la lista de Iniciado de la Hermandad. Estableciste contactos y conexiones con esa rama, y obtenés la capacidad de gastar 2 AP para solicitar refuerzos de esa rama una vez por aventura.\n\nSi todavía no estabas sujeto a la Cadena que nos Une, ahora lo estás. No necesitás tener el origen Iniciado de la Hermandad para adquirir esta Ventaja; solo necesitás ser miembro de la Hermandad, incluso si no sos humano. El hecho de que tengas que adquirir una Ventaja para obtener acceso a los refuerzos no representa que la Hermandad del Medio Oeste sea lenta a la hora de aceptar no humanos, sino que refleja el hecho de que ya obtuviste un Origen que te dio cosas geniales. Un no humano incluso podría unirse a una rama de Mariposa si demostró ser tan competente que la Hermandad no puede darse el lujo de rechazar su ayuda." },

            { id: "perk169", img: "096", name: "Visionario", rank: 1, ranks: 2, reqs: { CAR: 6, LCK: 7, Nivel: 2 }, reqText: "Tribal, CAR 6+, LCK 7+, Nivel 2+", desc: "Como chamán, podés buscar la guía y sabiduría del mundo espiritual, emprendiendo una búsqueda de visión para prepararte a vos y a tus aliados para el desafío que tienen por delante.\n\nCon una dosis de Vudú, Punga u otro psicodélico apropiado, vos y hasta otras nueve personas pueden emprender una búsqueda de visión una vez por aventura. No existe riesgo de adicción; sabés cómo administrar correctamente la droga con fines religiosos, incluso a Ghouls, Supermutantes y Deathclaws. Esta búsqueda de visión los asaltará a todos con cuatro horas de alucinaciones que parecen reflejar el futuro, el pasado y sus miedos más oscuros. Recuerdos, enemigos, presagios y Muñecos de Vault-Tec los asaltarán a todos. El GM puede elegir describir las visiones, hacer que cada jugador dé un breve resumen de lo que ve o simplemente dejarlo a su imaginación.\n\nNo se necesitan pruebas de habilidad para este proceso; ya sea que superen estas amenazas o simplemente tengan un viaje muy, muy malo, los ecos del futuro los han preparado para lo que está por venir. Durante los próximos dos días, el chamán puede elegir gastar sus Puntos de Suerte para que otros participantes utilicen la capacidad Mazo Marcado, y estos utilizarán el LCK del chamán en lugar del suyo cuando lo haga.\n\nCada vez que adquirís esta Ventaja, el Nivel requerido aumenta en 5." },
            { id: "perk170", img: "096", name: "Visionario", rank: 2, ranks: 2, reqs: { CAR: 6, LCK: 7, Nivel: 7 }, reqText: "Tribal, CAR 6+, LCK 7+, Nivel 7+", desc: "Como chamán, podés buscar la guía y sabiduría del mundo espiritual, emprendiendo una búsqueda de visión para prepararte a vos y a tus aliados para el desafío que tienen por delante.\n\nCon una dosis de Vudú, Punga u otro psicodélico apropiado, vos y hasta otras nueve personas pueden emprender una búsqueda de visión una vez por aventura. No existe riesgo de adicción; sabés cómo administrar correctamente la droga con fines religiosos, incluso a Ghouls, Supermutantes y Deathclaws. Esta búsqueda de visión los asaltará a todos con cuatro horas de alucinaciones que parecen reflejar el futuro, el pasado y sus miedos más oscuros. Recuerdos, enemigos, presagios y Muñecos de Vault-Tec los asaltarán a todos. El GM puede elegir describir las visiones, hacer que cada jugador dé un breve resumen de lo que ve o simplemente dejarlo a su imaginación.\n\nNo se necesitan pruebas de habilidad para este proceso; ya sea que superen estas amenazas o simplemente tengan un viaje muy, muy malo, los ecos del futuro los han preparado para lo que está por venir. Durante los próximos dos días, el chamán puede elegir gastar sus Puntos de Suerte para que otros participantes utilicen la capacidad Mazo Marcado, y estos utilizarán el LCK del chamán en lugar del suyo cuando lo haga.\n\nEn Rango 2, el beneficio de la búsqueda de visión dura durante toda la aventura, en lugar de solo un par de días.\n\nCada vez que adquirís esta Ventaja, el Nivel requerido aumenta en 5." },

            { id: "perk171", img: "097", name: "Operaciones Encubiertas", rank: 1, ranks: 2, reqs: {}, reqText: "Rasgo Elegido del Maestro", desc: "Tu uso extensivo de los Stealth Boys ha vuelto sus efectos más potentes. Siempre que utilizás un Stealth Boy, sus efectos duran el doble de lo normal, hasta un máximo de 4 veces la duración normal. Cada vez que adquirís esta Ventaja, el límite de nivel aumenta en 4." },
            { id: "perk172", img: "097", name: "Operaciones Encubiertas", rank: 2, ranks: 2, reqs: {}, reqText: "Rasgo Elegido del Maestro", desc: "Tu uso extensivo de los Stealth Boys ha vuelto sus efectos más potentes. Siempre que utilizás un Stealth Boy, sus efectos duran el doble de lo normal, hasta un máximo de 4 veces la duración normal. Cada vez que adquirís esta Ventaja, el límite de nivel aumenta en 4." },

            { id: "perk173", img: "098", name: "Presencia Alarmante", rank: 1, ranks: 2, reqs: { FUE: 7, CAR: 4, Nivel: 3 }, reqText: "FUE 7, CAR 4, Deathclaw, Nivel 3+", desc: "Esta Ventaja funciona igual que la Ventaja Presencia Aterradora del Manual Básico. Cada vez que adquirís esta Ventaja, el requisito de Nivel aumenta en 3." },
            { id: "perk174", img: "098", name: "Presencia Alarmante", rank: 2, ranks: 2, reqs: { FUE: 7, CAR: 4, Nivel: 6 }, reqText: "FUE 7, CAR 4, Deathclaw, Nivel 6+", desc: "Esta Ventaja funciona igual que la Ventaja Presencia Aterradora del Manual Básico. Cada vez que adquirís esta Ventaja, el requisito de Nivel aumenta en 3." },

            { id: "perk175", img: "099", name: "Alfa/Matriarca", rank: 1, ranks: 1, reqs: { FUE: 11, RES: 11, Nivel: 8 }, reqText: "FUE 11+, RES 11+, Deathclaw, Nivel 8+", desc: "Te convertiste verdaderamente en un depredador alfa. Ahora solo sufrís un Golpe Crítico si un ataque inflige 7+ de daño (después de la Resistencia al Daño) en un solo impacto, en lugar del 5+ normal. Esto se acumula con la Ventaja Esqueleto de Adamantio. Además, ahora obtenés +3 de Salud por nivel en lugar de +1.\n\nAdemás, tanto los Deathclaws Inteligentes como los No Inteligentes te considerarán un igual digno de respeto. No te atacarán activamente a vos ni a tus aliados a menos que los ataques primero." },

            { id: "perk176", img: "100", name: "Camaleón", rank: 1, ranks: 1, reqs: { Nivel: 1 }, reqText: "Deathclaw, Nivel 1+", desc: "Tu piel es capaz de mostrar colores vibrantes según tu estado de ánimo y actividad. Como acción gratuita, podés cambiar el color de tu piel." },

            { id: "perk177", img: "101", name: "Resplandeciente", rank: 1, ranks: 3, reqs: { RES: 10, Nivel: 5 }, reqText: "RES 10, Deathclaw, Sin Rangos en Quantum'd, Nivel 5+", desc: "La exposición a niveles extremos de radiación hizo que brilles de color verde en la oscuridad. Además de proporcionar luz dentro de Alcance Cercano, infligís 2 Dados de Combate de daño de Radiación a cualquiera (incluidos aliados) que se encuentre a tu Alcance, y tus ataques Desarmado obtienen el efecto de daño Radiactivo. Cada rango de esta Ventaja aumenta el daño de Radiación por cada Efecto obtenido en +1.\n\nCada vez que adquirís esta Ventaja, el requisito de Nivel aumenta en 5." },
            { id: "perk178", img: "101", name: "Resplandeciente", rank: 2, ranks: 3, reqs: { RES: 10, Nivel: 10 }, reqText: "RES 10, Deathclaw, Sin Rangos en Quantum'd, Nivel 10+", desc: "La exposición a niveles extremos de radiación hizo que brilles de color verde en la oscuridad. Además de proporcionar luz dentro de Alcance Cercano, infligís 2 Dados de Combate de daño de Radiación a cualquiera (incluidos aliados) que se encuentre a tu Alcance, y tus ataques Desarmado obtienen el efecto de daño Radiactivo. Cada rango de esta Ventaja aumenta el daño de Radiación por cada Efecto obtenido en +1.\n\nEn Rango 3, infligís daño de Radiación a cualquiera (incluidos aliados) que se encuentre dentro de Alcance Cercano.\n\nCada vez que adquirís esta Ventaja, el requisito de Nivel aumenta en 5." },
            { id: "perk179", img: "101", name: "Resplandeciente", rank: 3, ranks: 3, reqs: { RES: 10, Nivel: 15 }, reqText: "RES 10, Deathclaw, Sin Rangos en Quantum'd, Nivel 15+", desc: "La exposición a niveles extremos de radiación hizo que brilles de color verde en la oscuridad. Además de proporcionar luz dentro de Alcance Cercano, infligís 2 Dados de Combate de daño de Radiación a cualquiera (incluidos aliados) que se encuentre a tu Alcance, y tus ataques Desarmado obtienen el efecto de daño Radiactivo. Cada rango de esta Ventaja aumenta el daño de Radiación por cada Efecto obtenido en +1.\n\nEn Rango 3, infligís daño de Radiación a cualquiera (incluidos aliados) que se encuentre dentro de Alcance Cercano.\n\nCada vez que adquirís esta Ventaja, el requisito de Nivel aumenta en 5." },

            { id: "perk180", img: "102", name: "Garras Ágiles", rank: 1, ranks: 1, reqs: { AGI: 7, Nivel: 3 }, reqText: "AGI 7, Deathclaw, Nivel 3+", desc: "Después de muchas horas de práctica, sos capaz de manipular tus garras con la precisión suficiente como para aproximarte al rango de movimiento de las manos humanas normales.\n\nSi sos una variante Bruto, ahora podés realizar tareas que requieren control motor fino (como utilizar una computadora), además de comenzar a adquirir rangos en las habilidades Cerrajería, Medicina, Pilotear, Reparación y Ciencia. Sin embargo, el rango de Complicación para estas habilidades aumenta en 2 (18-20).\n\nSi sos una variante Cerebro, el aumento de tu rango de Complicación se elimina por completo." },

            { id: "perk181", img: "103", name: "Quantum'd", rank: 1, ranks: 1, reqs: { RES: 8, Nivel: 5 }, reqText: "RES 8, Deathclaw, Sin Rangos en Resplandeciente, Nivel 5+", desc: "Al igual que con la Ventaja Resplandeciente, el consumo y/o la exposición a grandes cantidades de Nuka Cola Quantum hizo que brilles de color azul en la oscuridad. Además de proporcionar luz dentro de Alcance Cercano, ahora sos inmune al Veneno y podés tirar un Dado de Combate menos al determinar si te volvés adicto a los químicos, hasta un mínimo de 0. Si la adquirís teniendo un Rango en la Ventaja Resistente a los Químicos, te volvés inmune a la adicción." },

            { id: "perk182", img: "104", name: "Golpe Desgarrador", rank: 1, ranks: 1, reqs: { FUE: 10, Nivel: 2 }, reqText: "FUE 10, Deathclaw, Nivel 2+", desc: "Sos capaz de asestar un golpe letal con mayor facilidad utilizando tus garras. Podés aumentar en +1 la Dificultad de un ataque Desarmado. Si tiene éxito, el daño del ataque aumenta en +2 Dados de Combate." },

            { id: "perk183", img: "105", name: "Disciplina de Ranger", rank: 1, ranks: 2, reqs: { Nivel: 5 }, reqText: "Rasgo La Fuerza del Oso, Nivel 5+", desc: "Completaste con éxito tu entrenamiento de Ranger y te uniste a los Mejores de la RNC. Obtenés una habilidad etiquetada (Tag) adicional de la siguiente lista: Armas Pequeñas, Armas Grandes, Armas de Energía, Desarmado, Cuerpo a Cuerpo, Explosivos, Supervivencia, Hablar o Sigilo. Además, tu posición inspira respeto entre los soldados normales de la RNC, quienes pueden ayudarte en combate si están cerca. Sin embargo, esto tiene el efecto contrario: los enemigos de la RNC tienen muchas más probabilidades de apuntar hacia vos que antes y pueden enviar a algunos de sus mejores combatientes para enfrentarte." },
            { id: "perk184", img: "105", name: "Disciplina de Ranger", rank: 2, ranks: 2, reqs: { Nivel: 8 }, reqText: "Rasgo La Fuerza del Oso, Nivel 8+", desc: "Superaste a los demás miembros del Cuerpo de Rangers y te convertiste en uno de los enemigos más formidables del Yermo. Tu sola presencia infunde miedo en el corazón de muchos y tu entrenamiento no tiene igual. Al realizar una tirada para intimidar a alguien, podés tirar 1d20 adicional. Además, podés repetir una cantidad de dados igual a 5+RES por encuentro de combate. También obtenés una habilidad etiquetada (Tag) adicional de la lista anterior y la dificultad de todas las pruebas realizadas para rastrear a un objetivo se reduce permanentemente en 1." },
            { id: "perk185", img: "105", name: "Disciplina de Ranger", rank: 1, ranks: 2, reqs: { Nivel: 5 }, reqText: "Rasgo La Fuerza del Oso, Nivel 5+", desc: "Esta Ventaja no puede adquirirse al subir de nivel. Debe ser otorgada por el Supervisor, ya sea al alcanzar ciertos hitos dentro del juego o durante la creación del personaje en niveles superiores." },

            { id: "perk186", img: "106", name: "Médico de Combate", rank: 1, ranks: 1, reqs: {}, reqText: "Rasgo La Fuerza del Oso, Rama Médica", desc: "Recibiste entrenamiento para administrar primeros auxilios de manera efectiva y rápida durante el combate y otras situaciones peligrosas. Podés utilizar Primeros Auxilios como una Acción Menor en lugar de una Acción Mayor. Además, una vez por aventura podés reducir en 1 la dificultad de tratar una lesión, hasta un mínimo de 0." },

            { id: "perk187", img: "107", name: "Imperialista Despectivo", rank: 1, ranks: 3, reqs: {}, reqText: "Rasgo La Fuerza del Oso", desc: "No tenés demasiada simpatía por los saqueadores, drogadictos o tribales que intentan \"establecerse\" o \"sobrevivir\" en tierras civilizadas. Por cada rango de esta Ventaja que adquirís, obtenés 1 Dado de Combate adicional para los ataques dirigidos contra tribales, saqueadores o adictos a los químicos. Por cada rango de esta Ventaja que adquirís, el límite de nivel aumenta en 5." },

            { id: "perk188", img: "108", name: "No Nos Iremos en Silencio", rank: 2, ranks: 3, reqs: {}, reqText: "Rasgo La Fuerza del Oso", desc: "A medida que la Legión se adentra lentamente en el territorio de tu patria, no vas a caer sin dar pelea. Por cada rango de esta Ventaja que adquirís, obtenés 1 Dado de Combate adicional para los ataques dirigidos contra cualquier miembro de la Legión de César. Por cada rango de esta Ventaja que adquirís, el límite de nivel aumenta en 5." },
            { id: "perk189", img: "108", name: "No Nos Iremos en Silencio", rank: 3, ranks: 3, reqs: {}, reqText: "Rasgo La Fuerza del Oso", desc: "A medida que la Legión se adentra lentamente en el territorio de tu patria, no vas a caer sin dar pelea. Por cada rango de esta Ventaja que adquirís, obtenés 1 Dado de Combate adicional para los ataques dirigidos contra cualquier miembro de la Legión de César. Por cada rango de esta Ventaja que adquirís, el límite de nivel aumenta en 5." },

            { id: "perk190", img: "109", name: "Superviviente Entrenado", rank: 1, ranks: 3, reqs: {}, reqText: "Rasgo La Fuerza del Oso, Rama Explorador", desc: "Tu entrenamiento como explorador te dio amplios conocimientos sobre cómo sobrevivir en las implacables tierras salvajes del Yermo. Por cada rango de esta Ventaja que adquirís, cuando realizás una prueba de Supervivencia para recolectar/buscar comida y agua limpia, rastrear a una criatura o humanoide, o buscar refugio, podés tirar 1d20 adicional para la prueba. Por cada rango de esta Ventaja que adquirís, el límite de nivel aumenta en 5." },

            { id: "perk191", img: "110", name: "Reclutamiento No Convencional", rank: 1, ranks: 1, reqs: {}, reqText: "Rasgo Post-Humano Necrótico o Evolución Forzada", desc: "A pesar de ser extremadamente raro, te permitieron unirte a las filas del ejército de la RNC. Esto no evita que algunos sigan teniendo prejuicios hacia vos, solamente significa que la organización no está en contra. Aun así, es difícil ascender de rango debido a los prejuicios de quienes te rodean. Tus ascensos siempre son más difíciles." },

            { id: "perk192", img: "111", name: "¡Bendito Sea el Radio!", rank: 1, ranks: 2, reqs: { END: 7, Nivel: 3 }, reqText: "Rasgo El Resplandor de Atom, RES 7, Nivel 3+", desc: "Tu Resistencia al Daño de Radiación, en todas las ubicaciones impactadas, aumenta en +2, hasta un total de +4. Cuando infligís daño de Radiación, agregás +1 Dado de Combate al daño por rango. Además, esto desbloquea varias modificaciones.\n\nCada vez que adquirís esta Ventaja, el requisito de Nivel aumenta en 4." },
            { id: "perk193", img: "111", name: "¡Bendito Sea el Radio!", rank: 2, ranks: 2, reqs: { END: 7, Nivel: 7 }, reqText: "Rasgo El Resplandor de Atom, RES 7, Nivel 7+", desc: "Tu Resistencia al Daño de Radiación, en todas las ubicaciones impactadas, aumenta en +3, hasta un total de +7, y obtenés Inmunidad a la Radiación que no provenga de ataques. Cuando infligís daño de Radiación, agregás +1 Dado de Combate al daño por rango. Además, esto desbloquea varias modificaciones.\n\nCada vez que adquirís esta Ventaja, el requisito de Nivel aumenta en 4." },

            { id: "perk194", img: "112", name: "División", rank: 1, ranks: 2, reqs: { Nivel: 10 }, reqText: "Rasgo El Resplandor de Atom, Físico Nuclear, Nivel 10+", desc: "Fuiste bendecido con la capacidad de manipular la radiación para propagar la gracia de Atom. Una vez por escena, podés crear un doble corporal hecho de radiación residual pura durante 3 turnos. Tiene 1/3 de tus Puntos de Salud máximos, puede moverse una Zona con su Acción Menor y puede realizar un ataque Desarmado que inflige 3 Dados de Combate de daño de Radiación o explotar con su Acción Mayor, y sigue las reglas de compañeros. Cuando muere, se terminan los turnos o se le ordena hacerlo, explotará e infligirá 8 Dados de Combate de daño de Radiación con el efecto Radiactivo y la cualidad Explosión.\n\nCada vez que adquirís esta Ventaja, el requisito de Nivel aumenta en 5." },
            { id: "perk195", img: "112", name: "División", rank: 2, ranks: 2, reqs: { Nivel: 15 }, reqText: "Rasgo El Resplandor de Atom, Físico Nuclear, Nivel 15+", desc: "Fuiste bendecido con la capacidad de manipular la radiación para propagar la gracia de Atom. Una vez por escena, podés crear un doble corporal hecho de radiación residual pura durante 5 turnos. Tiene 1/3 de tus Puntos de Salud máximos, puede moverse una Zona con su Acción Menor y puede realizar un ataque Desarmado que inflige 4 Dados de Combate de daño de Radiación o explotar con su Acción Mayor, y sigue las reglas de compañeros. Cuando muere, se terminan los turnos o se le ordena hacerlo, explotará e infligirá 9 Dados de Combate de daño de Radiación con el efecto Radiactivo y la cualidad Explosión.\n\nCada vez que adquirís esta Ventaja, el requisito de Nivel aumenta en 5." },

            { id: "perk196", img: "113", name: "Aliado Autotrónico", rank: 1, ranks: 1, reqs: { INT: 5 }, reqText: "Rasgo El Resplandor de Atom, Secta West-Tek, INT 5", desc: "ZAX te permitió tener un Eyebot personalizado para ayudarte en tus misiones. El Eyebot tiene un perfil que aparece al final de este documento y es tratado como un PNJ robot aliado bajo tu mando (CRB pág. 338). Si tu Eyebot es destruido, entonces encontrás un nuevo Eyebot antes de la siguiente aventura o podés cambiar esta Ventaja por una diferente después de esta aventura." },

            { id: "perk197", img: "114", name: "Visionario", rank: 1, ranks: 1, reqs: { PER: 7, Nivel: 3 }, reqText: "Rasgo El Resplandor de Atom, enseñanza \"Su Resplandor, Mi Iluminación\", PER 7, Nivel 3+", desc: "Tus visiones son más fuertes que las de la mayoría y te permiten ver lo que no puede verse.\n\nMientras estés en un área irradiada, podés escudriñar el área cercana, descubriendo la ubicación de toda criatura irradiada dentro de Alcance Extremo mediante una prueba exitosa de PER+Supervivencia con una dificultad de 1." },

            { id: "perk198", img: "115", name: "", rank: 1, ranks: 1, reqs: {}, reqText: "Rasgo El Resplandor de Atom, debés ser nombrado Inquisidor", desc: "Fuiste nombrado Inquisidor por la Madre/Confesora de tu secta y recibiste la tarea de encontrar y eliminar a los disidentes y traidores de Atom. Por ello, recibiste entrenamiento en métodos de investigación e interrogación. Reducís en 1 la dificultad de todas las pruebas relacionadas con interrogación o investigación (mínimo 0)." },

            { id: "perk199", img: "116", name: "Garra del Miedo", rank: 1, ranks: 3, reqs: { STR: 7, END: 7, Nivel: 1 }, reqText: "FUE 7, RES 7, Nivel 1+, Deathclaw", desc: "Un veneno ruinoso y cáustico se filtró en tus garras. Cada rango de esta Ventaja otorga a tus ataques Desarmado +1d de daño de Veneno.\n\nCada vez que adquirís esta Ventaja, su requisito de Nivel aumenta en 5." },
            { id: "perk200", img: "116", name: "Garra del Miedo", rank: 2, ranks: 3, reqs: { STR: 7, END: 7, Nivel: 6 }, reqText: "FUE 7, RES 7, Nivel 6+, Deathclaw", desc: "Un veneno ruinoso y cáustico se filtró en tus garras. Cada rango de esta Ventaja otorga a tus ataques Desarmado +1d de daño de Veneno.\n\nCada vez que adquirís esta Ventaja, su requisito de Nivel aumenta en 5." },
            { id: "perk201", img: "116", name: "Garra del Miedo", rank: 3, ranks: 3, reqs: { STR: 7, END: 7, Nivel: 11 }, reqText: "FUE 7, RES 7, Nivel 11+, Deathclaw", desc: "Un veneno ruinoso y cáustico se filtró en tus garras. Cada rango de esta Ventaja otorga a tus ataques Desarmado +1d de daño de Veneno.\n\nCada vez que adquirís esta Ventaja, su requisito de Nivel aumenta en 5." },

            { id: "perk202", img: "117", name: "Eviscerador", rank: 1, ranks: 2, reqs: { STR: 7, AGI: 6, Nivel: 1 }, reqText: "FUE 7, AGI 6, Nivel 1+, Deathclaw", desc: "Tus ataques Desarmado obtienen la cualidad Vicioso.\n\nCada vez que adquirís esta Ventaja, su requisito de Nivel aumenta en 4." },
            { id: "perk203", img: "117", name: "Eviscerador", rank: 2, ranks: 2, reqs: { STR: 7, AGI: 6, Nivel: 5 }, reqText: "FUE 7, AGI 6, Nivel 5+, Deathclaw", desc: "Cuando infligís daño con un ataque Desarmado, podés gastar 2 AP para desarmar al enemigo, haciendo que deje caer su arma.\n\nCada vez que adquirís esta Ventaja, su requisito de Nivel aumenta en 4." },

            { id: "perk204", img: "118", name: "Piel de Cicatrices", rank: 1, ranks: 3, reqs: { END: 8, Nivel: 3 }, reqText: "RES 8, Nivel 3+, Deathclaw", desc: "Tu carne curtida por las batallas se endureció. Cada rango de esta Ventaja otorga +1 de Resistencia al Daño contra daño Físico, de Energía, Veneno y Radiación. Esto no protege contra el daño causado por fuego.\n\nCada vez que adquirís esta Ventaja, el requisito de Nivel aumenta en 3." },
            { id: "perk205", img: "118", name: "Piel de Cicatrices", rank: 2, ranks: 3, reqs: { END: 8, Nivel: 6 }, reqText: "RES 8, Nivel 6+, Deathclaw", desc: "Tu carne curtida por las batallas se endureció. Cada rango de esta Ventaja otorga +1 de Resistencia al Daño contra daño Físico, de Energía, Veneno y Radiación. Esto no protege contra el daño causado por fuego.\n\nCada vez que adquirís esta Ventaja, el requisito de Nivel aumenta en 3." },
            { id: "perk206", img: "118", name: "Piel de Cicatrices", rank: 3, ranks: 3, reqs: { END: 8, Nivel: 9 }, reqText: "RES 8, Nivel 9+, Deathclaw", desc: "Tu carne curtida por las batallas se endureció. Cada rango de esta Ventaja otorga +1 de Resistencia al Daño contra daño Físico, de Energía, Veneno y Radiación. Esto no protege contra el daño causado por fuego.\n\nCada vez que adquirís esta Ventaja, el requisito de Nivel aumenta en 3." },

            { id: "perk207", img: "119", name: "Sentido de la Muerte", rank: 1, ranks: 1, reqs: { PER: 7 }, reqText: "PER 7, Deathclaw", desc: "Tus sentidos finamente desarrollados te permiten detectar vibraciones increíblemente sutiles en el suelo, el aire e incluso los latidos del corazón. Podés detectar cosas que otros personajes no pueden y reducís en 1, hasta un mínimo de 0, la dificultad de todas las pruebas de PER si involucran tus sentidos del oído, tacto o magnetismo. Esto incluso se aplica a las pruebas para detectar mentiras; al igual que un perro, podés captar señales de engaño incluso cuando no sabés qué está diciendo una persona." },

            { id: "perk208", img: "120", name: "Frenesí", rank: 1, ranks: 3, reqs: { STR: 7, AGI: 7, Nivel: 1 }, reqText: "FUE 7, AGI 7, Deathclaw, Nivel 1+, no tiene Domesticado", desc: "Cuando tu sangre empieza a fluir, te convertís en una máquina de matar medio enloquecida y te asegurás de que siga fluyendo mucha más sangre.\n\nMientras tu Salud esté por debajo de su máximo, podés elegir entrar en frenesí durante tu turno. Mientras estés en frenesí, ignorás por completo el efecto de las Lesiones en una extremidad por rango de esta Ventaja y debés atacar a alguien, si es posible, en cada uno de tus turnos. No podés utilizar tus acciones de una manera que impida realizar un ataque, incluso si tu único objetivo posible es un aliado; no podés moverte primero a una Zona vacía y después decir \"uh, parece que estoy fuera de alcance\".\n\nTu frenesí termina cuando termina la escena, cuando superás una prueba de RES + Supervivencia con dificultad 1 para calmarte, o cuando otra persona supera una prueba de INT o CAR + Hablar o Supervivencia con dificultad 1 para calmarte. Una vez que termina tu frenesí, no podés volver a entrar en frenesí durante la misma escena.\n\nCada vez que adquirís esta Ventaja, el requisito de Nivel aumenta en 4." },
            { id: "perk209", img: "120", name: "Frenesí", rank: 2, ranks: 3, reqs: { STR: 7, AGI: 7, Nivel: 5 }, reqText: "FUE 7, AGI 7, Deathclaw, Nivel 5+, no tiene Domesticado", desc: "Cuando tu sangre empieza a fluir, te convertís en una máquina de matar medio enloquecida y te asegurás de que siga fluyendo mucha más sangre.\n\nMientras tu Salud esté por debajo de su máximo, podés elegir entrar en frenesí durante tu turno. Mientras estés en frenesí, ignorás por completo el efecto de las Lesiones en dos extremidades por rango de esta Ventaja y debés atacar a alguien, si es posible, en cada uno de tus turnos. No podés utilizar tus acciones de una manera que impida realizar un ataque, incluso si tu único objetivo posible es un aliado; no podés moverte primero a una Zona vacía y después decir \"uh, parece que estoy fuera de alcance\".\n\nTu frenesí termina cuando termina la escena, cuando superás una prueba de RES + Supervivencia con dificultad 1 para calmarte, o cuando otra persona supera una prueba de INT o CAR + Hablar o Supervivencia con dificultad 1 para calmarte. Una vez que termina tu frenesí, no podés volver a entrar en frenesí durante la misma escena.\n\nCada vez que adquirís esta Ventaja, el requisito de Nivel aumenta en 4." },
            { id: "perk210", img: "120", name: "Frenesí", rank: 3, ranks: 3, reqs: { STR: 7, AGI: 7, Nivel: 9 }, reqText: "FUE 7, AGI 7, Deathclaw, Nivel 9+, no tiene Domesticado", desc: "Cuando tu sangre empieza a fluir, te convertís en una máquina de matar medio enloquecida y te asegurás de que siga fluyendo mucha más sangre.\n\nMientras tu Salud esté por debajo de su máximo, podés elegir entrar en frenesí durante tu turno. Mientras estés en frenesí, ignorás por completo el efecto de las Lesiones en tres extremidades por rango de esta Ventaja y debés atacar a alguien, si es posible, en cada uno de tus turnos. No podés utilizar tus acciones de una manera que impida realizar un ataque, incluso si tu único objetivo posible es un aliado; no podés moverte primero a una Zona vacía y después decir \"uh, parece que estoy fuera de alcance\".\n\nTu frenesí termina cuando termina la escena, cuando superás una prueba de RES + Supervivencia con dificultad 1 para calmarte, o cuando otra persona supera una prueba de INT o CAR + Hablar o Supervivencia con dificultad 1 para calmarte. Una vez que termina tu frenesí, no podés volver a entrar en frenesí durante la misma escena.\n\nCada vez que adquirís esta Ventaja, el requisito de Nivel aumenta en 4." },

            { id: "perk211", img: "121", name: "Domesticado", rank: 1, ranks: 1, reqs: { CHA: 6 }, reqText: "CAR 6, Deathclaw, no tiene Frenesí", desc: "Estás muy familiarizado con cómo comportarte cerca de humanos, cómo parecer menos una brutal máquina de matar y más un grandote peludo con manos enormes para dar abrazos enormes.\n\nObtenés una habilidad etiquetada (Tag) gratuita en Hablar o Trueque. Si ambas ya están etiquetadas, obtenés una habilidad etiquetada gratuita en cualquier habilidad que quieras. Mientras no hayas realizado ninguna acción amenazante durante la escena actual y tengas algún tipo de señal de seguridad (generalmente un chaleco reflectante), no sos considerado una amenaza incluso si nadie te está controlando de manera evidente. La mayoría de los demás seguirán estando en guardia, pero podés hacer tus propios asuntos con la gente y no te van a disparar en la cara." },

            { id: "perk212", img: "122", name: "Domador de Deathclaws", rank: 1, ranks: 2, reqs: { Nivel: 1 }, reqText: "CAR 7, Nivel 1+, no es Deathclaw", desc: "Tenés amplios conocimientos sobre cómo tratar con Deathclaws, entrenarlos y darles órdenes, ya sea gracias a un entrenamiento formal, como el del Cuerpo de Navegación de la Hermandad, o, digamos, a una experiencia más \"inmediata\".\n\nEn Rango 1, cualquier Deathclaw con el que viajes se considera obviamente controlado, sin importar lo que haga, siempre que no ataque abiertamente a nadie. Si además está Domesticado, ni siquiera necesita equipamiento de seguridad ni permanecer cerca tuyo; la gente no estará constantemente en guardia y puede vagar haciendo lo que quiera como si fuera un enorme perro cariñoso. Vos y cualquier Deathclaw amistoso dentro de alcance sensorial pueden gastar los Puntos de Suerte del otro (con permiso del otro, por supuesto). Fuera de combate, vos y un Deathclaw amistoso pueden realizar pruebas de habilidad utilizando tu Habilidad y el Atributo del Deathclaw, o tu INT y la Habilidad del Deathclaw. Guiar al Deathclaw durante esto hace que la acción tarde el doble.\n\nCada vez que adquirís esta Ventaja, el Nivel requerido aumenta en 7." },
            { id: "perk213", img: "122", name: "Domador de Deathclaws", rank: 2, ranks: 2, reqs: { Nivel: 8 }, reqText: "CAR 7, Nivel 8+, no es Deathclaw", desc: "Tenés amplios conocimientos sobre cómo tratar con Deathclaws, entrenarlos y darles órdenes, ya sea gracias a un entrenamiento formal, como el del Cuerpo de Navegación de la Hermandad, o, digamos, a una experiencia más \"inmediata\".\n\nEn Rango 1, cualquier Deathclaw con el que viajes se considera obviamente controlado, sin importar lo que haga, siempre que no ataque abiertamente a nadie. Si además está Domesticado, ni siquiera necesita equipamiento de seguridad ni permanecer cerca tuyo; la gente no estará constantemente en guardia y puede vagar haciendo lo que quiera como si fuera un enorme perro cariñoso. Vos y cualquier Deathclaw amistoso dentro de alcance sensorial pueden gastar los Puntos de Suerte del otro (con permiso del otro, por supuesto). Fuera de combate, vos y un Deathclaw amistoso pueden realizar pruebas de habilidad utilizando tu Habilidad y el Atributo del Deathclaw, o tu INT y la Habilidad del Deathclaw. Guiar al Deathclaw durante esto hace que la acción tarde el doble.\n\nEn Rango 2, podés intentar pacificar Deathclaws hostiles (o, a discreción del GM, otras máquinas de matar impías como los osos). Podés acercarte a un Deathclaw al que no hayas atacado e intentar una prueba de CAR + Supervivencia con dificultad 3 que requiere un minuto de caminar lentamente hacia él, emitir sonidos tranquilizadores y llamarlo \"grandote\". Si tenés éxito, la criatura no intentará hacerte daño a vos ni a tu grupo a menos que la amenaces directamente. Si tenés Rango 2 de la Ventaja Amigo de los Animales, reducís en 1 la dificultad de esta prueba. Si podés darle al Deathclaw algo que quiera, como uno de sus huevos, tratamiento para una lesión obviamente dolorosa o, si nada de eso funciona, un buen trozo grande de carne cruda, reducís en 1 la dificultad de esta prueba.\n\nCada vez que adquirís esta Ventaja, el Nivel requerido aumenta en 7." },

            { id: "perk214", img: "123", name: "Mutable", rank: 1, ranks: 10, reqs: { Nivel: 1 }, reqText: "Nivel 1+", desc: "Tu cuerpo experimenta una transformación rápida e intensa. Si sos humano, esto te convertirá en Numen, reemplazando tu rasgo actual por Casi Super(Mutante), y podés volver a adquirir esta Ventaja inmediatamente. Si sos Numen, esto te otorga una mutación adicional de la tabla de mutaciones.\n\nEn cada rango, podés adquirir otra mutación. Cada vez que adquirís esta Ventaja, el requisito de Nivel aumenta en 6." },
