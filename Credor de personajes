        // Funcion que asegura que los perks seleccionables tengan los requerimientos
        function checkPerkRequirements(perk) {
            const attrs = {
                FUE: parseInt(document.getElementById('att-fue').value) || 0,
                PER: parseInt(document.getElementById('att-per').value) || 0,
                END: parseInt(document.getElementById('att-end').value) || 0,
                CAR: parseInt(document.getElementById('att-car').value) || 0,
                INT: parseInt(document.getElementById('att-int').value) || 0,
                AGI: parseInt(document.getElementById('att-agi').value) || 0,
                SUE: parseInt(document.getElementById('att-sue').value) || 0
            };

            for (let reqKey in perk.reqs) {
                const reqVal = perk.reqs[reqKey];
                if (reqKey in attrs) {
                    if (attrs[reqKey] < reqVal) return false;
                } else {
                    const baseRank = skillRanks[reqKey] || 0;
                    const isTag = tagSelection[reqKey] ? 2 : 0;
                    const totalRank = baseRank + isTag;
                    if (totalRank < reqVal) return false;
                }
            }
            return true;
        }

        // Funcion que arma las tarjetas de perks
       function renderPerksCardSystem(containerId, selectedStateVar, callbackSelect) {
        const container = document.getElementById(containerId);
        if (!container) return;
        container.innerHTML = '';

        // 1. Agrupar los perks por nombre para manejar sus rangos
        const perksMap = {};
        perksDetailedList.forEach((perk) => {
            if (!perksMap[perk.name]) {
                perksMap[perk.name] = [];
            }
            perksMap[perk.name].push(perk);
        });

        // 2. Filtrar únicamente los perks y rangos que CUMPLEN los requisitos
        const filteredPerksToRender = [];
        
        Object.values(perksMap).forEach((perkRanksArray) => {
            // Ordenar de mayor a menor rango (ej: Rango 3, luego 2, luego 1)
            perkRanksArray.sort((a, b) => b.rank - a.rank);

            // Encontrar el rango más alto que CUMPLE con los requisitos
            const highestMetPerk = perkRanksArray.find(perk => checkPerkRequirements(perk));

            if (highestMetPerk) {
                // Si cumple al menos un rango, agregamos SOLAMENTE ese rango máximo alcanzado
                filteredPerksToRender.push(highestMetPerk);
            }
            // Si ningun rango cumple (ej: pide nivel 4 o stats que no tiene), 
            // NO se agrega nada a `filteredPerksToRender`, por lo que se OCALTA por completo.
        });

        // 3. Renderizar únicamente las tarjetas válidas y accesibles
        filteredPerksToRender.forEach((perk) => {
            const isSelected = (selectedStateVar === perk.id);
            
            const card = document.createElement('div');
            card.className = `perk-card-f76 ${isSelected ? 'selected' : ''}`; // Ya no estarán locked porque solo pasan los cumplidos

            card.onclick = () => callbackSelect(perk.id, card);

            // Lógica precisa de estrellas basadas en el rango alcanzado
            const totalRanks = perk.ranks || 1;
            const currentRank = perk.rank || 1;
            let starsHTML = '';
            
            for (let i = 1; i <= totalRanks; i++) {
                starsHTML += (i <= currentRank) ? '★' : '☆';
            }

            card.innerHTML = `
                <div class="perk-header-f76">
                    <h3>${perk.name}</h3>
                </div>
                <div class="perk-image-container-f76">
                    <div class="perk-placeholder-art">[ IMG ID: ${perk.img} ]</div>
                </div>
                <div class="perk-reqs-f76">
                    <span>Prerequisitos: </span>
                    <strong class="req-met">${perk.reqText} ✔</strong>
                </div>
                <div class="perk-desc-f76">
                    <p>${perk.desc}</p>
                </div>
                <div class="perk-stars-f76">
                    <span>${starsHTML}</span>
                </div>
            `;
            container.appendChild(card);
        });
}

