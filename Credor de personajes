        // Funcion que calcula los stats derivados
        function initDerivedStatsStep() {
            const fue = parseInt(document.getElementById('att-fue').value) || 5;
            const per = parseInt(document.getElementById('att-per').value) || 5;
            const end = parseInt(document.getElementById('att-end').value) || 5;
            const agi = parseInt(document.getElementById('att-agi').value) || 5;
            const sue = parseInt(document.getElementById('att-sue').value) || 5;

            let hpMax = end + fue;
            const iniciativa = per + agi;
            const defensa = (agi >= 9) ? 2 : 1;
            
            // Evaluar Suerte si tiene el trait Gifted
            const gifted = Array.from(document.querySelectorAll('.survivor-trait-check:checked')).some(c => c.value === 'gifted');
            let maxLuck = (selectedOrigin === 'Superviviente' && gifted) ? Math.max(0, sue - 1) : sue;

            // Evaluar Carga con Small Frame
            const smallFrame = Array.from(document.querySelectorAll('.survivor-trait-check:checked')).some(c => c.value === 'small_frame');
            let cargaMaxText = `${150 + (fue * (smallFrame ? 5 : 10))} lbs`;
            if (selectedOrigin === 'Mister_Handy') {
                cargaMaxText = "150 lbs (Fijo por Propulsión a jet)";
            }

            // Cálculo de Daño Cuerpo a Cuerpo (incluyendo Heavy Handed)
            let baseMeleeVal = 0;
            if (fue >= 9) baseMeleeVal = 2;
            else if (fue >= 7) baseMeleeVal = 1;
            else if (fue <= 3) baseMeleeVal = -1;

            const heavyHandedActive = Array.from(document.querySelectorAll('.survivor-trait-check:checked')).some(c => c.value === 'heavy_handed');
            if (heavyHandedActive) {
                baseMeleeVal += 1;
            }
            let meleeBonus = baseMeleeVal >= 0 ? `+${baseMeleeVal}` : `${baseMeleeVal}`;

            // Renderizado de Estadísticas Derivadas en el Paso 5
            const list = document.getElementById('derived-stats-list');
            list.innerHTML = `
                <li><strong>Puntos de Vida Máximos (HP):</strong> ${hpMax} (Resistencia + Fuerza)</li>
                <li><strong>Iniciativa Base:</strong> ${iniciativa} (Percepción + Agilidad)</li>
                <li><strong>Defensa Base:</strong> ${defensa}</li>
                <li><strong>Reserva Inicial de Suerte:</strong> ${maxLuck} Puntos ${gifted ? '(Reducido en 1 por Gifted)' : ''}</li>
                <li><strong>Capacidad de Carga Máxima:</strong> ${cargaMaxText}</li>
                <li><strong>Bono al daño cuerpo a cuerpo:</strong> ${meleeBonus}</li>
            `;

            // Renderizado de Paquetes de Equipo
            const eqContainer = document.getElementById('equipment-cards-container');
            if (eqContainer && typeof equipmentPackages !== 'undefined') {
                eqContainer.innerHTML = '';
                if (!selectedEquipment && equipmentPackages.length > 0) selectedEquipment = equipmentPackages[0].name;

                equipmentPackages.forEach(eq => {
                    const card = document.createElement('div');
                    card.className = `selectable-card ${selectedEquipment === eq.name ? 'selected' : ''}`;
                    card.onclick = () => {
                        selectedEquipment = eq.name;
                        document.querySelectorAll('#equipment-cards-container .selectable-card').forEach(c => c.classList.remove('selected'));
                        card.classList.add('selected');
                    };
                    card.innerHTML = `
                        <h3>${eq.name}</h3>
                        <p>${eq.desc}</p>
                    `;
                    eqContainer.appendChild(card);
                });
            }

            // Renderizado de Trinkets (Primero la lista pregenerada limpia, y al final el personalizado)
            const trContainer = document.getElementById('trinkets-cards-container');
            if (trContainer) {
                trContainer.innerHTML = '';
                if (!selectedTrinket && trinketsList.length > 0) selectedTrinket = trinketsList[0];

                // 1. Elementos de la lista pregenerada (sin números ni etiquetas)
                trinketsList.forEach(t => {
                    const cleanName = t.replace(/^[0-9]+\.\s*/, '').replace(/^(Trinket \d+[:\s]*|Objeto Personal[:\s]*)/i, '').trim();

                    const card = document.createElement('div');
                    card.className = `selectable-card ${selectedTrinket === t ? 'selected' : ''}`;
                    card.onclick = () => {
                        selectedTrinket = t;
                        document.querySelectorAll('#trinkets-cards-container .selectable-card').forEach(c => c.classList.remove('selected'));
                        card.classList.add('selected');
                    };
                    card.innerHTML = `
                        <p>${cleanName}</p>
                    `;
                    trContainer.appendChild(card);
                });

                // 2. Al final, la tarjeta para escribir el Trinket personalizado
                const customCard = document.createElement('div');
                customCard.className = `selectable-card ${selectedTrinket && selectedTrinket.startsWith('CUSTOM:') ? 'selected' : ''}`;
                customCard.innerHTML = `
                    <h3>Personalizado</h3>
                    <input type="text" id="custom-trinket-input" placeholder="[ Escribe tu Trinket ]" value="${selectedTrinket && selectedTrinket.startsWith('CUSTOM:') ? selectedTrinket.replace('CUSTOM:', '') : ''}" oninput="updateCustomTrinket(this)">
                `;
