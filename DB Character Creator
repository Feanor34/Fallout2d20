    { id: "perk048", img: "033", source:"coreBook" , name: "Buscador de Fortuna", rank: 1, ranks: 3, reqs: { LCK: 5, Nivel: 2 }, reqText: "LCK 5, Nivel 2+", desc: "Siempre que tirás para determinar cuánto dinero encontrás, encontrás +3 DCD de chapas adicionales." },
    { id: "perk049", img: "033", source:"coreBook" , name: "Buscador de Fortuna", rank: 2, ranks: 3, reqs: { LCK: 5, Nivel: 6 }, reqText: "LCK 5, Nivel 6+", desc: "Siempre que tirás para determinar cuánto dinero encontrás, encontrás +6 DCD de chapas adicionales." },
    { id: "perk050", img: "033", source:"coreBook" , name: "Buscador de Fortuna", rank: 3, ranks: 3, reqs: { LCK: 5, Nivel: 10 }, reqText: "LCK 5, Nivel 10+", desc: "Siempre que tirás para determinar cuánto dinero encontrás, encontrás +10 CD de chapas adicionales." },

    { id: "perk051", img: "034", source:"coreBook" , name: "Fantasma", rank: 1, ranks: 1, reqs: { PER: 5, AGI: 6 }, reqText: "PER 5, AGI 6", desc: "Siempre que intentás una prueba de AGI + Sigilo en sombras u oscuridad, el primer d20 adicional que comprás es gratis. El máximo normal de 5d20 sigue aplicándose." },

    { id: "perk052", img: "035", source:"coreBook" , name: "Carrera del Segador", rank: 1, ranks: 1, reqs: { LCK: 8 }, reqText: "LCK 8", desc: "Cuando realizás un ataque que mata a uno o más enemigos, tirá 1 DCD. Si obtenés un Efecto, agregá 2 PA a la reserva del grupo." },

    { id: "perk053", img: "036", source:"coreBook" , name: "Gun Fu", rank: 1, ranks: 3, reqs: { AGI: 10, Nivel: 1 }, reqText: "AGI 10, Nivel 1+", desc: "Cuando tenés éxito en un ataque a distancia, podés gastar 1 PA y 1 munición para impactar a un segundo objetivo a alcance Corto de tu objetivo inicial. El segundo objetivo recibe el mismo daño que el objetivo inicial." },
    { id: "perk054", img: "036", source:"coreBook" , name: "Gun Fu", rank: 2, ranks: 3, reqs: { AGI: 10, Nivel: 6 }, reqText: "AGI 10, Nivel 6+", desc: "Cuando tenés éxito en un ataque a distancia, podés gastar 2 PA y 2 municiones para impactar a dos objetivos adicionales a alcance Corto de tu objetivo inicial. Cada objetivo recibe el mismo daño que el objetivo inicial." },
    { id: "perk055", img: "036", source:"coreBook" , name: "Gun Fu", rank: 3, ranks: 3, reqs: { AGI: 10, Nivel: 11 }, reqText: "AGI 10, Nivel 11+", desc: "Cuando tenés éxito en un ataque a distancia, podés gastar 3 PA y 3 municiones para impactar a tres objetivos adicionales a alcance Corto de tu objetivo inicial. Cada objetivo recibe el mismo daño que el objetivo inicial." },

    { id: "perk056", img: "037", source:"coreBook" , name: "Loco de las Armas", rank: 1, ranks: 4, reqs: { INT: 6, Nivel: 2 }, reqText: "INT 6, Nivel 2+", desc: "Podés modificar armas pequeñas y armas pesadas con mods de armas. Este rango desbloquea mods de rango 1." },
    { id: "perk057", img: "037", source:"coreBook" , name: "Loco de las Armas", rank: 2, ranks: 4, reqs: { INT: 6, Nivel: 6 }, reqText: "INT 6, Nivel 6+", desc: "Podés modificar armas pequeñas y armas pesadas con mods de armas. Este rango desbloquea mods de rango 2." },
    { id: "perk058", img: "037", source:"coreBook" , name: "Loco de las Armas", rank: 3, ranks: 4, reqs: { INT: 6, Nivel: 10 }, reqText: "INT 6, Nivel 10+", desc: "Podés modificar armas pequeñas y armas pesadas con mods de armas. Este rango desbloquea mods de rango 3." },
    { id: "perk059", img: "037", source:"coreBook" , name: "Loco de las Armas", rank: 4, ranks: 4, reqs: { INT: 6, Nivel: 14 }, reqText: "INT 6, Nivel 14+", desc: "Podés modificar armas pequeñas y armas pesadas con mods de armas. Este rango desbloquea mods de rango 4." },

    { id: "perk060", img: "038", source:"coreBook" , name: "Pistolero", rank: 1, ranks: 2, reqs: { AGI: 7, Nivel: 2 }, reqText: "AGI 7, Nivel 2+", desc: "Cuando realizás un ataque con un arma a distancia de una mano con una Cadencia de Fuego de 2 o menos, aumentás el daño del arma en +1 CD. Además, podés volver a tirar el dado de ubicación del impacto." },
    { id: "perk061", img: "038", source:"coreBook" , name: "Pistolero", rank: 2, ranks: 2, reqs: { AGI: 7, Nivel: 6 }, reqText: "AGI 7, Nivel 6+", desc: "Cuando realizás un ataque con un arma a distancia de una mano con una Cadencia de Fuego de 2 o menos, aumentás el daño del arma en +2 CD. Además, podés volver a tirar el dado de ubicación del impacto." },

    { id: "perk062", img: "039", source:"coreBook" , name: "Hacker", rank: 1, ranks: 1, reqs: { INT: 8 }, reqText: "INT 8", desc: "La dificultad de las pruebas de habilidad para hackear computadoras se reduce en 1, hasta un mínimo de 0." },

    { id: "perk063", img: "040", source:"coreBook" , name: "Sanador", rank: 1, ranks: 3, reqs: { INT: 7, Nivel: 1 }, reqText: "INT 7, Nivel 1+", desc: "Cuando curás los PG de un paciente utilizando la acción Primeros auxilios, aumentá la cantidad de PG curados en +1." },
    { id: "perk064", img: "040", source:"coreBook" , name: "Sanador", rank: 2, ranks: 3, reqs: { INT: 7, Nivel: 6 }, reqText: "INT 7, Nivel 6+", desc: "Cuando curás los PG de un paciente utilizando la acción Primeros auxilios, aumentá la cantidad de PG curados en +2." },
    { id: "perk065", img: "040", source:"coreBook" , name: "Sanador", rank: 3, ranks: 3, reqs: { INT: 7, Nivel: 11 }, reqText: "INT 7, Nivel 11+", desc: "Cuando curás los PG de un paciente utilizando la acción Primeros auxilios, aumentá la cantidad de PG curados en +3." },

    { id: "perk066", img: "041", source:"coreBook" , name: "¡Arriba!", rank: 1, ranks: 1, reqs: { FUE: 8 }, reqText: "FUE 8", desc: "Cuando realizás un ataque con un arma arrojadiza, podés gastar 1 PA para aumentar el Alcance del arma en un paso: de Corto a Medio, o de Medio a Largo." },

    { id: "perk067", img: "042", source:"coreBook" , name: "Cazador", rank: 1, ranks: 1, reqs: { END: 6 }, reqText: "END 6", desc: "Cuando realizás un ataque contra un PNJ con una de las palabras clave Mamífero, Lagarto o Insecto y la palabra clave Mutado, tu ataque obtiene el efecto de daño Vicioso, si todavía no tenía ese efecto." },

    { id: "perk068", img: "043", source:"coreBook" , name: "Infiltrador", rank: 1, ranks: 1, reqs: { PER: 8 }, reqText: "PER 8", desc: "Cuando intentás una prueba de habilidad de Cerrajería para abrir una puerta o un contenedor, podés volver a tirar 1d20." },

    { id: "perk069", img: "044", source:"coreBook" , name: "Inspirador", rank: 1, ranks: 1, reqs: { CAR: 8 }, reqText: "CAR 8", desc: "Como liderás con el ejemplo, la cantidad máxima de PA que el grupo puede guardar aumenta en 1." },

