        { id: "perk224", img: "124", source:"homebrew" , name: "Fotosíntesis", rank: 1, ranks: 2, perkRequired: ["numen"], perkExclusive: [], reqs: { Nivel: 5 }, reqText: "Rasgo Casi Super(Mutante), mutación Pulgar Verde (o cabeza...), Nivel 5+", desc: "Tu planta empezó a crecer y su producción crece con ella. Cuando tirás por el alimento de tu planta, obtenés dos objetos de comida en lugar de uno. Además, la Salud obtenida de los objetos de comida que producís aumenta en 1 punto.\n\nCada vez que adquirís este Perk, el requisito de Nivel aumenta en 5." },
        { id: "perk225", img: "124", source:"homebrew" , name: "Fotosíntesis", rank: 2, ranks: 2, perkRequired: ["numen"], perkExclusive: [], reqs: { Nivel: 10 }, reqText: "Rasgo Casi Super(Mutante), mutación Pulgar Verde (o cabeza...), Nivel 10+", desc: "Tu planta creció aún más y se volvió más avanzada (¿Deberías preocuparte?). Podés elegir tirar en la tabla de recolección de Bebidas en su lugar, apareciendo en forma de vainas llenas de líquido. Además, los efectos obtenidos de la comida o bebida que producís aumentan en 1. Cada vez que adquirís este Perk, el requisito de Nivel aumenta en 5." },

        { id: "perk226", img: "125", source:"homebrew" , name: "...Ahora Desearías No Haberlo Hecho", rank: 1, ranks: 2, perkRequired: ["numen"], perkExclusive: [], reqs: { Nivel: 10 }, reqText: "Rasgo Casi Super(Mutante), mutación Ahora me ves..., Nivel 10+", desc: "Con gran esfuerzo, sos capaz de atravesar la pacificación. Con una prueba de RES + Supervivencia con dificultad 2, podés realizar un ataque furtivo con cualquier arma cuerpo a cuerpo o arma con silenciador, agregando +2 Dados de Combate a su daño. Esto no se acumula con armas que ya tienen daño aumentado por ataques furtivos.\n\nCada vez que adquirís este Perk, el requisito de Nivel aumenta en 5." },
        { id: "perk227", img: "125", source:"homebrew" , name: "...Ahora Desearías No Haberlo Hecho", rank: 2, ranks: 2, perkRequired: ["numen"], perkExclusive: [], reqs: { Nivel: 15 }, reqText: "Rasgo Casi Super(Mutante), mutación Ahora me ves..., Nivel 15+", desc: "Con gran esfuerzo, sos capaz de atravesar la pacificación. Con una prueba de RES + Supervivencia con dificultad 1, podés realizar un ataque furtivo con cualquier arma cuerpo a cuerpo o arma con silenciador, agregando +2 Dados de Combate a su daño. Esto no se acumula con armas que ya tienen daño aumentado por ataques furtivos. Cada vez que adquirís este Perk, el requisito de Nivel aumenta en 5." },

        { id: "perk228", img: "126", source:"homebrew" , name: "Cinta Natural", rank: 1, ranks: 1, perkRequired: ["numen"], perkExclusive: [], reqs: { Nivel: 5 }, reqText: "Rasgo Casi Super(Mutante), mutación Pegajoso, Nivel 5", desc: "Tu sudor parecido al pegamento es fácilmente moldeable, lo que te permite aplicarlo a objetos, reduciendo la dificultad de todas las pruebas de Reparación que involucren pegamento o adhesivo y eliminando el requisito de pegamento o adhesivo en cualquier cosa que pueda necesitarlo." },

        { id: "perk229", img: "127", source:"homebrew" , name: "Volar como un Sanguinario", rank: 1, ranks: 3, perkRequired: ["numen"], perkExclusive: [], reqs: { Nivel: 3 }, reqText: "mutación Creo que puedo volar, Nivel 3+", desc: "Te brota un par adicional de alas, dándote suficiente potencia para volar hasta una Zona vertical por encima del suelo y moverte en tu plano horizontal actual. Requiere una Acción Menor para permanecer en el aire y, si sufrís Derribo o tu Torso resulta lesionado, caés al suelo, sufriendo 3 Dados de Combate de daño Físico Aturdidor, +2 Dados de Combate por cada Zona por encima del nivel del suelo en la que estabas antes de caer.\n\nCada rango adicional hace brotar otro par de alas y aumenta en 1 el máximo de Zonas verticales que podés recorrer (máximo 3 Zonas). Cada vez que adquirís este Perk, el requisito de Nivel aumenta en 3." },
        { id: "perk230", img: "127", source:"homebrew" , name: "Volar como un Sanguinario", rank: 2, ranks: 3, perkRequired: ["numen"], perkExclusive: [], reqs: { Nivel: 6 }, reqText: "mutación Creo que puedo volar, Nivel 6+", desc: "Te brota un par adicional de alas, dándote suficiente potencia para volar hasta 2 Zonas verticales por encima del suelo y moverte en tu plano horizontal actual. Requiere una Acción Menor para permanecer en el aire y, si sufrís Derribo o tu Torso resulta lesionado, caés al suelo, sufriendo 3 Dados de Combate de daño Físico Aturdidor, +2 Dados de Combate por cada Zona por encima del nivel del suelo en la que estabas antes de caer.\n\nCada rango adicional hace brotar otro par de alas y aumenta en 1 el máximo de Zonas verticales que podés recorrer (máximo 3 Zonas). Cada vez que adquirís este Perk, el requisito de Nivel aumenta en 3." },
        { id: "perk231", img: "127", source:"homebrew" , name: "Volar como un Sanguinario", rank: 3, ranks: 3, perkRequired: ["numen"], perkExclusive: [], reqs: { Nivel: 9 }, reqText: "mutación Creo que puedo volar, Nivel 9+", desc: "Te brota un par adicional de alas, dándote suficiente potencia para volar hasta 3 Zonas verticales por encima del suelo y moverte en tu plano horizontal actual. Requiere una Acción Menor para permanecer en el aire y, si sufrís Derribo o tu Torso resulta lesionado, caés al suelo, sufriendo 3 Dados de Combate de daño Físico Aturdidor, +2 Dados de Combate por cada Zona por encima del nivel del suelo en la que estabas antes de caer.\n\nCada rango adicional hace brotar otro par de alas y aumenta en 1 el máximo de Zonas verticales que podés recorrer (máximo 3 Zonas). Cada vez que adquirís este Perk, el requisito de Nivel aumenta en 3." },

        { id: "perk232", img: "128", source:"homebrew" , name: "Oculto a Plena Vista", rank: 1, ranks: 1, perkRequired: ["numen"], perkExclusive: [], reqs: { Nivel: 5 }, reqText: "Casi Super(Mutante), mutación ¡Estoy viendo doble!, Nivel 5", desc: "Aprendiste a suplantar mejor a otras personas, aunque lleva bastante tiempo. Podés dedicar 4 horas adicionales a perfeccionar tu suplantación, obteniendo un d20 de bonificación en las pruebas de CAR relacionadas con suplantar a la víctima." },

        { id: "perk233", img: "129", source:"homebrew" , name: "Condensación Corrosiva", rank: 1, ranks: 1, perkRequired: ["numen"], perkExclusive: [], reqs: { Nivel: 6 }, reqText: "Casi Super(Mutante), mutación Agujero en la pared (y en todo lo demás), Nivel 6", desc: "Aprendiste las propiedades de tu aliento corrosivo y cómo licuarlo dentro de un frasco. Utilizando 2 materiales comunes y 12 horas, podés llenar un frasco con corrosión líquida, creando una Granada de Ácido, que aparecerá al final de este documento." },

        { id: "perk234", img: "130", source:"homebrew" , name: "Reciclaje de Desechos", rank: 1, ranks: 1, perkRequired: ["numen"], perkExclusive: [], reqs: { Nivel: 5 }, reqText: "Rasgo Casi Super(Mutante), mutación Tirador Natural, Nivel 5", desc: "Tus desechos excesivos forman una película sobre tu brazo, recubriendo tus proyectiles y agregando el efecto Persistente (Veneno) a tu Brazo de Arma. Aunque no podés hacer mucho con el olor..." },

        { id: "perk235", img: "131", source:"homebrew" , name: "Tu Paseo Terminó, Mutante", rank: 1, ranks: 3, perkRequired: ["enclave"], perkExclusive: [], reqs: { Nivel: 3 }, reqText: "Origen Enclave, Nivel 3, Armas Pequeñas/Armas Grandes/Armas de Energía 2", desc: "Obtenés +1 Dado de Combate contra enemigos mutados. Cada vez que adquirís este Perk, el Nivel requerido aumenta en 5." },
        { id: "perk236", img: "131", source:"homebrew" , name: "Tu Paseo Terminó, Mutante", rank: 2, ranks: 3, perkRequired: ["enclave"], perkExclusive: [], reqs: { Nivel: 3 }, reqText: "Origen Enclave, Nivel 8, Armas Pequeñas/Armas Grandes/Armas de Energía 2", desc: "Obtenés +2 Dado de Combate contra enemigos mutados. Cada vez que adquirís este Perk, el Nivel requerido aumenta en 5." },
        { id: "perk237", img: "131", source:"homebrew" , name: "Tu Paseo Terminó, Mutante", rank: 3, ranks: 3, perkRequired: ["enclave"], perkExclusive: [], reqs: { Nivel: 3 }, reqText: "Origen Enclave, Nivel 13, Armas Pequeñas/Armas Grandes/Armas de Energía 2", desc: "Obtenés +3 Dado de Combate contra enemigos mutados. Cada vez que adquirís este Perk, el Nivel requerido aumenta en 5." },

        { id: "perk238", img: "132", source:"homebrew" , name: "Aprendiz del Sargento Dornan", rank: 1, ranks: 2, perkRequired: ["enclave"], perkExclusive: [], reqs: { CAR: 8 }, reqText: "Enclave, CARISMA 8", desc: "Podés repetir 1d20 cuando intimidás a alguien." },
        { id: "perk239", img: "132", source:"homebrew" , name: "Aprendiz del Sargento Dornan", rank: 2, ranks: 2, perkRequired: ["enclave"], perkExclusive: [], reqs: { CAR: 8 }, reqText: "Enclave, CARISMA 8", desc: "Podés repetir 1d20 cuando intimidás a alguien. El segundo rango te permite intimidar a la gente para que siga tus órdenes." },

        { id: "perk240", img: "133", source:"homebrew" , name: "Médico de Combate", rank: 1, ranks: 1, perkRequired: ["enclave"], perkExclusive: [], reqs: {}, reqText: "Enclave, Medicina etiquetada (Tag)", desc: "Debido al conocimiento extensivo de la biología humana, podés curar a la gente mucho más fácilmente que la mayoría. Reducís en 1 la dificultad para tratar una herida en un humano (mínimo 0). Primeros Auxilios se convierte en una Acción Menor para vos." },

        { id: "perk241", img: "134", source:"homebrew" , name: "Gore, gore, qué manera de morir", rank: 1, ranks: 1, perkRequired: ["enclave"], perkExclusive: [], reqs: { Nivel: 10 }, reqText: "Enclave, Nivel 10", desc: "Cuando herís una extremidad de un enemigo, la amputás, haciendo imposible que sea curada y duplicando su penalización. Si fue un impacto en la cabeza, muere automáticamente." },

        { id: "perk242", img: "135", source:"homebrew" , name: "Nostalgia", rank: 1, ranks: 1, perkRequired: ["enclave"], perkExclusive: [], reqs: {}, reqText: "Enclave", desc: "Podés gastar 1 Punto de Acción para recordar algo de la América de antes de la guerra que sea pertinente a la situación o ubicación. Esto no te permite saber cosas que serían consideradas secretas." },

        { id: "perk243", img: "136", source:"homebrew" , name: "Impacto y Pavor", rank: 1, ranks: 1, perkRequired: ["enclave"], perkExclusive: [], reqs: {}, reqText: "Enclave", desc: "Los explosivos obtienen Vicioso, pero en lugar de +1 al daño, el efecto es +2." },

        { id: "perk244", img: "138", source:"homebrew" , name: "Replicante", rank: 1, ranks: 1, perkRequired: ["synth"], perkExclusive: [], reqs: {Origen: "Synth_Homebrew"}, reqText: "Synth de tercera generacion", desc: "Puedes relanzar tus dados de sigilo cuando te ocultes en una muchedumbre." },

        { id: "perk245", img: "139", source:"homebrew" , name: "Como lagrimas en la lluvia", rank: 1, ranks: 1, perkRequired: ["synth"], perkExclusive: [], reqs: {Origen: "Synth_Homebrew"}, reqText: "Origen Synth", desc: "Cuando falles una salvacion de muerte y mueras, siempre que tu componente Synth no sea removido, puedes ser reparado y vuelto a la vida, pero perdiendo memorias que el GM decida. Tu personalidad sera diferente, desde tener una nueva cancion favorita a una nueva identidad y voz." },

        { id: "perk246", img: "139", source:"homebrew" , name: "IA Adaptativa", rank: 1, ranks: 3, perkRequired: ["synth"], perkExclusive: [], reqs: {Nivel: 5}, reqText: "Origen Synth, Nivel 5", desc: "Tu experiencia en combate como un Synth del Instituto(ya sea un soldado o un courser), te permite obtener un tag adicional durante una escena por 1 Punto de accion, pero no puedes obtener Puntos de Accion de esa habilidad. Cada vez que obtengas este Perk, el nivel base aumenta en 5." },
        { id: "perk247", img: "139", source:"homebrew" , name: "IA Adaptativa", rank: 2, ranks: 3, perkRequired: ["synth"], perkExclusive: [], reqs: {Nivel: 10}, reqText: "Origen Synth, Nivel 10", desc: "Tu experiencia en combate como un Synth del Instituto(ya sea un soldado o un courser), te permite obtener dos tag adicionales durante una escena por 1 Punto de accion, pero no puedes obtener Puntos de Accion de esa habilidad. Cada vez que obtengas este Perk, el nivel base aumenta en 5." },
        { id: "perk248", img: "139", source:"homebrew" , name: "IA Adaptativa", rank: 3, ranks: 3, perkRequired: ["synth"], perkExclusive: [], reqs: {Nivel: 15}, reqText: "Origen Synth, Nivel 15", desc: "Tu experiencia en combate como un Synth del Instituto(ya sea un soldado o un courser), te permite obtener tres tag adicionales durante una escena por 1 Punto de accion, pero no puedes obtener Puntos de Accion de esa habilidad. Cada vez que obtengas este Perk, el nivel base aumenta en 5." },

        { id: "perk249", img: "140", source:"homebrew" , name: "Muerde mi brillante trasero metalico", rank: 1, ranks: 1, perkRequired: ["synth"], perkExclusive: [], reqs: {Origen: "Synth_Homebrew", GeneracionSynth: ["First generation", "Second generation"], Nivel: 5}, reqText: "Origen Synth de primera o segunda generacion, Nivel 5", desc: "A pesar de tu falta de tecnologia sofisticada, has obtenido la habilidad para mejorarte a ti mismo. Puedes modificarte usando mods." },

        { id: "perk250", img: "141", source:"homebrew" , name: "Dejame googlearlo", rank: 1, ranks: 1, perkRequired: ["synth"], perkExclusive: [], reqs: {Origen: "Synth_Homebrew"}, reqText: "Origen Synth", desc: "Tus bancos de memoria son extensos, permitiendote recordar cosas con precision mas rapido que cualquier ser organico. Cualquier prueba de conocimiento tiene su dificultad reducida en 1(minimo 0)." },

        { id: "perk251", img: "142", source:"homebrew" , name: "Boston Dynamics", rank: 1, ranks: 1, perkRequired: ["synth"], perkExclusive: [], reqs: {Origen: "Synth_Homebrew"}, reqText: "Origen Synth", desc: "Debido rigurosos test, tu Resistencia al Daño físico aumenta en todas las ubicaciones impactadas según tu Inteligencia. No obtenés este beneficio mientras llevás Servoarmadura. INT 7–8: +1 DR física. INT 9–10: +2 DR física. INT 11+: +3 DR física." },

        { id: "perk252", img: "143", source:"homebrew" , name: "Terminator", rank: 1, ranks: 4, perkRequired: ["synth"], perkExclusive: [], reqs: {Nivel: 10}, reqText: "Origen Synth, Nivel 10", desc: "'No siente dolor...': Una vez por escena, puedes ignorar una herida." },
        { id: "perk253", img: "143", source:"homebrew" , name: "Terminator", rank: 2, ranks: 4, perkRequired: ["synth"], perkExclusive: [], reqs: {Nivel: 15}, reqText: "Origen Synth, Nivel 15", desc: "'No siente dolor...'': Una vez por escena, puedes ignorar una herida. 'O miedo': Es imposible de intimidar." },
        { id: "perk254", img: "143", source:"homebrew" , name: "Terminator", rank: 3, ranks: 4, perkRequired: ["synth"], perkExclusive: [], reqs: {Nivel: 20}, reqText: "Origen Synth, Nivel 20", desc: "'No siente dolor...'': Una vez por escena, puedes ignorar una herida. 'O miedo': Es imposible de intimidar. 'O remordimiento': Todos sus ataques tienen +1d20(maximo 5d20)." },
        { id: "perk255", img: "143", source:"homebrew" , name: "Terminator", rank: 4, ranks: 4, perkRequired: ["synth"], perkExclusive: [], reqs: {Nivel: 25}, reqText: "Origen Synth, Nivel 25", desc: "'No siente dolor...'': Una vez por escena, puedes ignorar una herida. 'O miedo': Es imposible de intimidar. 'O remordimiento': Todos sus ataques tienen +1d20(maximo 5d20). 'Y no se detendrá hasta que estés muerto.': Cuando falles una tirada de salvacion de muerte, puedes relanzar la tirada." },

        { id: "perk256", img: "144", source: "wanderersGuide", name: "Bloqueador", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { STR: 6, Nivel: 1 }, reqText: "STR 6, Nivel 1+", desc: "Cuando recibís un ataque cuerpo a cuerpo, aumentá en +1 la resistencia al daño físico o de energía que corresponda al ataque." },
        { id: "perk257", img: "144", source: "wanderersGuide", name: "Bloqueador", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { STR: 6, Nivel: 6 }, reqText: "STR 6, Nivel 6+", desc: "Cuando recibís un ataque cuerpo a cuerpo, aumentá en +2 la resistencia al daño físico o de energía que corresponda al ataque." },
        { id: "perk258", img: "144", source: "wanderersGuide", name: "Bloqueador", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { STR: 6, Nivel: 11 }, reqText: "STR 6, Nivel 11+", desc: "Cuando recibís un ataque cuerpo a cuerpo, aumentá en +3 la resistencia al daño físico o de energía que corresponda al ataque." },

        { id: "perk259", img: "145", source: "wanderersGuide", name: "Escudo de balas", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { STR: 8, Nivel: 8 }, reqText: "STR 8, Nivel 8+", desc: "Mientras empuñás un arma pesada, aumentá en +2 tu resistencia al daño." },
