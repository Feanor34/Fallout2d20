        { id: "perk014", img: "007", source:"coreBook" , name: "Percepción", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { PER: 7 }, reqText: "PER 7", desc: "Cuando realizás la acción menor Apuntar contra un objetivo a alcance Corto, detectás sus debilidades y podés atacarlo de manera más eficiente. El próximo ataque que realices contra ese objetivo obtiene el efecto de daño Perforante 1, o aumenta en 1 el valor de cualquier efecto de daño Perforante X que ya tenga." },

        { id: "perk015", img: "008", source:"coreBook" , name: "Bárbaro", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { FUE: 7, Nivel: 4 }, reqText: "FUE 7, Nivel 4+, no ser un robot", desc: "Tu Resistencia al Daño físico aumenta en todas las ubicaciones impactadas según tu FUE. No obtenés este beneficio mientras llevás Servoarmadura. FUE 7–8: +1 DR física. FUE 9–10: +2 DR física. FUE 11+: +3 DR física.", system: [ { type: "extraPhysDR", basedOn: "FUE", values: [ { min: 7, max: 8, value: 1 }, { min: 9, max: 10, value: 2 }, { min: 11, value: 3 } ] } ] }, 

        { id: "perk016", img: "009", source:"coreBook" , name: "Golpe", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { FUE: 6 }, reqText: "FUE 6", desc: "Cuando realizás un ataque cuerpo a cuerpo golpeando con tu arma de fuego, tu ataque obtiene el efecto de daño Vicioso." },

        { id: "perk017", img: "010", source:"coreBook" , name: "Críticos Mejorados", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { LCK: 9 }, reqText: "LCK 9", desc: "Cuando infligís uno o más puntos de daño a un enemigo, podés gastar 1 Punto de Suerte para infligir automáticamente un golpe crítico, causando una herida." },

        { id: "perk018", img: "011", source:"coreBook" , name: "Grandes Ligas", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { FUE: 8 }, reqText: "FUE 8", desc: "Cuando realizás un ataque cuerpo a cuerpo con un arma cuerpo a cuerpo de dos manos, el arma obtiene el efecto de daño Vicioso." },

        { id: "perk019", img: "012", source:"coreBook" , name: "Viuda Negra/Cazador de Damas", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { CAR: 6 }, reqText: "CAR 6", desc: "El perk Viuda Negra afecta a hombres y personajes masculinos, mientras que el perk Cazador de Damas afecta a mujeres y personajes femeninos; por lo demás, son idénticos. Cuando intentás una prueba de habilidad basada en CAR para influir sobre un personaje del género elegido, podés volver a tirar 1d20. Además, tus ataques infligen +1 DCD de daño adicional contra personajes del género elegido." },

        { id: "perk020", img: "013", source:"coreBook" , name: "Herrero", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { FUE: 6, Nivel: 2 }, reqText: "FUE 6, Nivel 2+", desc: "Podés modificar armas cuerpo a cuerpo con mods de armas. Este rango desbloquea mods de rango 1." },
        { id: "perk021", img: "013", source:"coreBook" , name: "Herrero", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { FUE: 6, Nivel: 6 }, reqText: "FUE 6, Nivel 6+", desc: "Podés modificar armas cuerpo a cuerpo con mods de armas. Este rango desbloquea mods de rango 2." },
        { id: "perk022", img: "013", source:"coreBook" , name: "Herrero", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { FUE: 6, Nivel: 10 }, reqText: "FUE 6, Nivel 10+", desc: "Podés modificar armas cuerpo a cuerpo con mods de armas. Este rango desbloquea mods de rango 3." },

        { id: "perk023", img: "014", source:"coreBook" , name: "Blitz", rank: 1, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { AGI: 9, Nivel: 1 }, reqText: "AGI 9, Nivel 1+", desc: "Cuando te movés hasta alcanzar a un oponente y realizás un ataque cuerpo a cuerpo contra él durante el mismo turno, podés volver a tirar un d20 de tu ataque." },
        { id: "perk024", img: "014", source:"coreBook" , name: "Blitz", rank: 2, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { AGI: 9, Nivel: 4 }, reqText: "AGI 9, Nivel 4+", desc: "Cuando te movés hasta alcanzar a un oponente y realizás un ataque cuerpo a cuerpo contra él durante el mismo turno, podés volver a tirar un d20 de tu ataque. Además, infligís +1 CD de daño con ese ataque." },

        { id: "perk025", img: "015", source:"coreBook" , name: "Desorden Sangriento", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { LCK: 6 }, reqText: "LCK 6", desc: "Cuando infligís un golpe crítico, tirá 1 DCD; si obtenés un Efecto, infligís una herida adicional en una ubicación aleatoria." },

        { id: "perk026", img: "016", source:"coreBook" , name: "¡Puede Servir!", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { LCK: 5 }, reqText: "LCK 5", desc: "Cuando saqueás una ubicación que contiene comida, obtenés 1 objeto de comida aleatorio adicional, sin gastar PA." },

        { id: "perk027", img: "017", source:"coreBook" , name: "Coleccionista de Chapas", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { CAR: 5 }, reqText: "CAR 5", desc: "Cuando comprás o vendés objetos, podés aumentar o reducir el precio de los bienes intercambiados en un 10%." },

        { id: "perk028", img: "018", source:"coreBook" , name: "Naturaleza Cautelosa", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { PER: 7 }, reqText: "PER 7", desc: "Siempre que intentás una prueba de habilidad y comprás uno o más d20 gastando Puntos de Acción, podés volver a tirar 1d20 de esa prueba. No podés adquirir este perk si tenés Naturaleza Audaz." },

        { id: "perk029", img: "019", source:"coreBook" , name: "Centro de Masa", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { AGI: 7 }, reqText: "AGI 7", desc: "Cuando realizás un ataque a distancia, podés elegir impactar la ubicación Torso de tu objetivo (o su equivalente, para criaturas que utilizan una tabla de ubicaciones diferente) sin aumentar la dificultad del ataque. Además, podés volver a tirar 1d20 al realizar la prueba de tu ataque." },

        { id: "perk030", img: "020", source:"coreBook" , name: "Resistencia a los Químicos", rank: 1, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { END: 7, Nivel: 1 }, reqText: "END 7, Nivel 1+", desc: "Tirás un dado menos al determinar si te volvés adicto a los químicos, hasta un mínimo de 0." },
        { id: "perk031", img: "020", source:"coreBook" , name: "Resistencia a los Químicos", rank: 2, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { END: 7, Nivel: 5 }, reqText: "END 7, Nivel 5+", desc: "No podés volverte adicto a los químicos." },

        { id: "perk032", img: "021", source:"coreBook" , name: "Químico", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { INT: 7 }, reqText: "INT 7", desc: "Los químicos que creás duran el doble de lo normal. Además, desbloqueás recetas de químicos que tienen este perk como requisito." },

        { id: "perk033", img: "022", source:"coreBook" , name: "Comando", rank: 1, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { AGI: 8, Nivel: 2 }, reqText: "AGI 8, Nivel 2+", desc: "Cuando realizás un ataque a distancia con cualquier arma con una Cadencia de Fuego de 3 o superior (excepto armas pesadas), agregás +1 al daño del arma.", system: [ { type: "extraRangeDamage", value: 1, condition: { weaponFireRate: { min: 3 }, weaponCategory: { not: "heavy" } } } ] },
        { id: "perk034", img: "022", source:"coreBook" , name: "Comando", rank: 2, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { AGI: 8, Nivel: 5 }, reqText: "AGI 8, Nivel 5+", desc: "Cuando realizás un ataque a distancia con cualquier arma con una Cadencia de Fuego de 3 o superior (excepto armas pesadas), agregás +2 al daño del arma.", system: [ { type: "extraRangeDamage", value: 2, condition: { weaponFireRate: { min: 3 }, weaponCategory: { not: "heavy" } } } ] },

        { id: "perk035", img: "023", source:"coreBook" , name: "Comprensión", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { INT: 6 }, reqText: "INT 6", desc: "Después de utilizar el bonificador obtenido al leer una revista, tirá 1 CD. Si obtenés un Efecto, podés utilizar ese bonificador una vez adicional." },

        { id: "perk036", img: "024", source:"coreBook" , name: "Fuego Concentrado", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { PER: 8, AGI: 6 }, reqText: "PER 8, AGI 6", desc: "Cuando realizás un ataque a distancia y gastás munición para aumentar el daño, podés volver a tirar hasta 3 CD de tu tirada de daño." },

        { id: "perk037", img: "025", source:"coreBook" , name: "Naturaleza Audaz", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { LCK: 7 }, reqText: "LCK 7", desc: "Siempre que intentás una prueba de habilidad y comprás uno o más d20 dándole Puntos de Acción al Director de Juego, podés volver a tirar 1d20 de esa prueba. No podés adquirir este perk si tenés Naturaleza Cautelosa." },

        { id: "perk038", img: "026", source:"coreBook" , name: "Experto en Demoliciones", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { PER: 6, LCK: 6 }, reqText: "PER 6, LCK 6", desc: "Cuando realizás un ataque utilizando un arma con la propiedad Explosión, el ataque obtiene el efecto de daño Vicioso. Además, desbloqueás recetas de explosivos que tienen este perk como requisito." },

        { id: "perk039", img: "027", source:"coreBook" , name: "Esquiva", rank: 1, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { AGI: 6, Nivel: 4 }, reqText: "AGI 6, Nivel 4+", desc: "Cuando realizás la acción mayor Defender, reducís la dificultad de la prueba de habilidad en 1." },
        { id: "perk040", img: "027", source:"coreBook" , name: "Esquiva", rank: 2, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { AGI: 6, Nivel: 10 }, reqText: "AGI 6, Nivel 10+", desc: "Cuando realizás la acción mayor Defender, reducís la dificultad de la prueba de habilidad en 1. Además, el costo en PA para aumentar aún más tu Defensa se reduce a 1 PA." },

        { id: "perk041", img: "028", source:"coreBook" , name: "Dogmeat", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { CAR: 5 }, reqText: "CAR 5", desc: "No estás solo en el Yermo. Tenés un perro mascota que sirve como amigo y aliado en tiempos peligrosos. El perro tiene el perfil mostrado al costado y es tratado como una criatura PNJ aliada bajo tu mando (ver pág. 338). Si necesitás buscar comida y agua, tu perro se las arregla solo. Si tu perro muere, encontrás un perro nuevo antes de la próxima aventura, o podés cambiar este perk por uno diferente después de esta aventura.", system: [dogmeat: 1] },

        { id: "perk042", img: "029", source:"coreBook" , name: "Entomólogo", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { INT: 7 }, reqText: "INT 7", desc: "Cuando realizás un ataque contra un PNJ con la palabra clave Insecto, tu ataque obtiene el efecto de daño Perforante 1, o aumenta en +1 el valor de cualquier efecto Perforante X que ya tenga el arma." },

        { id: "perk043", img: "030", source:"coreBook" , name: "Metabolismo Rápido", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { END: 6, Nivel: 1 }, reqText: "END 6, Nivel 1+, no ser un robot", desc: "Cuando recuperás uno o más PG de cualquier fuente que no sea descanso, aumentá el total de PG recuperados en +1." },
        { id: "perk044", img: "030", source:"coreBook" , name: "Metabolismo Rápido", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { END: 6, Nivel: 4 }, reqText: "END 6, Nivel 4+, no ser un robot", desc: "Cuando recuperás uno o más PG de cualquier fuente que no sea descanso, aumentá el total de PG recuperados en +2." },
        { id: "perk045", img: "030", source:"coreBook" , name: "Metabolismo Rápido", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { END: 6, Nivel: 7 }, reqText: "END 6, Nivel 7+, no ser un robot", desc: "Cuando recuperás uno o más PG de cualquier fuente que no sea descanso, aumentá el total de PG recuperados en +3." },

        { id: "perk046", img: "031", source:"coreBook" , name: "Curación Rápida", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { END: 6 }, reqText: "END 6, no ser un robot", desc: "Cuando realizás una prueba de END + Supervivencia para curar tus propias heridas, el primer d20 adicional que comprás es gratis. El máximo normal de 5d20 sigue aplicándose." },

        { id: "perk047", img: "032", source:"coreBook" , name: "Fineza", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { AGI: 9 }, reqText: "AGI 9", desc: "Una vez por encuentro de combate, podés volver a tirar todos los dados de una única tirada de daño sin gastar Puntos de Suerte." },

        { id: "perk048", img: "033", source:"coreBook" , name: "Buscador de Fortuna", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { LCK: 5, Nivel: 2 }, reqText: "LCK 5, Nivel 2+", desc: "Siempre que tirás para determinar cuánto dinero encontrás, encontrás +3 dados de chapas adicionales." },
        { id: "perk049", img: "033", source:"coreBook" , name: "Buscador de Fortuna", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { LCK: 5, Nivel: 6 }, reqText: "LCK 5, Nivel 6+", desc: "Siempre que tirás para determinar cuánto dinero encontrás, encontrás +6 dados de chapas adicionales." },
        { id: "perk050", img: "033", source:"coreBook" , name: "Buscador de Fortuna", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { LCK: 5, Nivel: 10 }, reqText: "LCK 5, Nivel 10+", desc: "Siempre que tirás para determinar cuánto dinero encontrás, encontrás +10 dados de chapas adicionales." },

        { id: "perk051", img: "034", source:"coreBook" , name: "Fantasma", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { PER: 5, AGI: 6 }, reqText: "PER 5, AGI 6", desc: "Siempre que intentás una prueba de AGI + Sigilo en sombras u oscuridad, el primer d20 adicional que comprás es gratis. El máximo normal de 5d20 sigue aplicándose." },

        { id: "perk052", img: "035", source:"coreBook" , name: "Carrera del Segador", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { LCK: 8 }, reqText: "LCK 8", desc: "Cuando realizás un ataque que mata a uno o más enemigos, tirá 1 DCD. Si obtenés un Efecto, agregá 2 PA a la reserva del grupo." },

        { id: "perk053", img: "036", source:"coreBook" , name: "Gun Fu", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { AGI: 10, Nivel: 1 }, reqText: "AGI 10, Nivel 1+", desc: "Cuando tenés éxito en un ataque a distancia, podés gastar 1 PA y 1 munición para impactar a un segundo objetivo a alcance Corto de tu objetivo inicial. El segundo objetivo recibe el mismo daño que el objetivo inicial." },
        { id: "perk054", img: "036", source:"coreBook" , name: "Gun Fu", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { AGI: 10, Nivel: 6 }, reqText: "AGI 10, Nivel 6+", desc: "Cuando tenés éxito en un ataque a distancia, podés gastar 2 PA y 2 municiones para impactar a dos objetivos adicionales a alcance Corto de tu objetivo inicial. Cada objetivo recibe el mismo daño que el objetivo inicial." },
        { id: "perk055", img: "036", source:"coreBook" , name: "Gun Fu", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { AGI: 10, Nivel: 11 }, reqText: "AGI 10, Nivel 11+", desc: "Cuando tenés éxito en un ataque a distancia, podés gastar 3 PA y 3 municiones para impactar a tres objetivos adicionales a alcance Corto de tu objetivo inicial. Cada objetivo recibe el mismo daño que el objetivo inicial." },

        { id: "perk056", img: "037", source:"coreBook" , name: "Loco de las Armas", rank: 1, ranks: 4, perkRequired: [], perkExclusive: [], reqs: { INT: 6, Nivel: 2 }, reqText: "INT 6, Nivel 2+", desc: "Podés modificar armas pequeñas y armas pesadas con mods de armas. Este rango desbloquea mods de rango 1." },
        { id: "perk057", img: "037", source:"coreBook" , name: "Loco de las Armas", rank: 2, ranks: 4, perkRequired: [], perkExclusive: [], reqs: { INT: 6, Nivel: 6 }, reqText: "INT 6, Nivel 6+", desc: "Podés modificar armas pequeñas y armas pesadas con mods de armas. Este rango desbloquea mods de rango 2." },
        { id: "perk058", img: "037", source:"coreBook" , name: "Loco de las Armas", rank: 3, ranks: 4, perkRequired: [], perkExclusive: [], reqs: { INT: 6, Nivel: 10 }, reqText: "INT 6, Nivel 10+", desc: "Podés modificar armas pequeñas y armas pesadas con mods de armas. Este rango desbloquea mods de rango 3." },
        { id: "perk059", img: "037", source:"coreBook" , name: "Loco de las Armas", rank: 4, ranks: 4, perkRequired: [], perkExclusive: [], reqs: { INT: 6, Nivel: 14 }, reqText: "INT 6, Nivel 14+", desc: "Podés modificar armas pequeñas y armas pesadas con mods de armas. Este rango desbloquea mods de rango 4." },

        { id: "perk060", img: "038", source:"coreBook" , name: "Pistolero", rank: 1, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { AGI: 7, Nivel: 2 }, reqText: "AGI 7, Nivel 2+", desc: "Cuando realizás un ataque con un arma a distancia de una mano con una Cadencia de Fuego de 2 o menos, aumentás el daño del arma en +1 CD. Además, podés volver a tirar el dado de ubicación del impacto.", system: [ {type: "extraRangeDamage", value: 1, condition: {weaponFireRate: {max: 2}, weaponCategory: {"one-handed"}}} ] },
        { id: "perk061", img: "038", source:"coreBook" , name: "Pistolero", rank: 2, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { AGI: 7, Nivel: 6 }, reqText: "AGI 7, Nivel 6+", desc: "Cuando realizás un ataque con un arma a distancia de una mano con una Cadencia de Fuego de 2 o menos, aumentás el daño del arma en +2 CD. Además, podés volver a tirar el dado de ubicación del impacto.", system: [ {type: "extraRangeDamage", value: 1, condition: {weaponFireRate: {max: 2}, weaponCategory: {"one-handed"}}} ] },

        { id: "perk062", img: "039", source:"coreBook" , name: "Hacker", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { INT: 8 }, reqText: "INT 8", desc: "La dificultad de las pruebas de habilidad para hackear computadoras se reduce en 1, hasta un mínimo de 0." },

        { id: "perk063", img: "040", source:"coreBook" , name: "Sanador", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { INT: 7, Nivel: 1 }, reqText: "INT 7, Nivel 1+", desc: "Cuando curás los PG de un paciente utilizando la acción Primeros auxilios, aumentá la cantidad de PG curados en +1." },
        { id: "perk064", img: "040", source:"coreBook" , name: "Sanador", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { INT: 7, Nivel: 6 }, reqText: "INT 7, Nivel 6+", desc: "Cuando curás los PG de un paciente utilizando la acción Primeros auxilios, aumentá la cantidad de PG curados en +2." },
        { id: "perk065", img: "040", source:"coreBook" , name: "Sanador", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { INT: 7, Nivel: 11 }, reqText: "INT 7, Nivel 11+", desc: "Cuando curás los PG de un paciente utilizando la acción Primeros auxilios, aumentá la cantidad de PG curados en +3." },

        { id: "perk066", img: "041", source:"coreBook" , name: "¡Arriba!", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { FUE: 8 }, reqText: "FUE 8", desc: "Cuando realizás un ataque con un arma arrojadiza, podés gastar 1 PA para aumentar el Alcance del arma en un paso: de Corto a Medio, o de Medio a Largo." },

        { id: "perk067", img: "042", source:"coreBook" , name: "Cazador", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { END: 6 }, reqText: "END 6", desc: "Cuando realizás un ataque contra un PNJ con una de las palabras clave Mamífero, Lagarto o Insecto y la palabra clave Mutado, tu ataque obtiene el efecto de daño Vicioso, si todavía no tenía ese efecto." },

        { id: "perk068", img: "043", source:"coreBook" , name: "Infiltrador", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { PER: 8 }, reqText: "PER 8", desc: "Cuando intentás una prueba de habilidad de Cerrajería para abrir una puerta o un contenedor, podés volver a tirar 1d20." },

        { id: "perk069", img: "044", source:"coreBook" , name: "Inspirador", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { CAR: 8 }, reqText: "CAR 8", desc: "Como liderás con el ejemplo, la cantidad máxima de PA que el grupo puede guardar aumenta en 1." },

        { id: "perk070", img: "045", source:"coreBook" , name: "Entrenamiento Intenso", rank: 1, ranks: 10, perkRequired: [], perkExclusive: [], reqs: { Nivel: 2 }, reqText: "Nivel 2+", desc: "Aumentá cualquier atributo S.P.E.C.I.A.L. en 1 rango. Tus atributos S.P.E.C.I.A.L. no pueden aumentar por encima de 10 mediante este método.", system: [extraSpecial: 1] },
        { id: "perk071", img: "045", source:"coreBook" , name: "Entrenamiento Intenso", rank: 2, ranks: 10, perkRequired: [], perkExclusive: [], reqs: { Nivel: 4 }, reqText: "Nivel 4+", desc: "Aumentá cualquier atributo S.P.E.C.I.A.L. en 1 rango. Tus atributos S.P.E.C.I.A.L. no pueden aumentar por encima de 10 mediante este método.", system: [extraSpecial: 2] },
        { id: "perk072", img: "045", source:"coreBook" , name: "Entrenamiento Intenso", rank: 3, ranks: 10, perkRequired: [], perkExclusive: [], reqs: { Nivel: 6 }, reqText: "Nivel 6+", desc: "Aumentá cualquier atributo S.P.E.C.I.A.L. en 1 rango. Tus atributos S.P.E.C.I.A.L. no pueden aumentar por encima de 10 mediante este método.", system: [extraSpecial: 3] },
