        { id: "perk065", img: "040", source:"coreBook" , name: "Sanador", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { INT: 7, Nivel: 11 }, reqText: "INT 7, Nivel 11+", desc: "Cuando curás los PG de un paciente utilizando la acción Primeros auxilios, aumentá la cantidad de PG curados en +3." },

        { id: "perk066", img: "041", source:"coreBook" , name: "¡Arriba!", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { FUE: 8 }, reqText: "FUE 8", desc: "Cuando realizás un ataque con un arma arrojadiza, podés gastar 1 PA para aumentar el Alcance del arma en un paso: de Corto a Medio, o de Medio a Largo." },

        { id: "perk067", img: "042", source:"coreBook" , name: "Cazador", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { END: 6 }, reqText: "END 6", desc: "Cuando realizás un ataque contra un PNJ con una de las palabras clave Mamífero, Lagarto o Insecto y la palabra clave Mutado, tu ataque obtiene el efecto de daño Vicioso, si todavía no tenía ese efecto." },

