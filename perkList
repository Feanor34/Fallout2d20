        { id: "perk331", img: "183", source: "wanderersGuide", name: "Usuario de energía", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { INT: 9, Nivel: 10 }, reqText: "INT 9, Nivel 10+", desc: "Los núcleos de fusión que usás contienen 3 cargas adicionales." },
        { id: "perk332", img: "183", source: "wanderersGuide", name: "Usuario de energía", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { INT: 9, Nivel: 20 }, reqText: "INT 9, Nivel 20+", desc: "Los núcleos de fusión que usás contienen 6 cargas adicionales." },
        { id: "perk333", img: "183", source: "wanderersGuide", name: "Usuario de energía", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { INT: 9, Nivel: 30 }, reqText: "INT 9, Nivel 30+", desc: "Los núcleos de fusión que usás contienen 10 cargas adicionales." },

        { id: "perk334", img: "184", source: "wanderersGuide", name: "Estabilizado", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { INT: 7, Nivel: 16 }, reqText: "INT 7, Nivel 16+", desc: "Mientras llevás una servoarmadura, podés repetir 1d20 en cualquier ataque realizado con la habilidad Armas pesadas. Además, cualquier arma pesada que empuñes obtiene Penetración 1, o aumenta en 1 el valor de su efecto Penetración X." },

        { id: "perk335", img: "185", source: "wanderersGuide", name: "Superviviente nato", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { AGI: 8, Nivel: 3 }, reqText: "AGI 8, Nivel 3+", desc: "Cuando sufrís daño que reduciría tus PG por debajo de un cuarto de tu máximo, podés usar automáticamente un Estimulante, incluido uno diluido o súper. Podés hacerlo una vez por escena." },
        { id: "perk336", img: "185", source: "wanderersGuide", name: "Superviviente nato", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { AGI: 8, Nivel: 11 }, reqText: "AGI 8, Nivel 11+", desc: "Cuando sufrís daño que reduciría tus PG por debajo de un cuarto de tu máximo, podés usar automáticamente un Estimulante, incluido uno diluido o súper. Podés hacerlo dos veces por escena." },
        { id: "perk337", img: "185", source: "wanderersGuide", name: "Superviviente nato", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { AGI: 8, Nivel: 19 }, reqText: "AGI 8, Nivel 19+", desc: "Cuando sufrís daño que reduciría tus PG por debajo de un cuarto de tu máximo, podés usar automáticamente un Estimulante, incluido uno diluido o súper. Podés hacerlo tres veces por escena." },

        { id: "perk338", img: "186", source: "wanderersGuide", name: "Corriendo entre los muertos", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { AGI: 7, Nivel: 8 }, reqText: "AGI 7, Nivel 8+", desc: "Cuando realizás la acción Esprintar, si tus PG actuales están por debajo de la mitad de tu máximo, podés gastar 1 PA para moverte una zona adicional." },

        { id: "perk339", img: "187", source: "wanderersGuide", name: "Artista del escape", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { AGI: 8, Nivel: 15 }, reqText: "AGI 8, Nivel 15", desc: "Durante el combate, si ningún enemigo puede verte al comienzo de tu turno, podés intentar ocultarte con una prueba de AGI + Sigilo. La dificultad es igual al número de enemigos a alcance Medio. Una vez oculto, los enemigos dejan de saber dónde estás, aunque pueden buscarte. Además, no reciben bonificaciones para detectarte si Esprintás." },

        { id: "perk340", img: "188", source: "wanderersGuide", name: "Evasivo", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { AGI: 7, Nivel: 7 }, reqText: "AGI 7, Nivel 7+", desc: "Tu resistencia al daño físico y de energía en todas las localizaciones aumenta según tu Agilidad. AGI 7–8: +1; AGI 9–10: +2; AGI 11 o más: +3. No obtenés este beneficio mientras llevás servoarmadura o estás sobrecargado." },

        { id: "perk341", img: "189", source: "wanderersGuide", name: "Piernas de cabra", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { AGI: 7, Nivel: 7 }, reqText: "AGI 7, Nivel 7+", desc: "Obtenés +2 de resistencia al daño físico contra el daño por caídas." },
        { id: "perk342", img: "189", source: "wanderersGuide", name: "Piernas de cabra", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { AGI: 7, Nivel: 12 }, reqText: "AGI 7, Nivel 12+", desc: "Obtenés +4 de resistencia al daño físico contra el daño por caídas." },
        { id: "perk343", img: "189", source: "wanderersGuide", name: "Piernas de cabra", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { AGI: 7, Nivel: 17 }, reqText: "AGI 7, Nivel 17+", desc: "Obtenés +6 de resistencia al daño físico contra el daño por caídas." },

        { id: "perk344", img: "190", source: "wanderersGuide", name: "Renegado moderno", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { AGI: 7, Nivel: 8 }, reqText: "AGI 7, Nivel 8+", desc: "Cuando atacás con un arma de fuego de una mano sin apuntar, un ataque exitoso genera 1 PA adicional que no puede guardarse." },
        { id: "perk345", img: "190", source: "wanderersGuide", name: "Renegado moderno", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { AGI: 7, Nivel: 13 }, reqText: "AGI 7, Nivel 13+", desc: "Cuando atacás con un arma de fuego de una mano sin apuntar, un ataque exitoso genera 2 PA adicionales que no pueden guardarse." },
        { id: "perk346", img: "190", source: "wanderersGuide", name: "Renegado moderno", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { AGI: 7, Nivel: 18 }, reqText: "AGI 7, Nivel 18+", desc: "Cuando atacás con un arma de fuego de una mano sin apuntar, un ataque exitoso genera 3 PA adicionales que no pueden guardarse." },

        { id: "perk347", img: "191", source: "wanderersGuide", name: "Agente secreto", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { AGI: 9, Nivel: 7 }, reqText: "AGI 9, Nivel 7+", desc: "Cuando usás un Stealth Boy, su duración aumenta en un turno." },
        { id: "perk348", img: "191", source: "wanderersGuide", name: "Agente secreto", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { AGI: 9, Nivel: 12 }, reqText: "AGI 9, Nivel 12+", desc: "Cuando usás un Stealth Boy, su duración aumenta en dos turnos." },
        { id: "perk349", img: "191", source: "wanderersGuide", name: "Agente secreto", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { AGI: 9, Nivel: 17 }, reqText: "AGI 9, Nivel 17+", desc: "Cuando usás un Stealth Boy, su duración aumenta en tres turnos." },

        { id: "perk350", img: "192", source: "wanderersGuide", name: "Enfermero de campaña", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { LCK: 8, Nivel: 13 }, reqText: "LCK 8, Nivel 13+", desc: "Cuando tenés éxito en una acción de Primeros auxilios durante el combate para estabilizar a un aliado moribundo y usaste un Estimulante, tirá 1 CD. Si obtenés un Efecto, el Estimulante no se consume y puede volver a utilizarse." },

        { id: "perk351", img: "193", source: "wanderersGuide", name: "Escudo de chatarra", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { LCK: 7, Nivel: 1 }, reqText: "LCK 7, Nivel 1+", desc: "Por cada 5 objetos de chatarra que llevás, obtenés +1 a la resistencia al daño físico y de energía. La bonificación máxima es igual a tu rango en este perk. No recibís esta bonificación mientras llevás servoarmadura." },
        { id: "perk352", img: "193", source: "wanderersGuide", name: "Escudo de chatarra", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { LCK: 7, Nivel: 9 }, reqText: "LCK 7, Nivel 9+", desc: "Por cada 5 objetos de chatarra que llevás, obtenés +1 a la resistencia al daño físico y de energía, hasta un máximo de +2. No recibís esta bonificación mientras llevás servoarmadura." },
        { id: "perk353", img: "193", source: "wanderersGuide", name: "Escudo de chatarra", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { LCK: 7, Nivel: 17 }, reqText: "LCK 7, Nivel 17+", desc: "Por cada 5 objetos de chatarra que llevás, obtenés +1 a la resistencia al daño físico y de energía, hasta un máximo de +3. No recibís esta bonificación mientras llevás servoarmadura." },

        { id: "perk354", img: "194", source: "wanderersGuide", name: "Salvador misterioso", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { LCK: 7, Nivel: 1 }, reqText: "LCK 7, Nivel 1+", desc: "De vez en cuando, un Salvador misterioso aparece para ayudarte con resultados letales. Al comienzo de un encuentro de combate, podés gastar 1 punto de Suerte. Si lo hacés, la primera vez que empieces a morir durante la escena, el DJ puede hacer aparecer al Salvador misterioso para revivirte y desaparecer. Si gastaste Suerte y no aparece, el DJ debe devolverte el punto. Cuando te revive, te estabiliza como si hubiera tenido éxito en una acción de Primeros auxilios, te devuelve la consciencia, recuperás 4 PG como si hubieras usado un Estimulante y podés volver a actuar durante la escena." },

        { id: "perk355", img: "195", source: "wanderersGuide", name: "Psicópata", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { LCK: 8, Nivel: 11 }, reqText: "LCK 8, Nivel 11+", desc: "Cuando matás a un enemigo, tirá una cantidad de CD igual a tu rango en este perk. Por cada Efecto obtenido, recuperás 1 punto de Suerte, hasta tu máximo." },
        { id: "perk356", img: "195", source: "wanderersGuide", name: "Psicópata", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { LCK: 8, Nivel: 17 }, reqText: "LCK 8, Nivel 17+", desc: "Cuando matás a un enemigo, tirá una cantidad de CD igual a tu rango en este perk. Por cada Efecto obtenido, recuperás 1 punto de Suerte, hasta tu máximo." },
        { id: "perk357", img: "195", source: "wanderersGuide", name: "Psicópata", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { LCK: 8, Nivel: 23 }, reqText: "LCK 8, Nivel 23+", desc: "Cuando matás a un enemigo, tirá una cantidad de CD igual a tu rango en este perk. Por cada Efecto obtenido, recuperás 1 punto de Suerte, hasta tu máximo." },

        { id: "perk358", img: "196", source: "wanderersGuide", name: "Serendipia", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { LCK: 7, Nivel: 5 }, reqText: "LCK 7, Nivel 5+", desc: "Cuando tus PG actuales están por debajo de un tercio de tu máximo, cada vez que te atacan podés gastar 1 punto de Suerte antes de tirar los dados para hacer que el ataque falle. Podés hacerlo una vez por escena." },
        { id: "perk359", img: "196", source: "wanderersGuide", name: "Serendipia", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { LCK: 7, Nivel: 11 }, reqText: "LCK 7, Nivel 11+", desc: "Cuando tus PG actuales están por debajo de un tercio de tu máximo, cada vez que te atacan podés gastar 1 punto de Suerte antes de tirar los dados para hacer que el ataque falle. Podés hacerlo dos veces por escena." },
        { id: "perk360", img: "196", source: "wanderersGuide", name: "Serendipia", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { LCK: 7, Nivel: 17 }, reqText: "LCK 7, Nivel 17+", desc: "Cuando tus PG actuales están por debajo de un tercio de tu máximo, cada vez que te atacan podés gastar 1 punto de Suerte antes de tirar los dados para hacer que el ataque falle. Podés hacerlo tres veces por escena." },

        { id: "perk361", img: "197", source: "wanderersGuide", name: "Cazador de tormentas", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { LCK: 6, Nivel: 15 }, reqText: "LCK 6, Nivel 15+", desc: "Cuando llueve o hay una tormenta de radiación, recuperás 1 PG al comienzo de cada uno de tus turnos durante el combate. Fuera del combate, recuperás PG por hora de lluvia equivalentes a la mitad de tu puntuación de Suerte, redondeada hacia arriba." },

        { id: "perk362", img: "198", source: "settlersGuide", name: "Toda la noche", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { Nivel: 16, NoRobot: true }, reqText: "Nivel 16, no ser un robot", desc: "Durante la noche, después del atardecer y antes del amanecer, tus estados de hambre y sed no empeoran. Al calcular las horas necesarias para empeorar dichos estados, ignorá las horas de progreso durante ese período. Además, ganás 1 de Fatiga cada dos días que estés muriéndote de hambre, en lugar de cada día." },

        { id: "perk363", img: "199", source: "settlersGuide", name: "Fabricante de munición", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { INT: 7, Nivel: 2 }, reqText: "INT 7, Nivel 2+", desc: "Podés fabricar una pieza de munición en un banco de trabajo de armas usando materiales, tratando su rareza como su complejidad. En este rango, podés fabricar munición de rareza 1 como máximo." },
        { id: "perk364", img: "199", source: "settlersGuide", name: "Fabricante de munición", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { INT: 7, Nivel: 6 }, reqText: "INT 7, Nivel 6+", desc: "Podés fabricar munición de hasta rareza 3. Además, podés desmantelar munición y recuperar la mitad de los materiales necesarios para fabricarla, redondeando hacia abajo, con un mínimo de 1." },
        { id: "perk365", img: "199", source: "settlersGuide", name: "Fabricante de munición", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { INT: 7, Nivel: 10 }, reqText: "INT 7, Nivel 10+", desc: "Podés fabricar munición de hasta rareza 5. Al fabricarla, tirá una cantidad de CD igual a 6 menos la rareza de la munición. Cada impacto aumenta en 1 la cantidad fabricada y cada efecto duplica esa cantidad. Cada vez que adquirís este perk, el requisito de nivel aumenta en 4." },

        { id: "perk366", img: "200", source: "settlersGuide", name: "Guardaespaldas", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { CHA: 8, Nivel: 5 }, reqText: "CHA 8, Nivel 5+", desc: "Cada personaje jugador y compañero, excepto vos, que esté a alcance cercano aumenta en 1 su Resistencia al Daño y su Resistencia a la Energía." },

        { id: "perk367", img: "201", source: "settlersGuide", name: "Organizador comunitario", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { CHA: 5, END: 5, Nivel: 1 }, reqText: "CHA 5, END 5, Nivel 1+", desc: "Tu comunidad obtiene +1 de Comida y +1 de Defensa por día, siempre que cada recurso esté mantenido por al menos una persona. También agrega +1 CD a las acciones de asentamiento Cazar y Recolectar, así como a Saquear." },
        { id: "perk368", img: "201", source: "settlersGuide", name: "Organizador comunitario", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { CHA: 5, END: 5, Nivel: 4 }, reqText: "CHA 5, END 5, Nivel 4+", desc: "Tu comunidad obtiene +2 de Comida y +2 de Defensa por día, siempre que cada recurso esté mantenido por al menos una persona. También agrega +1 CD a las acciones de asentamiento Cazar y Recolectar, así como a Saquear." },
        { id: "perk369", img: "201", source: "settlersGuide", name: "Organizador comunitario", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { CHA: 5, END: 5, Nivel: 7 }, reqText: "CHA 5, END 5, Nivel 7+", desc: "Tu comunidad obtiene +3 de Comida y +3 de Defensa por día, siempre que cada recurso esté mantenido por al menos una persona. También agrega +1 CD a las acciones de asentamiento Cazar y Recolectar, así como a Saquear. Cada vez que adquirís este perk, el requisito de nivel aumenta en 3." },

        { id: "perk370", img: "202", source: "settlersGuide", name: "Contratista", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { CHA: 5, INT: 5, Nivel: 2 }, reqText: "CHA 5, INT 5, Nivel 2+", desc: "Al construir estructuras para tu asentamiento, podés reducir a la mitad los materiales necesarios, hasta un mínimo de 1 unidad de cada tipo de material. Esto reduce la Felicidad general en 2. Podés duplicar el tiempo de construcción para evitar esa reducción." },
        { id: "perk371", img: "202", source: "settlersGuide", name: "Contratista", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { CHA: 5, INT: 5, Nivel: 6 }, reqText: "CHA 5, INT 5, Nivel 6+", desc: "Podés hacer que una persona realice una acción de asentamiento para construir un objeto aunque no tenga la habilidad requerida. Esto reduce la Felicidad general del asentamiento en 1. Si al menos una persona trabajando en la construcción tiene la habilidad, ignorás esa reducción." },
        { id: "perk372", img: "202", source: "settlersGuide", name: "Contratista", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { CHA: 5, INT: 5, Nivel: 10 }, reqText: "CHA 5, INT 5, Nivel 10+", desc: "Podés hacer que una persona realice una acción de asentamiento para construir un objeto aunque no tenga el perk requerido, pero al menos una de las personas que trabajan en el objeto debe tenerlo. Cada vez que adquirís este perk, el requisito de nivel aumenta en 4." },

        { id: "perk373", img: "203", source: "settlersGuide", name: "Operador encubierto", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { AGI: 8 }, reqText: "AGI 8", desc: "Cuando realizás un ataque furtivo a distancia con un arma pequeña o de energía, el daño aumenta en +2 CD. No podés obtener este beneficio mientras llevás una servoarmadura." },

        { id: "perk374", img: "204", source: "settlersGuide", name: "Ejecutor", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { AGI: 9, Nivel: 12 }, reqText: "AGI 9, Nivel 12", desc: "Cuando realizás un ataque a distancia con una escopeta y apuntás a una ubicación específica, tu ataque obtiene la cualidad Debilitante." },

        { id: "perk375", img: "205", source: "settlersGuide", name: "Pulgar verde", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { PER: 4, Nivel: 4 }, reqText: "PER 4, Nivel 4", desc: "Cuando dedicás tiempo a buscar alimento y tirás en la tabla de Recolección, obtenés 2 objetos, más 2 adicionales por cada PA gastado." },

        { id: "perk376", img: "206", source: "settlersGuide", name: "Corredor armado", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { AGI: 6, Nivel: 4 }, reqText: "AGI 6, Nivel 4", desc: "Cuando realizás la acción Esprintar mientras tenés en la mano un arma a distancia de una mano, podés gastar 1 PA para moverte una zona adicional." },

        { id: "perk377", img: "207", source: "settlersGuide", name: "Campista feliz", rank: 1, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { CHA: 7, END: 6, Nivel: 3 }, reqText: "CHA 7, END 6, Nivel 3+", desc: "Si tu estado de hambre es Saciedad completa o Saciado y estableciste un campamento con una fuente de calor, como una fogata, tu hambre no empeora." },
        { id: "perk378", img: "207", source: "settlersGuide", name: "Campista feliz", rank: 2, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { CHA: 7, END: 6, Nivel: 7 }, reqText: "CHA 7, END 6, Nivel 7+", desc: "Si tu estado de sed es Hidratado o Saciedad de líquidos y estableciste un campamento con una fuente de calor, como una fogata, tu sed no empeora. Cada vez que adquirís este perk, el requisito de nivel aumenta en 4." },

        { id: "perk379", img: "208", source: "settlersGuide", name: "Ayuda contratada", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { CHA: 7, NoCompanion: true }, reqText: "CHA 7, no tener un compañero", desc: "Podés reclutar un compañero humanoide: un PNJ aliado que sigue tus órdenes. Tu compañero puede ocuparse de su propia comida y bebida, se recupera de las heridas como un personaje jugador y puede beneficiarse de la curación. Si muere, podés reclutar otro antes de la próxima misión o cambiar este perk por otro después de la misión." },

        { id: "perk380", img: "209", source: "settlersGuide", name: "Defensa del hogar", rank: 1, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { INT: 6, Nivel: 5 }, reqText: "INT 6, Nivel 5+", desc: "Podés fabricar trampas de la sección correspondiente. Las trampas tienen complejidad 2 y requieren los componentes de un objeto de complejidad 2. Si fallás la prueba de INT + Reparación, la trampa se activa contra vos." },
        { id: "perk381", img: "209", source: "settlersGuide", name: "Defensa del hogar", rank: 2, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { INT: 6, Nivel: 10 }, reqText: "INT 6, Nivel 10+", desc: "Si fallás la prueba de INT + Reparación al colocar una trampa, esta no se activa contra vos. En cambio, tenés éxito con un coste y el DJ crea una complicación relacionada con la trampa, como que sea más fácil de detectar o cause menos daño. Cada vez que adquirís este perk, el requisito de nivel aumenta en 5." },

        { id: "perk382", img: "210", source: "settlersGuide", name: "De entrecasa", rank: 1, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { END: 6, Nivel: 5 }, reqText: "END 6, Nivel 5+", desc: "No necesitás dormir para recuperarte mientras estés en un asentamiento al que pertenecés. Cuando pasás una hora en un asentamiento al que pertenecés o que administrás, tirá una cantidad de CD igual a tu END y recuperá tantos PG como el resultado." },
        { id: "perk383", img: "210", source: "settlersGuide", name: "De entrecasa", rank: 2, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { END: 6, Nivel: 10 }, reqText: "END 6, Nivel 10+", desc: "Recuperás 1 PG adicional por cada efecto obtenido. Además, cuando hacés una prueba de END + Supervivencia para recuperarte de una herida, la dificultad se reduce a un máximo de 2. Cada vez que adquirís este perk, el requisito de nivel aumenta en 5." },

        { id: "perk384", img: "211", source: "settlersGuide", name: "Líder local", rank: 1, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { CHA: 6, Nivel: 2 }, reqText: "CHA 6, Nivel 2+", desc: "Podés establecer una línea de suministro entre dos asentamientos con los que tengas una reputación de al menos Amistosa (3). Debe haber al menos un colono disponible en uno de ellos para realizar los envíos. Los suministros y recursos disponibles pueden compartirse siempre que la Felicidad del asentamiento receptor sea mayor que su número de habitantes." },
        { id: "perk385", img: "211", source: "settlersGuide", name: "Líder local", rank: 2, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { CHA: 6, Nivel: 7 }, reqText: "CHA 6, Nivel 7+", desc: "Podés solicitar la construcción de diversos comercios y mesas de fabricación en un asentamiento. Este rango permite incorporar tiendas comerciales, de ropa, armaduras y armas; establecimientos de bebidas y médicos; y bancos de trabajo de armaduras, química, cocina, servoarmaduras, armas y robots. Cada vez que adquirís este perk, el requisito de nivel aumenta en 5." },

        { id: "perk386", img: "212", source: "settlersGuide", name: "Cargá y recargá", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { STR: 7, Nivel: 2 }, reqText: "STR 7, Nivel 2+", desc: "Cuando atacás con un arma pesada que tenga una cadencia de fuego superior a 0, su cadencia aumenta en 1 por cada rango de este perk." },
        { id: "perk387", img: "212", source: "settlersGuide", name: "Cargá y recargá", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { STR: 7, Nivel: 6 }, reqText: "STR 7, Nivel 6+", desc: "Cuando atacás con un arma pesada que tenga una cadencia de fuego superior a 0, su cadencia aumenta en 2 por los rangos de este perk." },
        { id: "perk388", img: "212", source: "settlersGuide", name: "Cargá y recargá", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { STR: 7, Nivel: 10 }, reqText: "STR 7, Nivel 10+", desc: "Cuando atacás con un arma pesada que tenga una cadencia de fuego superior a 0, su cadencia aumenta en 3 por los rangos de este perk. Cada vez que adquirís este perk, el requisito de nivel aumenta en 4." },

        { id: "perk389", img: "213", source: "settlersGuide", name: "Amenaza mecánica / Bicho raro", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { CHA: 6, INT: 5 }, reqText: "CHA 6, INT 5", desc: "Amenaza mecánica afecta a los robots, mientras que Bicho raro afecta a los humanos mutados; por lo demás, son idénticos. Cuando un PNJ criatura con la palabra clave correspondiente fuera a atacarte, tirá 1 CD. Si no obtenés un efecto, la criatura decide no atacarte, aunque puede atacar a otro personaje. Además, podés repetir 1d20 al realizar una prueba de habilidad basada en CHA para influir en un personaje con esa palabra clave." },

        { id: "perk390", img: "214", source: "settlersGuide", name: "Resistencia nocturna", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { END: 6, Nivel: 12, NoRobot: true }, reqText: "END 6, Nivel 12, no ser un robot", desc: "Durante la noche, tus PG máximos aumentan en una cantidad igual a tu END. Cuando aumenta tu máximo, obtenés esa misma cantidad de PG actuales adicionales. Al terminar el efecto, tu máximo vuelve a la normalidad; tus PG actuales no cambian salvo que superen el máximo, en cuyo caso se reducen hasta él." },

        { id: "perk391", img: "215", source: "settlersGuide", name: "Pannapictagrafista", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { LCK: 5 }, reqText: "LCK 5", desc: "Cuando tirás aleatoriamente para obtener una revista en las tablas de Publicaciones aleatorias o Números, podés repetir el resultado si la revista o el número obtenido es uno que ya encontraste." },

        { id: "perk392", img: "216", source: "settlersGuide", name: "Farmacéutico", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { INT: 8, Nivel: 2 }, reqText: "INT 8, Nivel 2+", desc: "El RadAway que administrás cura 2 puntos adicionales de daño por radiación." },
        { id: "perk393", img: "216", source: "settlersGuide", name: "Farmacéutico", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { INT: 8, Nivel: 8 }, reqText: "INT 8, Nivel 8+", desc: "El RadAway que administrás cura 3 puntos adicionales de daño por radiación. Cada vez que adquirís este perk, el requisito de nivel aumenta en 6." },
        { id: "perk394", img: "216", source: "settlersGuide", name: "Farmacéutico", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { INT: 8, Nivel: 14 }, reqText: "INT 8, Nivel 14+", desc: "El RadAway que administrás cura 4 puntos adicionales de daño por radiación. Cada vez que adquirís este perk, el requisito de nivel aumenta en 6." },

        { id: "perk395", img: "217", source: "settlersGuide", name: "Fotosintético", rank: 1, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { END: 7, Nivel: 5 }, reqText: "END 7, Nivel 5+", desc: "Cuando estás bajo la luz solar directa, regenerás 1 PG por hora." },
        { id: "perk396", img: "217", source: "settlersGuide", name: "Fotosintético", rank: 2, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { END: 7, Nivel: 15 }, reqText: "END 7, Nivel 15+", desc: "Cuando estás bajo la luz solar directa, regenerás 2 PG por hora. Cada vez que adquirís este perk, el requisito de nivel aumenta en 10." },

        { id: "perk397", img: "218", source: "settlersGuide", name: "Curandero trucho", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { CHA: 7, Nivel: 12 }, reqText: "CHA 7, Nivel 12+", desc: "Cuando realizás una acción de Primeros auxilios sobre un aliado, podés usar una bebida alcohólica en el paciente como parte de la acción. El paciente recupera PG adicionales iguales a los que normalmente cura la bebida, si corresponde, y podés curar 2 PG por cada PA gastado. El aliado también recibe los beneficios y las desventajas de consumir la bebida." },

        { id: "perk398", img: "219", source: "settlersGuide", name: "Rejuvenecido", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { END: 7, Nivel: 12, NoRobot: true }, reqText: "END 7, Nivel 12+, no ser un robot", desc: "Cuando estás saciado por completo, tus PG máximos aumentan en 2, podés repetir 1d20 en todas las pruebas de habilidad basadas en STR y ese estado dura el doble. Cuando tu sed está completamente saciada, podés repetir 1d20 en todas las pruebas de habilidad basadas en END, generás 1 PA gratuito al comienzo de cada turno de combate y ese estado dura el doble." },

        { id: "perk399", img: "220", source: "settlersGuide", name: "Retribución", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { END: 8, LCK: 8, Nivel: 2 }, reqText: "END 8, LCK 8, Nivel 2+", desc: "Si tu Reducción de Daño (DR) evita que recibas daño de un ataque, recuperás 1 PG y agregás 1 PA al fondo del grupo. Este efecto puede activarse una vez por ronda de combate por cada rango que tengas en este perk." },
        { id: "perk400", img: "220", source: "settlersGuide", name: "Retribución", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { END: 8, LCK: 8, Nivel: 7 }, reqText: "END 8, LCK 8, Nivel 7+", desc: "Si tu Reducción de Daño (DR) evita que recibas daño de un ataque, recuperás 1 PG y agregás 1 PA al fondo del grupo. Este efecto puede activarse dos veces por ronda de combate. Cada vez que adquirís este perk, el requisito de nivel aumenta en 5." },
        { id: "perk401", img: "220", source: "settlersGuide", name: "Retribución", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { END: 8, LCK: 8, Nivel: 12 }, reqText: "END 8, LCK 8, Nivel 12+", desc: "Si tu Reducción de Daño (DR) evita que recibas daño de un ataque, recuperás 1 PG y agregás 1 PA al fondo del grupo. Este efecto puede activarse tres veces por ronda de combate. Cada vez que adquirís este perk, el requisito de nivel aumenta en 5." },

        { id: "perk402", img: "221", source: "settlersGuide", name: "Domador de robots", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { INT: 5, NoCompanion: true }, reqText: "INT 5, no tener un compañero", desc: "Obtenés un compañero robot que te acompaña como amigo y aliado en los peligros del Yermo. Es un PNJ aliado que sigue tus órdenes. No puede recuperarse de heridas ni recuperar PG sin reparaciones, pero no necesita comida ni bebidas y no obtiene beneficios de consumirlas o usar drogas. Si tu robot es destruido, podés repararlo o encontrar o comprar otro antes de la próxima aventura; también podés cambiar este perk por otro después de la misión." },

        { id: "perk403", img: "222", source: "settlersGuide", name: "Maniobras de escuadrón", rank: 1, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { CHA: 7 }, reqText: "CHA 7", desc: "Cuando viajás por el Yermo a paso acelerado, podés mantener ese ritmo durante una hora adicional si superás una prueba de CHA + Supervivencia de dificultad 1. Podés mantenerlo una hora más gastando 2 PA, hasta un máximo de 3 horas a paso acelerado." },
        { id: "perk404", img: "222", source: "settlersGuide", name: "Maniobras de escuadrón", rank: 2, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { CHA: 7 }, reqText: "CHA 7", desc: "Podés coordinar a tus aliados en combate. Cuando gastás 1 PA para realizar una acción menor adicional de Movimiento, podés mover a un aliado que esté en la zona donde terminás tu movimiento hasta que quede a alcance de vos, gastando otro PA." },

        { id: "perk405", img: "223", source: "settlersGuide", name: "Superduplicador", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { LCK: 6, Nivel: 3 }, reqText: "LCK 6, Nivel 3+", desc: "Cada vez que fabricás un objeto, tirá 1 CD. Si obtenés algún efecto, recuperás la mitad de los componentes utilizados, redondeando hacia abajo. Calculá por separado cada rareza de componente." },
        { id: "perk406", img: "223", source: "settlersGuide", name: "Superduplicador", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { LCK: 6, Nivel: 7 }, reqText: "LCK 6, Nivel 7+", desc: "Cada vez que fabricás un objeto, tirá 2 CD. Si obtenés algún efecto, recuperás la mitad de los componentes utilizados, redondeando hacia abajo y calculando por separado cada rareza." },
        { id: "perk407", img: "223", source: "settlersGuide", name: "Superduplicador", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { LCK: 6, Nivel: 11 }, reqText: "LCK 6, Nivel 11+", desc: "Cada vez que fabricás un objeto, tirá 3 CD. Si obtenés algún efecto, recuperás la mitad de los componentes utilizados, redondeando hacia abajo y calculando por separado cada rareza. Cada vez que adquirís este perk, el requisito de nivel aumenta en 4." },

        { id: "perk408", img: "224", source: "settlersGuide", name: "Poniendo el cuerpo", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { END: 7, CHA: 6, Nivel: 1 }, reqText: "END 7, CHA 6, Nivel 1+", desc: "Cuando un PNJ criatura fuera a tirar para dañar a un aliado que esté en tu misma zona, tirá 1 CD. Si no obtenés un efecto, recibís vos el daño del ataque en su lugar. Este efecto puede activarse una vez por ronda de combate por cada rango que tengas en este perk." },
        { id: "perk409", img: "224", source: "settlersGuide", name: "Poniendo el cuerpo", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { END: 7, CHA: 6, Nivel: 5 }, reqText: "END 7, CHA 6, Nivel 5+", desc: "Cuando recibís daño del ataque después de aplicar la reducción de daño, agregá 1 PA al fondo por cada rango que tengas en este perk." },
