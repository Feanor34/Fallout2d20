        { id: "perk283", img: "156", source: "wanderersGuide", name: "Tiro certero", rank: 1, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { PER: 7, Nivel: 7 }, reqText: "PER 7, Nivel 7+", desc: "Cuando realizás un ataque a distancia con un arma de una mano y apuntaste antes de atacar, aumentá su alcance un paso: de Corto a Medio o de Medio a Largo." },
