        { id: "perk285", img: "157", source: "wanderersGuide", name: "Granada al hoyo", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { PER: 8, Nivel: 8 }, reqText: "PER 8, Nivel 8+", desc: "Cuando realizás un ataque a distancia con un arma arrojadiza que tenga la cualidad Explosión, la dificultad base del ataque es 1 en lugar de 2." },

