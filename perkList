        { id: "perk154", img: "085", source:"coreBook" , name: "Asesino", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { FUE: 8 }, reqText: "FUE 8", desc: "Cuando infligís cualquier cantidad de daño con un ataque desarmado o un arma cuerpo a cuerpo, podés gastar 1 Punto de Suerte para infligir inmediatamente un golpe crítico —y, por lo tanto, una herida— en la ubicación impactada." },

        { id: "perk155", img: "086", source:"coreBook" , name: "Conversador Suave", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { CAR: 6 }, reqText: "CAR 6", desc: "Cuando realizás una prueba de Trueque o Hablar como parte de una prueba enfrentada, podés volver a tirar 1d20." },

        { id: "perk156", img: "087", source:"coreBook" , name: "Come Serpientes", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { END: 7 }, reqText: "END 7", desc: "Tu Resistencia al Daño por veneno aumenta en +2.", system: [extraPoisonDR: "2"] },

        { id: "perk157", img: "088", source:"coreBook" , name: "Francotirador", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { PER: 8, AGI: 6 }, reqText: "PER 8, AGI 6", desc: "Cuando realizás la acción menor Apuntar y luego realizás un ataque a distancia con un arma de dos manos que tenga la propiedad Precisa, podés especificar una ubicación para impactar sin aumentar la dificultad del ataque." },

        { id: "perk158", img: "089", source:"coreBook" , name: "Alimentado por el Sol", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { END: 7 }, reqText: "END 7", desc: "Por cada hora que pasás bajo la luz solar directa, curás 1 punto de daño por radiación." },

        { id: "perk159", img: "090", source:"coreBook" , name: "Puntería Estable", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { FUE: 8, AGI: 7 }, reqText: "FUE 8, AGI 7", desc: "Cuando realizás la acción menor Apuntar, podés volver a tirar 2d20 en el primer ataque que realices durante este turno, o volver a tirar 1d20 en todos los ataques que realices durante este turno." },

        { id: "perk160", img: "091", source:"coreBook" , name: "Espalda Fuerte", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { FUE: 5, Nivel: 1 }, reqText: "FUE 5, Nivel 1+", desc: "Tu peso de carga máximo aumenta en +25 lb.", system: [extraCarryWeight: 25] },
        { id: "perk161", img: "091", source:"coreBook" , name: "Espalda Fuerte", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { FUE: 5, Nivel: 3 }, reqText: "FUE 5, Nivel 3+", desc: "Tu peso de carga máximo aumenta en +50 lb.", system: [extraCarryWeight: 50] },
        { id: "perk162", img: "091", source:"coreBook" , name: "Espalda Fuerte", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { FUE: 5, Nivel: 5 }, reqText: "FUE 5, Nivel 5+", desc: "Tu peso de carga máximo aumenta en +75 lb.", system: [extraCarryWeight: 75] },

        { id: "perk163", img: "092", source:"coreBook" , name: "¡TAG!", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { Nivel: 5 }, reqText: "Nivel 5+", desc: "Podés seleccionar una Habilidad Etiquetada adicional. Aumentá el rango de la habilidad en 2, hasta un máximo de 6, y marcala como Habilidad Etiquetada, permitiéndote obtener un éxito crítico con un resultado de d20 igual o inferior al rango de la habilidad.", system: [extraTag: 1] },

        { id: "perk164", img: "093", source:"coreBook" , name: "Presencia Aterradora", rank: 1, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { FUE: 6, CAR: 8, Nivel: 3 }, reqText: "FUE 6, CAR 8, Nivel 3+", desc: "Cuando realizás una prueba de Hablar para amenazar o asustar a alguien, podés volver a tirar 1d20." },
        { id: "perk165", img: "093", source:"coreBook" , name: "Presencia Aterradora", rank: 2, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { FUE: 6, CAR: 8, Nivel: 8 }, reqText: "FUE 6, CAR 8, Nivel 8+", desc: "Podés utilizar una acción mayor durante el combate para amenazar a un enemigo a alcance Medio, utilizando una prueba de FUE + Hablar con una dificultad de 2. Si tenés éxito, ese enemigo debe alejarse de vos durante su próximo turno (aunque puede realizar cualquier otra acción que desee)." },

        { id: "perk166", img: "094", source:"coreBook" , name: "Dureza", rank: 1, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { END: 6, LCK: 6, Nivel: 1 }, reqText: "END 6, LCK 6, Nivel 1+", desc: "Tu Resistencia al Daño físico en todas las ubicaciones impactadas aumenta en +1.", system: [extraPhysDR: 1] },
        { id: "perk167", img: "094", source:"coreBook" , name: "Dureza", rank: 2, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { END: 6, LCK: 6, Nivel: 5 }, reqText: "END 6, LCK 6, Nivel 5+", desc: "Tu Resistencia al Daño físico en todas las ubicaciones impactadas aumenta en +2.", system: [extraPhysDR: 2] },

        { id: "perk168", img: "095", source:"homebrew" , name: "La Cadena que nos Une a Todos", rank: 1, ranks: 2, perkRequired: ["brotherhood"], perkExclusive: [], reqs: { Nivel: 3 }, reqText: "Iniciado de la Hermandad o No Humano, Nivel 3+", desc: "Cada vez que adquirís este Perk, elegí una rama de servicio apropiada de la Hermandad de la lista de Iniciado de la Hermandad. Estableciste contactos y conexiones con esa rama, y obtenés la capacidad de gastar 2 AP para solicitar refuerzos de esa rama una vez por aventura.\n\nSi todavía no estabas sujeto a la Cadena que nos Une, ahora lo estás. No necesitás tener el origen Iniciado de la Hermandad para adquirir este Perk; solo necesitás ser miembro de la Hermandad, incluso si no sos humano. El hecho de que tengas que adquirir un Perk para obtener acceso a los refuerzos no representa que la Hermandad del Medio Oeste sea lenta a la hora de aceptar no humanos, sino que refleja el hecho de que ya obtuviste un Origen que te dio cosas geniales. Un no humano incluso podría unirse a una rama de Mariposa si demostró ser tan competente que la Hermandad no puede darse el lujo de rechazar su ayuda." },
        { id: "perk169", img: "095", source:"homebrew" , name: "La Cadena que nos Une a Todos", rank: 2, ranks: 2, perkRequired: ["brotherhood"], perkExclusive: [], reqs: { Nivel: 6 }, reqText: "Iniciado de la Hermandad o No Humano, Nivel 6+", desc: "Cada vez que adquirís este Perk, elegí una rama de servicio apropiada de la Hermandad de la lista de Iniciado de la Hermandad. Estableciste contactos y conexiones con esa rama, y obtenés la capacidad de gastar 2 AP para solicitar refuerzos de esa rama una vez por aventura.\n\nSi todavía no estabas sujeto a la Cadena que nos Une, ahora lo estás. No necesitás tener el origen Iniciado de la Hermandad para adquirir este Perk; solo necesitás ser miembro de la Hermandad, incluso si no sos humano. El hecho de que tengas que adquirir un Perk para obtener acceso a los refuerzos no representa que la Hermandad del Medio Oeste sea lenta a la hora de aceptar no humanos, sino que refleja el hecho de que ya obtuviste un Origen que te dio cosas geniales. Un no humano incluso podría unirse a una rama de Mariposa si demostró ser tan competente que la Hermandad no puede darse el lujo de rechazar su ayuda." },

        { id: "perk170", img: "096", source:"homebrew" , name: "Visionario", rank: 1, ranks: 2, perkRequired: ["tribal"], perkExclusive: [], reqs: { CAR: 6, LCK: 7, Nivel: 2 }, reqText: "Tribal, CAR 6+, LCK 7+, Nivel 2+", desc: "Como chamán, podés buscar la guía y sabiduría del mundo espiritual, emprendiendo una búsqueda de visión para prepararte a vos y a tus aliados para el desafío que tienen por delante.\n\nCon una dosis de Vudú, Punga u otro psicodélico apropiado, vos y hasta otras nueve personas pueden emprender una búsqueda de visión una vez por aventura. No existe riesgo de adicción; sabés cómo administrar correctamente la droga con fines religiosos, incluso a Ghouls, Supermutantes y Deathclaws. Esta búsqueda de visión los asaltará a todos con cuatro horas de alucinaciones que parecen reflejar el futuro, el pasado y sus miedos más oscuros. Recuerdos, enemigos, presagios y Muñecos de Vault-Tec los asaltarán a todos. El GM puede elegir describir las visiones, hacer que cada jugador dé un breve resumen de lo que ve o simplemente dejarlo a su imaginación.\n\nNo se necesitan pruebas de habilidad para este proceso; ya sea que superen estas amenazas o simplemente tengan un viaje muy, muy malo, los ecos del futuro los han preparado para lo que está por venir. Durante los próximos dos días, el chamán puede elegir gastar sus Puntos de Suerte para que otros participantes utilicen la capacidad Mazo Marcado, y estos utilizarán el LCK del chamán en lugar del suyo cuando lo haga.\n\nCada vez que adquirís este Perk, el Nivel requerido aumenta en 5." },
        { id: "perk171", img: "096", source:"homebrew" , name: "Visionario", rank: 2, ranks: 2, perkRequired: ["tribal"], perkExclusive: [], reqs: { CAR: 6, LCK: 7, Nivel: 7 }, reqText: "Tribal, CAR 6+, LCK 7+, Nivel 7+", desc: "Como chamán, podés buscar la guía y sabiduría del mundo espiritual, emprendiendo una búsqueda de visión para prepararte a vos y a tus aliados para el desafío que tienen por delante.\n\nCon una dosis de Vudú, Punga u otro psicodélico apropiado, vos y hasta otras nueve personas pueden emprender una búsqueda de visión una vez por aventura. No existe riesgo de adicción; sabés cómo administrar correctamente la droga con fines religiosos, incluso a Ghouls, Supermutantes y Deathclaws. Esta búsqueda de visión los asaltará a todos con cuatro horas de alucinaciones que parecen reflejar el futuro, el pasado y sus miedos más oscuros. Recuerdos, enemigos, presagios y Muñecos de Vault-Tec los asaltarán a todos. El GM puede elegir describir las visiones, hacer que cada jugador dé un breve resumen de lo que ve o simplemente dejarlo a su imaginación.\n\nNo se necesitan pruebas de habilidad para este proceso; ya sea que superen estas amenazas o simplemente tengan un viaje muy, muy malo, los ecos del futuro los han preparado para lo que está por venir. Durante los próximos dos días, el chamán puede elegir gastar sus Puntos de Suerte para que otros participantes utilicen la capacidad Mazo Marcado, y estos utilizarán el LCK del chamán en lugar del suyo cuando lo haga.\n\nEn Rango 2, el beneficio de la búsqueda de visión dura durante toda la aventura, en lugar de solo un par de días.\n\nCada vez que adquirís este Perk, el Nivel requerido aumenta en 5." },

        { id: "perk172", img: "097", source:"homebrew" , name: "Operaciones Encubiertas", rank: 1, ranks: 2, perkRequired: ["nightkin"], perkExclusive: [], reqs: {}, reqText: "Rasgo Elegido del Maestro", desc: "Tu uso extensivo de los Stealth Boys ha vuelto sus efectos más potentes. Siempre que utilizás un Stealth Boy, sus efectos duran el doble de lo normal, hasta un máximo de 4 veces la duración normal. Cada vez que adquirís este Perk, el límite de nivel aumenta en 4." },
        { id: "perk173", img: "097", source:"homebrew" , name: "Operaciones Encubiertas", rank: 2, ranks: 2, perkRequired: ["nightkin"], perkExclusive: [], reqs: {}, reqText: "Rasgo Elegido del Maestro", desc: "Tu uso extensivo de los Stealth Boys ha vuelto sus efectos más potentes. Siempre que utilizás un Stealth Boy, sus efectos duran el doble de lo normal, hasta un máximo de 4 veces la duración normal. Cada vez que adquirís este Perk, el límite de nivel aumenta en 4." },

        { id: "perk174", img: "098", source:"homebrew" , name: "Presencia Alarmante", rank: 1, ranks: 2, perkRequired: ["deathclaw"], perkExclusive: [], reqs: { FUE: 7, CAR: 4, Nivel: 3 }, reqText: "FUE 7, CAR 4, Deathclaw, Nivel 3+", desc: "Este Perk funciona igual que el Perk Presencia Aterradora del Manual Básico. Cada vez que adquirís este Perk, el requisito de Nivel aumenta en 3." },
        { id: "perk175", img: "098", source:"homebrew" , name: "Presencia Alarmante", rank: 2, ranks: 2, perkRequired: ["deathclaw"], perkExclusive: [], reqs: { FUE: 7, CAR: 4, Nivel: 6 }, reqText: "FUE 7, CAR 4, Deathclaw, Nivel 6+", desc: "Este Perk funciona igual que el Perk Presencia Aterradora del Manual Básico. Cada vez que adquirís este Perk, el requisito de Nivel aumenta en 3." },

        { id: "perk176", img: "099", source:"homebrew" , name: "Alfa/Matriarca", rank: 1, ranks: 1, perkRequired: ["deathclaw"], perkExclusive: [], reqs: { FUE: 11, RES: 11, Nivel: 8 }, reqText: "FUE 11+, RES 11+, Deathclaw, Nivel 8+", desc: "Te convertiste verdaderamente en un depredador alfa. Ahora solo sufrís un Golpe Crítico si un ataque inflige 7 o mas de daño (después de la Resistencia al Daño) en un solo impacto, en lugar del 5 o mas normal. Esto se acumula con el Perk Esqueleto de Adamantio. Además, ahora obtenés +3 de Salud por nivel en lugar de +1.\n\nAdemás, tanto los Deathclaws Inteligentes como los No Inteligentes te considerarán un igual digno de respeto. No te atacarán activamente a vos ni a tus aliados a menos que los ataques primero.", system: [extraHPPerLevel: "2"]},

        { id: "perk177", img: "100", source:"homebrew" , name: "Camaleón", rank: 1, ranks: 1, perkRequired: ["deathclaw"], perkExclusive: [], reqs: { Nivel: 1 }, reqText: "Deathclaw, Nivel 1+", desc: "Tu piel es capaz de mostrar colores vibrantes según tu estado de ánimo y actividad. Como acción gratuita, podés cambiar el color de tu piel." },

        { id: "perk178", img: "101", source:"homebrew" , name: "Resplandeciente", rank: 1, ranks: 3, perkRequired: ["deathclaw"], perkExclusive: ["perk181"], reqs: { RES: 10, Nivel: 5 }, reqText: "RES 10, Deathclaw, Sin Rangos en Quantum'd, Nivel 5+", desc: "La exposición a niveles extremos de radiación hizo que brilles de color verde en la oscuridad. Además de proporcionar luz dentro a Alcance Cercano, infligís 2 Dados de Combate de daño de Radiación a cualquiera (incluidos aliados) que se encuentre a tu Alcance, y tus ataques Desarmado obtienen el efecto de daño Radiactivo.", system: [ { damageEffect: "Radiation 1" , condition: {weapontype: "unarmed"}} ] },
        { id: "perk179", img: "101", source:"homebrew" , name: "Resplandeciente", rank: 2, ranks: 3, perkRequired: ["deathclaw"], perkExclusive: ["perk181"], reqs: { RES: 10, Nivel: 10 }, reqText: "RES 10, Deathclaw, Sin Rangos en Quantum'd, Nivel 10+", desc: "La exposición a niveles extremos de radiación hizo que brilles de color verde en la oscuridad. Además de proporcionar luz dentro de Alcance Cercano, infligís 2 Dados de Combate de daño de Radiación a cualquiera (incluidos aliados) que se encuentre a tu Alcance, y tus ataques Desarmado obtienen el efecto de daño Radiactivo 2 por efecto.", system: [ { damageEffect: "Radiation 2" , condition: {weapontype: "unarmed"}} ] },
        { id: "perk180", img: "101", source:"homebrew" , name: "Resplandeciente", rank: 3, ranks: 3, perkRequired: ["deathclaw"], perkExclusive: ["perk181"], reqs: { RES: 10, Nivel: 15 }, reqText: "RES 10, Deathclaw, Sin Rangos en Quantum'd, Nivel 15+", desc: "La exposición a niveles extremos de radiación hizo que brilles de color verde en la oscuridad. Además de proporcionar luz dentro de Alcance Cercano, infligís 2 Dados de Combate de daño de Radiación a cualquiera (incluidos aliados) que se encuentre a tu Alcance, y tus ataques Desarmado obtienen el efecto de daño Radiactivo 3 por efecto.", system: [ { damageEffect: "Radiation 3" , condition: {weapontype: "unarmed"}} ] },

        { id: "perk181", img: "102", source:"homebrew" , name: "Garras Ágiles", rank: 1, ranks: 1, perkRequired: ["deathclaw"], perkExclusive: [], reqs: { AGI: 7, Nivel: 3 }, reqText: "AGI 7, Deathclaw, Nivel 3+", desc: "Después de muchas horas de práctica, sos capaz de manipular tus garras con la precisión suficiente como para aproximarte al rango de movimiento de las manos humanas normales.\n\nSi sos una variante Bruto, ahora podés realizar tareas que requieren control motor fino (como utilizar una computadora), además de comenzar a adquirir rangos en las habilidades Cerrajería, Medicina, Pilotear, Reparación y Ciencia. Sin embargo, el rango de Complicación para estas habilidades aumenta en 2 (18-20).\n\nSi sos una variante Cerebro, el aumento de tu rango de Complicación se elimina por completo." },

        { id: "perk182", img: "103", source:"homebrew" , name: "Quantum'd", rank: 1, ranks: 1, perkRequired: ["deathclaw"], perkExclusive: ["perl178"], reqs: { RES: 8, Nivel: 5 }, reqText: "RES 8, Deathclaw, Sin Rangos en Resplandeciente, Nivel 5+", desc: "Al igual que con el Perk Resplandeciente, el consumo y/o la exposición a grandes cantidades de Nuka Cola Quantum hizo que brilles de color azul en la oscuridad. Además de proporcionar luz dentro de Alcance Cercano, ahora sos inmune al Veneno y podés tirar un Dado de Combate menos al determinar si te volvés adicto a los químicos, hasta un mínimo de 0. Si la adquirís teniendo un Rango en el Perk Resistente a los Químicos, te volvés inmune a la adicción." },

        { id: "perk183", img: "104", source:"homebrew" , name: "Golpe Desgarrador", rank: 1, ranks: 1, perkRequired: ["deathclaw"], perkExclusive: [], reqs: { FUE: 10, Nivel: 2 }, reqText: "FUE 10, Deathclaw, Nivel 2+", desc: "Sos capaz de asestar un golpe letal con mayor facilidad utilizando tus garras. Podés aumentar en +1 la Dificultad de un ataque Desarmado. Si tiene éxito, el daño del ataque aumenta en +2." },

        { id: "perk184", img: "105", source:"homebrew" , name: "Disciplina de Ranger", rank: 1, ranks: 2, perkRequired: ["NCR"], perkExclusive: [], reqs: { Nivel: 5 }, reqText: "Rasgo La Fuerza del Oso, Nivel 5+", desc: "Completaste con éxito tu entrenamiento de Ranger y te uniste a los Mejores de la RNC. Obtenés una habilidad etiquetada (Tag) adicional de la siguiente lista: Armas Pequeñas, Armas Grandes, Armas de Energía, Desarmado, Cuerpo a Cuerpo, Explosivos, Supervivencia, Hablar o Sigilo. Además, tu posición inspira respeto entre los soldados normales de la RNC, quienes pueden ayudarte en combate si están cerca. Sin embargo, esto tiene el efecto contrario: los enemigos de la RNC tienen muchas más probabilidades de apuntar hacia vos que antes y pueden enviar a algunos de sus mejores combatientes para enfrentarte. Este Perk no puede adquirirse al subir de nivel. Debe ser otorgada por el GM, ya sea al alcanzar ciertos hitos dentro del juego o durante la creación del personaje en niveles superiores." },
        { id: "perk185", img: "105", source:"homebrew" , name: "Disciplina de Ranger", rank: 2, ranks: 2, perkRequired: ["NCR"], perkExclusive: [], reqs: { Nivel: 10 }, reqText: "Rasgo La Fuerza del Oso, Nivel 10+", desc: "Superaste a los demás miembros del Cuerpo de Rangers y te convertiste en uno de los enemigos más formidables del Yermo. Tu sola presencia infunde miedo en el corazón de muchos y tu entrenamiento no tiene igual. Al realizar una tirada para intimidar a alguien, podés tirar 1d20 adicional. Además, podés repetir una cantidad de dados igual a 5+RES por encuentro de combate. También obtenés una habilidad etiquetada (Tag) adicional de la lista anterior y la dificultad de todas las pruebas realizadas para rastrear a un objetivo se reduce permanentemente en 1." },

        { id: "perk186", img: "106", source:"homebrew" , name: "Médico de Combate", rank: 1, ranks: 1, perkRequired: ["NCR"], perkExclusive: [], reqs: {}, reqText: "Rasgo La Fuerza del Oso, Rama Médica", desc: "Recibiste entrenamiento para administrar primeros auxilios de manera efectiva y rápida durante el combate y otras situaciones peligrosas. Podés utilizar Primeros Auxilios como una Acción Menor en lugar de una Acción Mayor. Además, una vez por aventura podés reducir en 1 la dificultad de tratar una lesión, hasta un mínimo de 0." },

        { id: "perk187", img: "107", source:"homebrew" , name: "Imperialista Despectivo", rank: 1, ranks: 3, perkRequired: ["NCR"], perkExclusive: [], reqs: {}, reqText: "Rasgo La Fuerza del Oso", desc: "No tenés demasiada simpatía por los saqueadores, drogadictos o tribales que intentan \"establecerse\" o \"sobrevivir\" en tierras civilizadas. Obtenés 1 Dado de Combate adicional para los ataques dirigidos contra tribales, saqueadores o adictos a los químicos. Cada vez que adquirís este Perk, el límite de nivel aumenta en 5." },
        { id: "perk188", img: "107", source:"homebrew" , name: "Imperialista Despectivo", rank: 2, ranks: 3, perkRequired: ["NCR"], perkExclusive: [], reqs: {}, reqText: "Rasgo La Fuerza del Oso", desc: "No tenés demasiada simpatía por los saqueadores, drogadictos o tribales que intentan \"establecerse\" o \"sobrevivir\" en tierras civilizadas. Obtenés 2 Dado de Combate adicional para los ataques dirigidos contra tribales, saqueadores o adictos a los químicos. Cada vez que adquirís este Perk, el límite de nivel aumenta en 5." },
        { id: "perk189", img: "107", source:"homebrew" , name: "Imperialista Despectivo", rank: 3, ranks: 3, perkRequired: ["NCR"], perkExclusive: [], reqs: {}, reqText: "Rasgo La Fuerza del Oso", desc: "No tenés demasiada simpatía por los saqueadores, drogadictos o tribales que intentan \"establecerse\" o \"sobrevivir\" en tierras civilizadas. Obtenés 3 Dado de Combate adicional para los ataques dirigidos contra tribales, saqueadores o adictos a los químicos. Cada vez que adquirís este Perk, el límite de nivel aumenta en 5." },

        { id: "perk190", img: "108", source:"homebrew" , name: "No Nos Iremos en Silencio", rank: 2, ranks: 3, perkRequired: ["NCR"], perkExclusive: [], reqs: {}, reqText: "Rasgo La Fuerza del Oso", desc: "A medida que la Legión se adentra lentamente en el territorio de tu patria, no vas a caer sin dar pelea. Obtenés 1 Dado de Combate para los ataques dirigidos contra cualquier miembro de la Legión de César. Cada vez que adquirís este Perk, el límite de nivel aumenta en 5." },
        { id: "perk191", img: "108", source:"homebrew" , name: "No Nos Iremos en Silencio", rank: 2, ranks: 3, perkRequired: ["NCR"], perkExclusive: [], reqs: {}, reqText: "Rasgo La Fuerza del Oso", desc: "A medida que la Legión se adentra lentamente en el territorio de tu patria, no vas a caer sin dar pelea. Obtenés 2 Dado de Combate para los ataques dirigidos contra cualquier miembro de la Legión de César. Cada vez que adquirís este Perk, el límite de nivel aumenta en 5." },
        { id: "perk192", img: "108", source:"homebrew" , name: "No Nos Iremos en Silencio", rank: 3, ranks: 3, perkRequired: ["NCR"], perkExclusive: [], reqs: {}, reqText: "Rasgo La Fuerza del Oso", desc: "A medida que la Legión se adentra lentamente en el territorio de tu patria, no vas a caer sin dar pelea. Obtenés 3 Dados de Combate para los ataques dirigidos contra cualquier miembro de la Legión de César." },

        { id: "perk193", img: "109", source:"homebrew" , name: "Superviviente Entrenado", rank: 1, ranks: 3, perkRequired: ["NCR"], perkExclusive: [], reqs: {}, reqText: "Rasgo La Fuerza del Oso, Rama Explorador", desc: "Tu entrenamiento como explorador te dio amplios conocimientos sobre cómo sobrevivir en las implacables tierras salvajes del Yermo. Por cada rango de este Perk que adquirís, cuando realizás una prueba de Supervivencia para recolectar/buscar comida y agua limpia, rastrear a una criatura o humanoide, o buscar refugio, podés tirar 1d20 adicional para la prueba. Por cada rango de este Perk que adquirís, el límite de nivel aumenta en 5." },
        { id: "perk194", img: "109", source:"homebrew" , name: "Superviviente Entrenado", rank: 1, ranks: 3, perkRequired: ["NCR"], perkExclusive: [], reqs: {}, reqText: "Rasgo La Fuerza del Oso, Rama Explorador", desc: "Tu entrenamiento como explorador te dio amplios conocimientos sobre cómo sobrevivir en las implacables tierras salvajes del Yermo. Por cada rango de este Perk que adquirís, cuando realizás una prueba de Supervivencia para recolectar/buscar comida y agua limpia, rastrear a una criatura o humanoide, o buscar refugio, podés tirar 2d20 adicional para la prueba. Por cada rango de este Perk que adquirís, el límite de nivel aumenta en 5." },
        { id: "perk195", img: "109", source:"homebrew" , name: "Superviviente Entrenado", rank: 1, ranks: 3, perkRequired: ["NCR"], perkExclusive: [], reqs: {}, reqText: "Rasgo La Fuerza del Oso, Rama Explorador", desc: "Tu entrenamiento como explorador te dio amplios conocimientos sobre cómo sobrevivir en las implacables tierras salvajes del Yermo. Por cada rango de este Perk que adquirís, cuando realizás una prueba de Supervivencia para recolectar/buscar comida y agua limpia, rastrear a una criatura o humanoide, o buscar refugio, podés tirar 3d20 adicional para la prueba. Por cada rango de este Perk que adquirís, el límite de nivel aumenta en 5." },

        { id: "perk196", img: "110", source:"homebrew" , name: "Reclutamiento No Convencional", rank: 1, ranks: 1, perkRequired: ["NCR", "mutant"], perkExclusive: [], reqs: {}, reqText: "Rasgo Post-Humano Necrótico o Evolución Forzada", desc: "A pesar de ser extremadamente raro, te permitieron unirte a las filas del ejército de la RNC. Esto no evita que algunos sigan teniendo prejuicios hacia vos, solamente significa que la organización no está en contra. Aun así, es difícil ascender de rango debido a los prejuicios de quienes te rodean. Tus ascensos siempre son más difíciles." },

        { id: "perk197", img: "111", source:"homebrew" , name: "¡Bendito Sea el Radio!", rank: 1, ranks: 2, perkRequired: ["atomite"], perkExclusive: [], reqs: { END: 7, Nivel: 3 }, reqText: "Rasgo El Resplandor de Atom, RES 7, Nivel 3+", desc: "Tu Resistencia al Daño de Radiación, en todas las ubicaciones impactadas, aumenta en +2, hasta un total de +4. Cuando infligís daño de Radiación, agregás +1 Dado de Combate al daño por rango. Además, esto desbloquea varias modificaciones.\n\nCada vez que adquirís este Perk, el requisito de Nivel aumenta en 4." },
        { id: "perk198", img: "111", source:"homebrew" , name: "¡Bendito Sea el Radio!", rank: 2, ranks: 2, perkRequired: ["atomite"], perkExclusive: [], reqs: { END: 7, Nivel: 7 }, reqText: "Rasgo El Resplandor de Atom, RES 7, Nivel 7+", desc: "Tu Resistencia al Daño de Radiación, en todas las ubicaciones impactadas, aumenta en +3, hasta un total de +7, y obtenés Inmunidad a la Radiación que no provenga de ataques. Cuando infligís daño de Radiación, agregás +1 Dado de Combate al daño por rango. Además, esto desbloquea varias modificaciones.\n\nCada vez que adquirís este Perk, el requisito de Nivel aumenta en 4." },

        { id: "perk199", img: "112", source:"homebrew" , name: "División", rank: 1, ranks: 2, perkRequired: ["atomite"], perkExclusive: [], reqs: { Nivel: 10 }, reqText: "Rasgo El Resplandor de Atom, Físico Nuclear, Nivel 10+", desc: "Fuiste bendecido con la capacidad de manipular la radiación para propagar la gracia de Atom. Una vez por escena, podés crear un doble corporal hecho de radiación residual pura durante 3 turnos. Tiene 1/3 de tus Puntos de Salud máximos, puede moverse una Zona con su Acción Menor y puede realizar un ataque Desarmado que inflige 3 Dados de Combate de daño de Radiación o explotar con su Acción Mayor, y sigue las reglas de compañeros. Cuando muere, se terminan los turnos o se le ordena hacerlo, explotará e infligirá 8 Dados de Combate de daño de Radiación con el efecto Radiactivo y la cualidad Explosión.\n\nCada vez que adquirís este Perk, el requisito de Nivel aumenta en 5." },
        { id: "perk200", img: "112", source:"homebrew" , name: "División", rank: 2, ranks: 2, perkRequired: ["atomite"], perkExclusive: [], reqs: { Nivel: 15 }, reqText: "Rasgo El Resplandor de Atom, Físico Nuclear, Nivel 15+", desc: "Fuiste bendecido con la capacidad de manipular la radiación para propagar la gracia de Atom. Una vez por escena, podés crear un doble corporal hecho de radiación residual pura durante 5 turnos. Tiene 1/3 de tus Puntos de Salud máximos, puede moverse una Zona con su Acción Menor y puede realizar un ataque Desarmado que inflige 4 Dados de Combate de daño de Radiación o explotar con su Acción Mayor, y sigue las reglas de compañeros. Cuando muere, se terminan los turnos o se le ordena hacerlo, explotará e infligirá 9 Dados de Combate de daño de Radiación con el efecto Radiactivo y la cualidad Explosión.\n\nCada vez que adquirís este Perk, el requisito de Nivel aumenta en 5." },

        { id: "perk196", img: "113", source:"homebrew" , name: "Aliado Autotrónico", rank: 1, ranks: 1, perkRequired: ["atomite"], perkExclusive: [], reqs: { INT: 5 }, reqText: "Rasgo El Resplandor de Atom, Secta West-Tek, INT 5", desc: "ZAX te permitió tener un Eyebot personalizado para ayudarte en tus misiones. El Eyebot tiene un perfil que aparece al final de este documento y es tratado como un PNJ robot aliado bajo tu mando (CRB pág. 338). Si tu Eyebot es destruido, entonces encontrás un nuevo Eyebot antes de la siguiente aventura o podés cambiar este Perk por una diferente después de esta aventura." },

        { id: "perk197", img: "114", source:"homebrew" , name: "Visionario", rank: 1, ranks: 1, perkRequired: ["atomite"], perkExclusive: [], reqs: { PER: 7, Nivel: 3 }, reqText: "Rasgo El Resplandor de Atom, enseñanza \"Su Resplandor, Mi Iluminación\", PER 7, Nivel 3+", desc: "Tus visiones son más fuertes que las de la mayoría y te permiten ver lo que no puede verse.\n\nMientras estés en un área irradiada, podés escudriñar el área cercana, descubriendo la ubicación de toda criatura irradiada dentro de Alcance Extremo mediante una prueba exitosa de PER+Supervivencia con una dificultad de 1." },

        { id: "perk198", img: "115", source:"homebrew" , name: "Inquisitivo", rank: 1, ranks: 1, perkRequired: ["atomite"], perkExclusive: [], reqs: {}, reqText: "Rasgo El Resplandor de Atom, debés ser nombrado Inquisidor", desc: "Fuiste nombrado Inquisidor por la Madre/Confesora de tu secta y recibiste la tarea de encontrar y eliminar a los disidentes y traidores de Atom. Por ello, recibiste entrenamiento en métodos de investigación e interrogación. Reducís en 1 la dificultad de todas las pruebas relacionadas con interrogación o investigación (mínimo 0)." },

        { id: "perk199", img: "116", source:"homebrew" , name: "Garra del Miedo", rank: 1, ranks: 3, perkRequired: ["deathclaw"], perkExclusive: [], reqs: { STR: 7, END: 7, Nivel: 1 }, reqText: "FUE 7, RES 7, Nivel 1+, Deathclaw", desc: "Un veneno ruinoso y cáustico se filtró en tus garras. Cada rango de este Perk otorga a tus ataques Desarmado +1d de daño de Veneno.\n\nCada vez que adquirís este Perk, su requisito de Nivel aumenta en 5." },
        { id: "perk200", img: "116", source:"homebrew" , name: "Garra del Miedo", rank: 2, ranks: 3, perkRequired: ["deathclaw"], perkExclusive: [], reqs: { STR: 7, END: 7, Nivel: 6 }, reqText: "FUE 7, RES 7, Nivel 6+, Deathclaw", desc: "Un veneno ruinoso y cáustico se filtró en tus garras. Cada rango de este Perk otorga a tus ataques Desarmado +1d de daño de Veneno.\n\nCada vez que adquirís este Perk, su requisito de Nivel aumenta en 5." },
        { id: "perk201", img: "116", source:"homebrew" , name: "Garra del Miedo", rank: 3, ranks: 3, perkRequired: ["deathclaw"], perkExclusive: [], reqs: { STR: 7, END: 7, Nivel: 11 }, reqText: "FUE 7, RES 7, Nivel 11+, Deathclaw", desc: "Un veneno ruinoso y cáustico se filtró en tus garras. Cada rango de este Perk otorga a tus ataques Desarmado +1d de daño de Veneno.\n\nCada vez que adquirís este Perk, su requisito de Nivel aumenta en 5." },

        { id: "perk202", img: "117", source:"homebrew" , name: "Eviscerador", rank: 1, ranks: 2, perkRequired: ["deathclaw"], perkExclusive: [], reqs: { STR: 7, AGI: 6, Nivel: 1 }, reqText: "FUE 7, AGI 6, Nivel 1+, Deathclaw", desc: "Tus ataques Desarmado obtienen la cualidad Vicioso.\n\nCada vez que adquirís este Perk, su requisito de Nivel aumenta en 4." },
        { id: "perk203", img: "117", source:"homebrew" , name: "Eviscerador", rank: 2, ranks: 2, perkRequired: ["deathclaw"], perkExclusive: [], reqs: { STR: 7, AGI: 6, Nivel: 5 }, reqText: "FUE 7, AGI 6, Nivel 5+, Deathclaw", desc: "Cuando infligís daño con un ataque Desarmado, podés gastar 2 AP para desarmar al enemigo, haciendo que deje caer su arma.\n\nCada vez que adquirís este Perk, su requisito de Nivel aumenta en 4." },

        { id: "perk204", img: "118", source:"homebrew" , name: "Piel de Cicatrices", rank: 1, ranks: 3, perkRequired: ["deathclaw"], perkExclusive: [], reqs: { END: 8, Nivel: 3 }, reqText: "RES 8, Nivel 3+, Deathclaw", desc: "Tu carne curtida por las batallas se endureció. Cada rango de este Perk otorga +1 de Resistencia al Daño contra daño Físico, de Energía, Veneno y Radiación. Esto no protege contra el daño causado por fuego.\n\nCada vez que adquirís este Perk, el requisito de Nivel aumenta en 3." },
        { id: "perk205", img: "118", source:"homebrew" , name: "Piel de Cicatrices", rank: 2, ranks: 3, perkRequired: ["deathclaw"], perkExclusive: [], reqs: { END: 8, Nivel: 6 }, reqText: "RES 8, Nivel 6+, Deathclaw", desc: "Tu carne curtida por las batallas se endureció. Cada rango de este Perk otorga +1 de Resistencia al Daño contra daño Físico, de Energía, Veneno y Radiación. Esto no protege contra el daño causado por fuego.\n\nCada vez que adquirís este Perk, el requisito de Nivel aumenta en 3." },
        { id: "perk206", img: "118", source:"homebrew" , name: "Piel de Cicatrices", rank: 3, ranks: 3, perkRequired: ["deathclaw"], perkExclusive: [], reqs: { END: 8, Nivel: 9 }, reqText: "RES 8, Nivel 9+, Deathclaw", desc: "Tu carne curtida por las batallas se endureció. Cada rango de este Perk otorga +1 de Resistencia al Daño contra daño Físico, de Energía, Veneno y Radiación. Esto no protege contra el daño causado por fuego.\n\nCada vez que adquirís este Perk, el requisito de Nivel aumenta en 3." },

        { id: "perk207", img: "119", source:"homebrew" , name: "Sentido de la Muerte", rank: 1, ranks: 1, perkRequired: ["deathclaw"], perkExclusive: [], reqs: { PER: 7 }, reqText: "PER 7, Deathclaw", desc: "Tus sentidos finamente desarrollados te permiten detectar vibraciones increíblemente sutiles en el suelo, el aire e incluso los latidos del corazón. Podés detectar cosas que otros personajes no pueden y reducís en 1, hasta un mínimo de 0, la dificultad de todas las pruebas de PER si involucran tus sentidos del oído, tacto o magnetismo. Esto incluso se aplica a las pruebas para detectar mentiras; al igual que un perro, podés captar señales de engaño incluso cuando no sabés qué está diciendo una persona." },

        { id: "perk208", img: "120", source:"homebrew" , name: "Frenesí", rank: 1, ranks: 3, perkRequired: ["deathclaw"], perkExclusive: [], reqs: { STR: 7, AGI: 7, Nivel: 1 }, reqText: "FUE 7, AGI 7, Deathclaw, Nivel 1+, no tiene Domesticado", desc: "Cuando tu sangre empieza a fluir, te convertís en una máquina de matar medio enloquecida y te asegurás de que siga fluyendo mucha más sangre.\n\nMientras tu Salud esté por debajo de su máximo, podés elegir entrar en frenesí durante tu turno. Mientras estés en frenesí, ignorás por completo el efecto de las Lesiones en una extremidad por rango de este Perk y debés atacar a alguien, si es posible, en cada uno de tus turnos. No podés utilizar tus acciones de una manera que impida realizar un ataque, incluso si tu único objetivo posible es un aliado; no podés moverte primero a una Zona vacía y después decir \"uh, parece que estoy fuera de alcance\".\n\nTu frenesí termina cuando termina la escena, cuando superás una prueba de RES + Supervivencia con dificultad 1 para calmarte, o cuando otra persona supera una prueba de INT o CAR + Hablar o Supervivencia con dificultad 1 para calmarte. Una vez que termina tu frenesí, no podés volver a entrar en frenesí durante la misma escena.\n\nCada vez que adquirís este Perk, el requisito de Nivel aumenta en 4." },
        { id: "perk209", img: "120", source:"homebrew" , name: "Frenesí", rank: 2, ranks: 3, perkRequired: ["deathclaw"], perkExclusive: [], reqs: { STR: 7, AGI: 7, Nivel: 5 }, reqText: "FUE 7, AGI 7, Deathclaw, Nivel 5+, no tiene Domesticado", desc: "Cuando tu sangre empieza a fluir, te convertís en una máquina de matar medio enloquecida y te asegurás de que siga fluyendo mucha más sangre.\n\nMientras tu Salud esté por debajo de su máximo, podés elegir entrar en frenesí durante tu turno. Mientras estés en frenesí, ignorás por completo el efecto de las Lesiones en dos extremidades por rango de este Perk y debés atacar a alguien, si es posible, en cada uno de tus turnos. No podés utilizar tus acciones de una manera que impida realizar un ataque, incluso si tu único objetivo posible es un aliado; no podés moverte primero a una Zona vacía y después decir \"uh, parece que estoy fuera de alcance\".\n\nTu frenesí termina cuando termina la escena, cuando superás una prueba de RES + Supervivencia con dificultad 1 para calmarte, o cuando otra persona supera una prueba de INT o CAR + Hablar o Supervivencia con dificultad 1 para calmarte. Una vez que termina tu frenesí, no podés volver a entrar en frenesí durante la misma escena.\n\nCada vez que adquirís este Perk, el requisito de Nivel aumenta en 4." },
        { id: "perk210", img: "120", source:"homebrew" , name: "Frenesí", rank: 3, ranks: 3, perkRequired: ["deathclaw"], perkExclusive: [], reqs: { STR: 7, AGI: 7, Nivel: 9 }, reqText: "FUE 7, AGI 7, Deathclaw, Nivel 9+, no tiene Domesticado", desc: "Cuando tu sangre empieza a fluir, te convertís en una máquina de matar medio enloquecida y te asegurás de que siga fluyendo mucha más sangre.\n\nMientras tu Salud esté por debajo de su máximo, podés elegir entrar en frenesí durante tu turno. Mientras estés en frenesí, ignorás por completo el efecto de las Lesiones en tres extremidades por rango de este Perk y debés atacar a alguien, si es posible, en cada uno de tus turnos. No podés utilizar tus acciones de una manera que impida realizar un ataque, incluso si tu único objetivo posible es un aliado; no podés moverte primero a una Zona vacía y después decir \"uh, parece que estoy fuera de alcance\".\n\nTu frenesí termina cuando termina la escena, cuando superás una prueba de RES + Supervivencia con dificultad 1 para calmarte, o cuando otra persona supera una prueba de INT o CAR + Hablar o Supervivencia con dificultad 1 para calmarte. Una vez que termina tu frenesí, no podés volver a entrar en frenesí durante la misma escena.\n\nCada vez que adquirís este Perk, el requisito de Nivel aumenta en 4." },

        { id: "perk211", img: "121", source:"homebrew" , name: "Domesticado", rank: 1, ranks: 1, perkRequired: ["deathclaw"], perkExclusive: [], reqs: { CHA: 6 }, reqText: "CAR 6, Deathclaw, no tiene Frenesí", desc: "Estás muy familiarizado con cómo comportarte cerca de humanos, cómo parecer menos una brutal máquina de matar y más un grandote peludo con manos enormes para dar abrazos enormes.\n\nObtenés una habilidad etiquetada (Tag) gratuita en Hablar o Trueque. Si ambas ya están etiquetadas, obtenés una habilidad etiquetada gratuita en cualquier habilidad que quieras. Mientras no hayas realizado ninguna acción amenazante durante la escena actual y tengas algún tipo de señal de seguridad (generalmente un chaleco reflectante), no sos considerado una amenaza incluso si nadie te está controlando de manera evidente. La mayoría de los demás seguirán estando en guardia, pero podés hacer tus propios asuntos con la gente y no te van a disparar en la cara." },

        { id: "perk212", img: "122", source:"homebrew" , name: "Domador de Deathclaws", rank: 1, ranks: 2, perkRequired: [], perkExclusive: ["deathclaw"], reqs: { Nivel: 1 }, reqText: "CAR 7, Nivel 1+, no es Deathclaw", desc: "Tenés amplios conocimientos sobre cómo tratar con Deathclaws, entrenarlos y darles órdenes, ya sea gracias a un entrenamiento formal, como el del Cuerpo de Navegación de la Hermandad, o, digamos, a una experiencia más \"inmediata\".\n\nEn Rango 1, cualquier Deathclaw con el que viajes se considera obviamente controlado, sin importar lo que haga, siempre que no ataque abiertamente a nadie. Si además está Domesticado, ni siquiera necesita equipamiento de seguridad ni permanecer cerca tuyo; la gente no estará constantemente en guardia y puede vagar haciendo lo que quiera como si fuera un enorme perro cariñoso. Vos y cualquier Deathclaw amistoso dentro de alcance sensorial pueden gastar los Puntos de Suerte del otro (con permiso del otro, por supuesto). Fuera de combate, vos y un Deathclaw amistoso pueden realizar pruebas de habilidad utilizando tu Habilidad y el Atributo del Deathclaw, o tu INT y la Habilidad del Deathclaw. Guiar al Deathclaw durante esto hace que la acción tarde el doble.\n\nCada vez que adquirís este Perk, el Nivel requerido aumenta en 7." },
        { id: "perk213", img: "122", source:"homebrew" , name: "Domador de Deathclaws", rank: 2, ranks: 2, perkRequired: [], perkExclusive: ["deathclaw"], reqs: { Nivel: 8 }, reqText: "CAR 7, Nivel 8+, no es Deathclaw", desc: "Tenés amplios conocimientos sobre cómo tratar con Deathclaws, entrenarlos y darles órdenes, ya sea gracias a un entrenamiento formal, como el del Cuerpo de Navegación de la Hermandad, o, digamos, a una experiencia más \"inmediata\".\n\nEn Rango 1, cualquier Deathclaw con el que viajes se considera obviamente controlado, sin importar lo que haga, siempre que no ataque abiertamente a nadie. Si además está Domesticado, ni siquiera necesita equipamiento de seguridad ni permanecer cerca tuyo; la gente no estará constantemente en guardia y puede vagar haciendo lo que quiera como si fuera un enorme perro cariñoso. Vos y cualquier Deathclaw amistoso dentro de alcance sensorial pueden gastar los Puntos de Suerte del otro (con permiso del otro, por supuesto). Fuera de combate, vos y un Deathclaw amistoso pueden realizar pruebas de habilidad utilizando tu Habilidad y el Atributo del Deathclaw, o tu INT y la Habilidad del Deathclaw. Guiar al Deathclaw durante esto hace que la acción tarde el doble.\n\nEn Rango 2, podés intentar pacificar Deathclaws hostiles (o, a discreción del GM, otras máquinas de matar impías como los osos). Podés acercarte a un Deathclaw al que no hayas atacado e intentar una prueba de CAR + Supervivencia con dificultad 3 que requiere un minuto de caminar lentamente hacia él, emitir sonidos tranquilizadores y llamarlo \"grandote\". Si tenés éxito, la criatura no intentará hacerte daño a vos ni a tu grupo a menos que la amenaces directamente. Si tenés Rango 2 de el Perk Amigo de los Animales, reducís en 1 la dificultad de esta prueba. Si podés darle al Deathclaw algo que quiera, como uno de sus huevos, tratamiento para una lesión obviamente dolorosa o, si nada de eso funciona, un buen trozo grande de carne cruda, reducís en 1 la dificultad de esta prueba.\n\nCada vez que adquirís este Perk, el Nivel requerido aumenta en 7." },

        { id: "perk214", img: "123", source:"homebrew" , name: "Mutable", rank: 1, ranks: 10, perkRequired: ["numen"], perkExclusive: [], reqs: { Nivel: 1 }, reqText: "Nivel 1+", desc: "Tu cuerpo experimenta una transformación rápida e intensa. Si sos humano, esto te convertirá en Numen, reemplazando tu rasgo actual por Casi Super(Mutante), y podés volver a adquirir este Perk inmediatamente. Si sos Numen, esto te otorga una mutación adicional de la tabla de mutaciones.\n\nEn cada rango, podés adquirir otra mutación. Cada vez que adquirís este Perk, el requisito de Nivel aumenta en 6." },
        { id: "perk215", img: "123", source:"homebrew" , name: "Mutable", rank: 2, ranks: 10, perkRequired: ["numen"], perkExclusive: [], reqs: { Nivel: 7 }, reqText: "Nivel 7+", desc: "Tu cuerpo experimenta una transformación rápida e intensa. Si sos humano, esto te convertirá en Numen, reemplazando tu rasgo actual por Casi Super(Mutante), y podés volver a adquirir este Perk inmediatamente. Si sos Numen, esto te otorga una mutación adicional de la tabla de mutaciones.\n\nEn cada rango, podés adquirir otra mutación. Cada vez que adquirís este Perk, el requisito de Nivel aumenta en 6." },
