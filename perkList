        { id: "perk080", img: "046", source:"coreBook" , name: "Puño de Hierro", rank: 1, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { FUE: 6, Nivel: 1 }, reqText: "FUE 6, Nivel 1+", desc: "Tus ataques desarmados infligen +1 DCD de daño.", system: [extraMeleeDamage: 1] },
        { id: "perk081", img: "046", source:"coreBook" , name: "Puño de Hierro", rank: 2, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { FUE: 6, Nivel: 6 }, reqText: "FUE 6, Nivel 6+", desc: "Tus ataques desarmados infligen +1 DCD de daño y obtienen el efecto de daño Vicioso.", system: [extraMeleeDamage: 2] },

        { id: "perk082", img: "047", source:"coreBook" , name: "Vendedor de Jerky de Junktown", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { CAR: 8 }, reqText: "CAR 8", desc: "La dificultad de cualquier prueba de CHA + Trueque que realices para comprar o vender bienes se reduce en 1, hasta un mínimo de 0." },

        { id: "perk083", img: "048", source:"coreBook" , name: "Reparación Improvisada", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: {}, reqText: "Ninguno", desc: "Podés reparar un objeto sin tener que gastar ningún componente. Sin embargo, la reparación es temporal y el objeto volverá a romperse con la próxima complicación que sufras mientras lo utilizás. El rango de complicación de todas las pruebas de habilidad para utilizar el objeto aumenta en 1, hasta una tirada de 19–20." },

        { id: "perk084", img: "049", source:"coreBook" , name: "Comandante Láser", rank: 1, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { PER: 8, Nivel: 2 }, reqText: "PER 8, Nivel 2+", desc: "Cuando realizás un ataque con un arma de energía a distancia, el daño aumenta en +1 dado.", system: [ {type: "extraRangeDamage", value: 1, condition: {weaponDamageType: "energy"}} ] },
        { id: "perk085", img: "049", source:"coreBook" , name: "Comandante Láser", rank: 2, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { PER: 8, Nivel: 6 }, reqText: "PER 8, Nivel 6+", desc: "Cuando realizás un ataque con un arma de energía a distancia, el daño aumenta en +2 dados.", system: [ {type: "extraRangeDamage", value: 2, condition: {weaponDamageType: "energy"}} ]},

        { id: "perk086", img: "050", source:"coreBook" , name: "Estómago de Plomo", rank: 1, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { END: 6, Nivel: 1 }, reqText: "END 6, Nivel 1+", desc: "Podés volver a tirar el CD utilizado para determinar si sufrís daño por radiación proveniente de comida o bebida irradiada." },
        { id: "perk087", img: "050", source:"coreBook" , name: "Estómago de Plomo", rank: 2, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { END: 6, Nivel: 5 }, reqText: "END 6, Nivel 5+", desc: "Sos inmune al daño por radiación producido por consumir comida o bebida irradiada." },

        { id: "perk088", img: "051", source:"coreBook" , name: "Dador de Vida", rank: 1, ranks: 5, perkRequired: [], perkExclusive: [], reqs: { Nivel: 5 }, reqText: "Nivel 5+", desc: "Aumentá tus puntos de vida máximos en una cantidad igual a tu rango de Resistencia.", system: [ type: "extraHP", basedOn: "END", times: "1" ] },
        { id: "perk089", img: "051", source:"coreBook" , name: "Dador de Vida", rank: 2, ranks: 5, perkRequired: [], perkExclusive: [], reqs: { Nivel: 10 }, reqText: "Nivel 10+", desc: "Aumentá tus puntos de vida máximos en una cantidad igual a tu rango de Resistencia.", system: [ type: "extraHP", basedOn: "END", times: "2" ] },
        { id: "perk090", img: "051", source:"coreBook" , name: "Dador de Vida", rank: 3, ranks: 5, perkRequired: [], perkExclusive: [], reqs: { Nivel: 15 }, reqText: "Nivel 15+", desc: "Aumentá tus puntos de vida máximos en una cantidad igual a tu rango de Resistencia.", system: [ type: "extraHP", basedOn: "END", times: "3" ] },
        { id: "perk091", img: "051", source:"coreBook" , name: "Dador de Vida", rank: 4, ranks: 5, perkRequired: [], perkExclusive: [], reqs: { Nivel: 20 }, reqText: "Nivel 20+", desc: "Aumentá tus puntos de vida máximos en una cantidad igual a tu rango de Resistencia.", system: [ type: "extraHP", basedOn: "END", times: "4" ] },
        { id: "perk092", img: "051", source:"coreBook" , name: "Dador de Vida", rank: 5, ranks: 5, perkRequired: [], perkExclusive: [], reqs: { Nivel: 25 }, reqText: "Nivel 25+", desc: "Aumentá tus puntos de vida máximos en una cantidad igual a tu rango de Resistencia.", system: [ type: "extraHP", basedOn: "END", times: "5" ] },

        { id: "perk093", img: "052", source:"coreBook" , name: "Paso Ligero", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: {}, reqText: "Ninguno", desc: "Cuando tirás para generar complicaciones en cualquier prueba de habilidad basada en Agilidad, podés ignorar una complicación por cada 1 PA gastado. Además, podés volver a tirar 1d20 en cualquier prueba de AGI + Atletismo para evitar trampas activadas por placas de presión o mecanismos similares." },

        { id: "perk094", img: "053", source:"coreBook" , name: "Maestro Ladrón", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { PER: 8, AGI: 9 }, reqText: "PER 8, AGI 9", desc: "Cuando intentás forzar una cerradura o robarle algo a alguien, la dificultad de la prueba de habilidad del oponente para detectarte aumenta en +1." },

        { id: "perk095", img: "054", source:"coreBook" , name: "Médico", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { INT: 8 }, reqText: "INT 8", desc: "Cuando utilizás la acción Primeros auxilios para intentar tratar una herida, podés volver a tirar 1d20." },

        { id: "perk096", img: "055", source:"coreBook" , name: "Fusión", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { PER: 10 }, reqText: "PER 10", desc: "Cuando matás a un enemigo con un arma de energía, explota. Tirá una cantidad de dados igual a la mitad del valor de daño del arma (redondeado hacia abajo). Por cada Efecto obtenido, una criatura a alcance Corto del enemigo que explota, comenzando por la más cercana, sufre daño de energía igual al total obtenido en los dados." },

        { id: "perk097", img: "056", source:"coreBook" , name: "Señor de la Arena", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { AGI: 9 }, reqText: "AGI 9", desc: "Cuando realizás un ataque de sigilo con un arma silenciada o suprimida, el daño aumenta en +2 CD. No podés obtener este beneficio mientras llevás Servoarmadura." },

        { id: "perk098", img: "057", source:"coreBook" , name: "Objetivo Móvil", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { AGI: 6 }, reqText: "AGI 6", desc: "Cuando realizás la acción Correr, tu Defensa aumenta en +1 hasta el comienzo de tu próximo turno." },

        { id: "perk099", img: "058", source:"coreBook" , name: "Extraño Misterioso", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { LCK: 7 }, reqText: "LCK 7", desc: "De vez en cuando, un Extraño Misterioso viene en tu ayuda, con resultados letales. Al comienzo de un encuentro de combate, podés gastar 1 Punto de Suerte. Si lo hacés, en cualquier momento durante la escena el DJ puede hacer que aparezca el Extraño Misterioso, realice un único ataque a distancia contra un enemigo al que hayas atacado o que te haya atacado recientemente, y luego desaparezca. Si gastás un Punto de Suerte y el Extraño Misterioso no aparece, el DJ debe devolverte el Punto de Suerte que gastaste. El Extraño tiene AGI 10, una habilidad de Armas Pequeñas de 6 y considera Armas Pequeñas como una Habilidad Etiquetada. Siempre tira 3d20 para sus ataques, en lugar de 2d20, y su ataque —utilizando un revólver Magnum .44 personalizado— inflige 8 CD de daño físico Perforante 1, Vicioso. Siempre aparece dentro del alcance ideal de su arma. Cualquier intento de encontrar adónde fue el Extraño después de su ataque falla." },

        { id: "perk100", img: "059", source:"coreBook" , name: "¡Rabia Nerd!", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { INT: 8, Nivel: 2 }, reqText: "INT 8, Nivel 2+", desc: "Mientras tu salud esté reducida a menos de ¼ de su máximo, agregás +1 a tu DR física, +1 a tu DR de energía y +1 CD al daño de todos tus ataques." },
        { id: "perk101", img: "059", source:"coreBook" , name: "¡Rabia Nerd!", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { INT: 8, Nivel: 7 }, reqText: "INT 8, Nivel 7+", desc: "Mientras tu salud esté reducida a menos de ¼ de su máximo, agregás +2 a tu DR física, +2 a tu DR de energía y +2 CD al daño de todos tus ataques." },
        { id: "perk102", img: "059", source:"coreBook" , name: "¡Rabia Nerd!", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { INT: 8, Nivel: 12 }, reqText: "INT 8, Nivel 12+", desc: "Mientras tu salud esté reducida a menos de ¼ de su máximo, agregás +3 a tu DR física, +3 a tu DR de energía y +3 CD al daño de todos tus ataques." },

        { id: "perk103", img: "060", source:"coreBook" , name: "Persona Nocturna", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { PER: 7 }, reqText: "PER 7", desc: "Reducís en 1 cualquier aumento de dificultad debido a la oscuridad." },

        { id: "perk104", img: "061", source:"coreBook" , name: "Ninja", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { AGI: 8 }, reqText: "AGI 8", desc: "Cuando realizás un ataque de sigilo con un arma cuerpo a cuerpo o un ataque desarmado, el daño aumenta en +2 CD. No podés obtener este beneficio mientras llevás Servoarmadura." },

        { id: "perk105", img: "062", source:"coreBook" , name: "Físico Nuclear", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { INT: 9 }, reqText: "INT 9", desc: "Siempre que utilizás un arma que inflige daño por radiación o que tiene el efecto de daño Radiactivo, cada Efecto que obtenés inflige un punto adicional de daño por radiación. Además, los núcleos de fusión que utilizás tienen 3 cargas adicionales." },

        { id: "perk106", img: "063", source:"coreBook" , name: "Tren del Dolor", rank: 1, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { FUE: 9, END: 7, Nivel: 1 }, reqText: "FUE 9, END 7, Nivel 1+", desc: "Podés realizar una Carga como acción mayor si llevás Servoarmadura o sos un supermutante. Esta es una acción de movimiento y no podés Moverte ni Correr durante el mismo turno. Cuando realizás esta acción, te movés hasta estar al alcance de un enemigo a alcance Medio (1 zona) y realizás una prueba de FUE + Atletismo con una dificultad de 2. Si tenés éxito, el enemigo sufre daño igual a tu daño desarmado normal y queda derribado. A criterio del DJ, especialmente las criaturas grandes o robustas no pueden ser derribadas mediante esta acción." },
        { id: "perk107", img: "063", source:"coreBook" , name: "Tren del Dolor", rank: 2, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { FUE: 9, END: 7, Nivel: 6 }, reqText: "FUE 9, END 7, Nivel 6+", desc: "Podés realizar una Carga como acción mayor si llevás Servoarmadura o sos un supermutante. Cuando realizás esta acción y tenés éxito, el enemigo sufre daño igual a tu daño desarmado normal, queda derribado y el ataque agrega +1 DCD y el efecto de daño Aturdir." },SAMBUCA

        { id: "perk108", img: "064", source:"coreBook" , name: "Palma Paralizante", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { FUE: 8 }, reqText: "FUE 8", desc: "Cuando realizás un ataque desarmado y elegís golpear una ubicación específica, tu ataque obtiene el efecto de daño Aturdir." },

        { id: "perk109", img: "065", source:"coreBook" , name: "Chico/Chica de Fiesta", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { END: 6, CAR: 7 }, reqText: "END 6, CAR 7", desc: "No podés volverte adicto a las bebidas alcohólicas y, siempre que tomás una bebida alcohólica, recuperás +2 PG." },

        { id: "perk110", img: "066", source:"coreBook" , name: "Explorador", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { PER: 6, END: 6 }, reqText: "PER 6, END 6", desc: "Cuando viajás largas distancias a través del Yermo, una prueba exitosa de PER + Supervivencia (con una dificultad determinada por el DJ según el terreno) reduce a la mitad el tiempo de viaje." },

        { id: "perk111", img: "067", source:"coreBook" , name: "Farmacéutico", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { LCK: 6 }, reqText: "LCK 6", desc: "Cuando saqueás una ubicación que contiene medicina o químicos, encontrás un objeto adicional, determinado aleatoriamente, sin gastar PA." },

        { id: "perk112", img: "068", source:"coreBook" , name: "Carterista", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { PER: 8, AGI: 8, Nivel: 1 }, reqText: "PER 8, AGI 8, Nivel 1+", desc: "Podés ignorar la primera complicación que obtengas al realizar una prueba de AGI + Sigilo para robar un objeto de la persona de alguien o colocarle algo." },
        { id: "perk113", img: "068", source:"coreBook" , name: "Carterista", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { PER: 8, AGI: 8, Nivel: 4 }, reqText: "PER 8, AGI 8, Nivel 4+", desc: "Podés volver a tirar 1d20 de tu reserva de dados cuando intentás robarle algo a alguien." },
        { id: "perk114", img: "068", source:"coreBook" , name: "Carterista", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { PER: 8, AGI: 8, Nivel: 7 }, reqText: "PER 8, AGI 8, Nivel 7+", desc: "Reducís en 1 la dificultad de los intentos de robarle algo a alguien." },

        { id: "perk115", img: "069", source:"coreBook" , name: "Golpe Perforante", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { FUE: 7 }, reqText: "FUE 7", desc: "Tus ataques utilizando ataques desarmados y armas cuerpo a cuerpo con filo obtienen el efecto de daño Perforante 1, o agregan +1 al valor de cualquier efecto de daño Perforante X que ya tuvieran.", system: [unarmed && meelee: "Perforante +1"] },

        { id: "perk116", img: "070", source:"coreBook" , name: "Pirotécnico", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { END: 6, Nivel: 2 }, reqText: "END 6, Nivel 2+", desc: "El daño que infligís utilizando armas basadas en fuego aumenta en +1 CD.", system: [extraFireDmg: "1"] },
        { id: "perk117", img: "070", source:"coreBook" , name: "Pirotécnico", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { END: 6, Nivel: 6 }, reqText: "END 6, Nivel 6+", desc: "El daño que infligís utilizando armas basadas en fuego aumenta en +2 CD.", system: [extraFireDmg: "2"] },
        { id: "perk118", img: "070", source:"coreBook" , name: "Pirotécnico", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { END: 6, Nivel: 10 }, reqText: "END 6, Nivel 10+", desc: "El daño que infligís utilizando armas basadas en fuego aumenta en +3 CD.", system: [extraFireDmg: "3"] },

        { id: "perk119", img: "071", source:"coreBook" , name: "Desenfunde Rápido", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { AGI: 6 }, reqText: "AGI 6", desc: "Cada turno, podés sacar un único arma u objeto que lleves encima sin utilizar una acción menor." },

        { id: "perk120", img: "072", source:"coreBook" , name: "Manos Rápidas", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { AGI: 8 }, reqText: "AGI 8", desc: "Podés recargar armas de fuego más rápido. Cuando realizás un ataque a distancia, podés gastar 2 PA para aumentar en +2 la Cadencia de Fuego de tu arma para ese ataque. Adicionalmente, recargar un arma es una accion gratuita para armas pequeñas y de energia, o menor para grandes, algunas armas pequeñas, como las ametralladoras, usan una accion menor." },

        { id: "perk121", img: "073", source:"coreBook" , name: "Resistencia a la Radiación", rank: 1, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { END: 8, Nivel: 1 }, reqText: "END 8, Nivel 1+", desc: "Tu Resistencia al Daño por radiación, en todas las ubicaciones impactadas, aumenta en +1.", system: [extraRadDR: "1"] },
        { id: "perk122", img: "073", source:"coreBook" , name: "Resistencia a la Radiación", rank: 2, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { END: 8, Nivel: 5 }, reqText: "END 8, Nivel 5+", desc: "Tu Resistencia al Daño por radiación, en todas las ubicaciones impactadas, aumenta en +2.", system: [extraRadDR: "2"] },

        { id: "perk123", img: "074", source:"coreBook" , name: "Refractor", rank: 1, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { PER: 6, LCK: 7, Nivel: 1 }, reqText: "PER 6, LCK 7, Nivel 1+", desc: "Tu Resistencia al Daño de energía en todas las ubicaciones impactadas aumenta en +1.", system: [extraEnerDR: "1"] },
        { id: "perk124", img: "074", source:"coreBook" , name: "Refractor", rank: 2, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { PER: 6, LCK: 7, Nivel: 5 }, reqText: "PER 6, LCK 7, Nivel 5+", desc: "Tu Resistencia al Daño de energía en todas las ubicaciones impactadas aumenta en +2.", system: [extraEnerDR: "2"] },

        { id: "perk125", img: "075", source:"coreBook" , name: "Rebote", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { LCK: 10, Nivel: 5 }, reqText: "LCK 10, Nivel 5+", desc: "Si un enemigo realiza un ataque a distancia contra vos y obtiene una complicación, podés gastar un Punto de Suerte para hacer que su rebote lo impacte. Resolvé la tirada de daño contra el enemigo atacante." },

        { id: "perk126", img: "076", source:"coreBook" , name: "Fusilero", rank: 1, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { AGI: 7, Nivel: 2 }, reqText: "AGI 7, Nivel 2+", desc: "Cuando realizás un ataque a distancia con cualquier arma de dos manos con una Cadencia de Fuego de 2 o menos (excepto armas pesadas), agregás +1 CD al daño del arma.", system: [ {type: "extraRangeDamage", value: 1, condition: {weaponFireRate: {max: 2}, weaponCategory: {"two-handed"}}} ] },
        { id: "perk127", img: "076", source:"coreBook" , name: "Fusilero", rank: 2, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { AGI: 7, Nivel: 6 }, reqText: "AGI 7, Nivel 6+", desc: "Cuando realizás un ataque a distancia con cualquier arma de dos manos con una Cadencia de Fuego de 2 o menos (excepto armas pesadas), agregás +2 CD al daño del arma. Además, agregás el efecto de daño Perforante 1, o +1 al valor de cualquier efecto de daño Perforante X que el arma ya tuviera.", system: [ {type: "extraRangeDamage", value: 2, condition: {weaponFireRate: {max: 2}, weaponCategory: {cualidades: "A dos manos"}}, {damageEffects: "Perforante +1"} ] },

        { id: "perk128", img: "077", source:"coreBook" , name: "Experto en Robótica", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { INT: 8, Nivel: 2 }, reqText: "INT 8, Nivel 2+", desc: "Podés modificar armadura de robots, soportes de armas y módulos con mods de rango 1." },
        { id: "perk129", img: "077", source:"coreBook" , name: "Experto en Robótica", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { INT: 8, Nivel: 6 }, reqText: "INT 8, Nivel 6+", desc: "Obtenés acceso a mods de rango 2 y la dificultad de las pruebas para reparar robots se reduce permanentemente en 1." },
        { id: "perk130", img: "077", source:"coreBook" , name: "Experto en Robótica", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { INT: 8, Nivel: 10 }, reqText: "INT 8, Nivel 10+", desc: "Obtenés acceso a mods de rango 3 y podés reprogramar robots para cumplir una función diferente o alterar su comportamiento, a criterio del DJ." },

        { id: "perk131", img: "078", source:"coreBook" , name: "¡Ciencia!", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { INT: 6, Nivel: 2 }, reqText: "INT 6, Nivel 2+", desc: "Podés modificar armas de energía con mods de armas y también podés fabricar ciertos mods avanzados de armadura. Este rango desbloquea mods de rango 1." },
