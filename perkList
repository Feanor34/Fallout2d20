        { id: "perk262", img: "146", source: "wanderersGuide", name: "Gladiador", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { STR: 6, Nivel: 2 }, reqText: "STR 6, Nivel 2+", desc: "Mientras empuñás un arma cuerpo a cuerpo de una mano, aumentá su daño en +1 CD." },
        { id: "perk263", img: "146", source: "wanderersGuide", name: "Gladiador", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { STR: 6, Nivel: 7 }, reqText: "STR 6, Nivel 7+", desc: "Mientras empuñás un arma cuerpo a cuerpo de una mano, aumentá su daño en +2 CD." },
        { id: "perk264", img: "146", source: "wanderersGuide", name: "Gladiador", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { STR: 6, Nivel: 12 }, reqText: "STR 6, Nivel 12+", desc: "Mientras empuñás un arma cuerpo a cuerpo de una mano, aumentá su daño en +3 CD." },

        { id: "perk265", img: "147", source: "wanderersGuide", name: "Incisor", rank: 1, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { STR: 6, Nivel: 2 }, reqText: "STR 6, Nivel 2+", desc: "Tus armas cuerpo a cuerpo obtienen Penetración 1. Si ya tienen Penetración X, aumentá su valor en 1." },
        { id: "perk266", img: "147", source: "wanderersGuide", name: "Incisor", rank: 2, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { STR: 6, Nivel: 11 }, reqText: "STR 6, Nivel 11+", desc: "Tus armas cuerpo a cuerpo obtienen Penetración 2. Si ya tienen Penetración X, aumentá su valor en 2." },

        { id: "perk267", img: "148", source: "wanderersGuide", name: "Cargá y dispará", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { STR: 7, Nivel: 7 }, reqText: "STR 7, Nivel 7+", desc: "Cuando empuñás un arma pesada con Cadencia 2 o superior, aumentá su Cadencia en +1." },
        { id: "perk268", img: "148", source: "wanderersGuide", name: "Cargá y dispará", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { STR: 7, Nivel: 12 }, reqText: "STR 7, Nivel 12+", desc: "Cuando empuñás un arma pesada con Cadencia 2 o superior, aumentá su Cadencia en +2." },
        { id: "perk269", img: "148", source: "wanderersGuide", name: "Cargá y dispará", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { STR: 7, Nivel: 17 }, reqText: "STR 7, Nivel 17+", desc: "Cuando empuñás un arma pesada con Cadencia 2 o superior, aumentá su Cadencia en +2. La fuente indica este valor para el rango 3." },

        { id: "perk270", img: "149", source: "wanderersGuide", name: "Artista marcial", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { STR: 6, Nivel: 8 }, reqText: "STR 6, Nivel 8+", desc: "Cuando realizás un ataque cuerpo a cuerpo, podés gastar 1 PA en lugar de 2 PA para realizar una acción mayor adicional, siempre que también sea un ataque cuerpo a cuerpo con la misma arma u otra que tengas equipada." },

        { id: "perk271", img: "150", source: "wanderersGuide", name: "Rata de carga", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { STR: 6, Nivel: 4 }, reqText: "STR 6, Nivel 4+", desc: "Los objetos de chatarra que llevás pesan la mitad de su peso indicado." },

        { id: "perk272", img: "151", source: "wanderersGuide", name: "Disparo disperso", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { STR: 7, Nivel: 10 }, reqText: "STR 7, Nivel 10+", desc: "Cuando realizás un ataque a distancia con una escopeta, podés gastar 1 PA en lugar de 2 PA para realizar una acción mayor adicional de ataque con esa misma escopeta." },

        { id: "perk273", img: "152", source: "wanderersGuide", name: "Estructura robusta", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { STR: 8, Nivel: 5 }, reqText: "STR 8, Nivel 5+", desc: "La armadura que llevás, excepto la servoarmadura, cuenta como si pesara tres cuartas partes de su peso indicado." },
        { id: "perk274", img: "152", source: "wanderersGuide", name: "Estructura robusta", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { STR: 8, Nivel: 13 }, reqText: "STR 8, Nivel 13+", desc: "La armadura que llevás, excepto la servoarmadura, cuenta como si pesara la mitad de su peso indicado." },
        { id: "perk275", img: "152", source: "wanderersGuide", name: "Estructura robusta", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { STR: 8, Nivel: 21 }, reqText: "STR 8, Nivel 21+", desc: "La armadura que llevás, excepto la servoarmadura, cuenta como si pesara una cuarta parte de su peso indicado." },

        { id: "perk276", img: "153", source: "wanderersGuide", name: "Arquero", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { PER: 6, Nivel: 1 }, reqText: "PER 6, Nivel 1+", desc: "Cuando empuñás un arco o una ballesta, aumentá su daño en +1 CD." },
        { id: "perk277", img: "153", source: "wanderersGuide", name: "Arquero", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { PER: 6, Nivel: 8 }, reqText: "PER 6, Nivel 8+", desc: "Cuando empuñás un arco o una ballesta, aumentá su daño en +2 CD." },
        { id: "perk278", img: "153", source: "wanderersGuide", name: "Arquero", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { PER: 6, Nivel: 15 }, reqText: "PER 6, Nivel 15+", desc: "Cuando empuñás un arco o una ballesta, aumentá su daño en +3 CD." },

        { id: "perk279", img: "154", source: "wanderersGuide", name: "Inclinate ante mí", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { PER: 8, Nivel: 4 }, reqText: "PER 8, Nivel 4+", desc: "Cuando empuñás un arco o una ballesta, el arma obtiene Penetración 1. Si ya tiene Penetración X, aumentá su valor en 1." },

        { id: "perk280", img: "155", source: "wanderersGuide", name: "Botín de carnicero", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { PER: 8, Nivel: 3 }, reqText: "PER 8, Nivel 3+", desc: "Cuando descuartizás con éxito un animal muerto, tirá +1 CD y obtené porciones adicionales de carne, según el total obtenido y las cantidades indicadas en el perfil de la criatura." },
        { id: "perk281", img: "155", source: "wanderersGuide", name: "Botín de carnicero", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { PER: 8, Nivel: 8 }, reqText: "PER 8, Nivel 8+", desc: "Cuando descuartizás con éxito un animal muerto, tirá +2 CD y obtené porciones adicionales de carne, según el total obtenido y las cantidades indicadas en el perfil de la criatura." },
        { id: "perk282", img: "155", source: "wanderersGuide", name: "Botín de carnicero", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { PER: 8, Nivel: 13 }, reqText: "PER 8, Nivel 13+", desc: "Cuando descuartizás con éxito un animal muerto, tirá +3 CD y obtené porciones adicionales de carne, según el total obtenido y las cantidades indicadas en el perfil de la criatura." },

        { id: "perk283", img: "156", source: "wanderersGuide", name: "Tiro certero", rank: 1, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { PER: 7, Nivel: 7 }, reqText: "PER 7, Nivel 7+", desc: "Cuando realizás un ataque a distancia con un arma de una mano y apuntaste antes de atacar, aumentá su alcance un paso: de Corto a Medio o de Medio a Largo." },
        { id: "perk284", img: "156", source: "wanderersGuide", name: "Tiro certero", rank: 2, ranks: 2, perkRequired: [], perkExclusive: [], reqs: { PER: 7, Nivel: 14 }, reqText: "PER 7, Nivel 14+", desc: "Cuando realizás un ataque a distancia con un arma de una mano y apuntaste antes de atacar, aumentá su alcance un paso. Además, el arma obtiene la cualidad Precisa si todavía no la tenía." },

        { id: "perk285", img: "157", source: "wanderersGuide", name: "Granada al hoyo", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { PER: 8, Nivel: 8 }, reqText: "PER 8, Nivel 8+", desc: "Cuando realizás un ataque a distancia con un arma arrojadiza que tenga la cualidad Explosión, la dificultad base del ataque es 1 en lugar de 2." },

        { id: "perk286", img: "158", source: "wanderersGuide", name: "Vista radiante", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { PER: 8, Nivel: 3 }, reqText: "PER 8, Nivel 3+", desc: "Cuando atacás a un enemigo resplandeciente, infligís +1 CD de daño." },
        { id: "perk287", img: "158", source: "wanderersGuide", name: "Vista radiante", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { PER: 8, Nivel: 11 }, reqText: "PER 8, Nivel 11+", desc: "Cuando atacás a un enemigo resplandeciente, infligís +2 CD de daño." },
        { id: "perk288", img: "158", source: "wanderersGuide", name: "Vista radiante", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { PER: 8, Nivel: 19 }, reqText: "PER 8, Nivel 19+", desc: "Cuando atacás a un enemigo resplandeciente, infligís +3 CD de daño." },

        { id: "perk289", img: "159", source: "wanderersGuide", name: "Ojos nocturnos", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { PER: 8, Nivel: 7 }, reqText: "PER 8, Nivel 7+", desc: "Cuando intentás pasar desapercibido u ocultarte de un enemigo, ignorá los aumentos de dificultad causados por la mala iluminación o la oscuridad." },

        { id: "perk290", img: "160", source: "wanderersGuide", name: "Caníbal", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { END: 8, Nivel: 10, NoRobot: true }, reqText: "END 8, Nivel 10+, no ser robot", desc: "Podés descuartizar a un humano muerto con una prueba de END + Supervivencia de dificultad 0. El éxito produce una porción de carne humana que podés consumir inmediatamente. Cuenta como alimento, restaura 4 PG y es irradiada: tirá 1 CD y sufrí 1 punto de daño por radiación si obtenés un Efecto. La práctica se considera abominable y es delito en la mayoría de los asentamientos. El canibalismo puede generar adicción: después de consumir carne humana, tirá tantos CD como veces hayas comido carne humana durante esta sesión. Si obtenés dos o más Efectos, te volvés adicto. Mientras estés adicto, ningún alimento salvo la carne humana satisface tu hambre. Tras cuatro horas saciado, ganás 1 Fatiga y pasás directamente a estar famélico. La adicción se cura como otras adicciones." },
        { id: "perk291", img: "160", source: "wanderersGuide", name: "Caníbal", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { END: 8, Nivel: 19, NoRobot: true }, reqText: "END 8, Nivel 19+, no ser robot", desc: "Podés descuartizar humanos y necrófagos muertos siguiendo las reglas de Caníbal. La carne humana restaura 4 PG, es irradiada y puede generar adicción según las reglas del perk." },
        { id: "perk292", img: "160", source: "wanderersGuide", name: "Caníbal", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { END: 8, Nivel: 28, NoRobot: true }, reqText: "END 8, Nivel 28+, no ser robot", desc: "Podés descuartizar humanos, necrófagos y supermutantes muertos siguiendo las reglas de Caníbal. La carne humana restaura 4 PG, es irradiada y puede generar adicción según las reglas del perk." },

        { id: "perk293", img: "161", source: "wanderersGuide", name: "Adicto a la Nuka-Cola", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { END: 6, Nivel: 14, NoRobot: true }, reqText: "END 6, Nivel 14+, no ser robot", desc: "Cuando tomás una bebida Nuka-Cola, recuperás el doble de PG de lo normal." },

        { id: "perk294", img: "162", source: "wanderersGuide", name: "Dromedario", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { END: 7, Nivel: 3, NoRobot: true }, reqText: "END 7, Nivel 3+, no ser robot", desc: "Cuando tomás una bebida, tu estado de sed mejora un paso adicional hacia saciado: dos pasos en total, o tres si tomás agua purificada." },

        { id: "perk295", img: "163", source: "wanderersGuide", name: "A prueba de fuego", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { END: 6, Nivel: 7 }, reqText: "END 6, Nivel 7+", desc: "Obtenés +1 de resistencia al daño de energía contra lanzallamas, cócteles molotov, otras armas basadas en fuego y armas con la cualidad Explosión." },
        { id: "perk296", img: "163", source: "wanderersGuide", name: "A prueba de fuego", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { END: 6, Nivel: 14 }, reqText: "END 6, Nivel 14+", desc: "Obtenés +2 de resistencia al daño de energía contra lanzallamas, cócteles molotov, otras armas basadas en fuego y armas con la cualidad Explosión." },
        { id: "perk297", img: "163", source: "wanderersGuide", name: "A prueba de fuego", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { END: 6, Nivel: 21 }, reqText: "END 6, Nivel 21+", desc: "Obtenés +3 de resistencia al daño de energía contra lanzallamas, cócteles molotov, otras armas basadas en fuego y armas con la cualidad Explosión." },

        { id: "perk298", img: "164", source: "wanderersGuide", name: "Necrófago", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { END: 9, Nivel: 7, NoGhoul: true, NoRobot: true }, reqText: "END 9, Nivel 7+, no ser necrófago ni robot", desc: "Como un necrófago, tu cuerpo se cura al exponerse a la radiación: recuperás 1 PG por cada 4 puntos de daño por radiación sufridos. Tu PG máximo sigue reduciéndose por el daño por radiación." },
        { id: "perk299", img: "164", source: "wanderersGuide", name: "Necrófago", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { END: 9, Nivel: 15, NoGhoul: true, NoRobot: true }, reqText: "END 9, Nivel 15+, no ser necrófago ni robot", desc: "Como un necrófago, recuperás 1 PG por cada 3 puntos de daño por radiación sufridos. Tu PG máximo sigue reduciéndose por el daño por radiación." },
        { id: "perk300", img: "164", source: "wanderersGuide", name: "Necrófago", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { END: 9, Nivel: 23, NoGhoul: true, NoRobot: true }, reqText: "END 9, Nivel 23+, no ser necrófago ni robot", desc: "Como un necrófago, recuperás 1 PG por cada 2 puntos de daño por radiación sufridos. Tu PG máximo sigue reduciéndose por el daño por radiación." },

        { id: "perk301", img: "165", source: "wanderersGuide", name: "Blindaje férreo", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { END: 7, Nivel: 5 }, reqText: "END 7, Nivel 5+", desc: "Mientras llevás armadura, excepto servoarmadura, obtenés +1 a la resistencia al daño físico y de energía." },
        { id: "perk302", img: "165", source: "wanderersGuide", name: "Blindaje férreo", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { END: 7, Nivel: 10 }, reqText: "END 7, Nivel 10+", desc: "Mientras llevás armadura, excepto servoarmadura, obtenés +2 a la resistencia al daño físico y de energía." },
        { id: "perk303", img: "165", source: "wanderersGuide", name: "Blindaje férreo", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { END: 7, Nivel: 15 }, reqText: "END 7, Nivel 15+", desc: "Mientras llevás armadura, excepto servoarmadura, obtenés +3 a la resistencia al daño físico y de energía." },

        { id: "perk304", img: "166", source: "wanderersGuide", name: "Resistencia natural", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { END: 7, Nivel: 10 }, reqText: "END 7, Nivel 10+", desc: "Respirar vapores tóxicos y dormir a la intemperie sobre el suelo ya no supone un riesgo de contraer una enfermedad." },

        { id: "perk305", img: "167", source: "wanderersGuide", name: "Radicool", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { END: 6, Nivel: 12, NoInmuneRadiacion: true }, reqText: "END 6, Nivel 12+, no ser inmune a la radiación", desc: "Cuando tu daño por radiación alcanza al menos un cuarto de tu PG máximo, podés repetir 1d20 en todas las pruebas basadas en FUE y añadir +1 CD al daño de tus ataques cuerpo a cuerpo. Si alcanza la mitad de tu PG máximo, podés repetir hasta 2d20 y añadís +2 CD. Si alcanza tres cuartas partes, podés repetir hasta 3d20 y añadís +3 CD." },

        { id: "perk306", img: "168", source: "wanderersGuide", name: "Revenant", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { END: 8, Nivel: 12 }, reqText: "END 8, Nivel 12+", desc: "Cuando te reviven, aumentá el daño de todos tus ataques en +2 CD hasta el final de la escena o hasta que vuelvas a quedar en 0 PG." },

        { id: "perk307", img: "169", source: "wanderersGuide", name: "Metabolismo lento", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { END: 7, Nivel: 5, NoRobot: true }, reqText: "END 7, Nivel 5+, no ser robot", desc: "Cuando comés un alimento, tu estado de hambre mejora un paso adicional hacia saciado: dos pasos con comida cruda o tres con comida cocinada." },

        { id: "perk308", img: "170", source: "wanderersGuide", name: "Calmased", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { END: 7, Nivel: 6 }, reqText: "END 7, Nivel 6+", desc: "Tomar agua sucia ya no supone un riesgo de contraer una enfermedad." },

        { id: "perk309", img: "171", source: "wanderersGuide", name: "Vacunado", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { END: 7, Nivel: 16 }, reqText: "END 7, Nivel 16+", desc: "Recibir daño por las garras o mordeduras de un mamífero, reptil o insecto ya no supone un riesgo de contraer una enfermedad." },

        { id: "perk310", img: "172", source: "wanderersGuide", name: "Chupasangre", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { CHA: 6, Nivel: 11 }, reqText: "CHA 6, Nivel 11+", desc: "Consumir una bolsa de sangre, incluidas las bolsas de sangre resplandeciente y la sangre irradiada, ahora cura el doble de PG y mejora tu estado de sed un paso hacia saciado. Al consumir sangre irradiada, solo tirás 1 CD para determinar el daño por radiación." },

        { id: "perk311", img: "173", source: "wanderersGuide", name: "Respondedor", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { CHA: 8, INT: 7, Nivel: 9 }, reqText: "CHA 8, INT 7, Nivel 9+", desc: "Cuando tenés éxito en una acción de Primeros auxilios durante el combate para estabilizar a un aliado moribundo, ya no necesitás gastar 1 PA para despertarlo. Además, el paciente recupera 2 PG al comienzo de su próximo turno." },
        { id: "perk312", img: "173", source: "wanderersGuide", name: "Respondedor", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { CHA: 8, INT: 7, Nivel: 16 }, reqText: "CHA 8, INT 7, Nivel 16+", desc: "Cuando tenés éxito en una acción de Primeros auxilios durante el combate para estabilizar a un aliado moribundo, ya no necesitás gastar 1 PA para despertarlo. Además, el paciente recupera 4 PG al comienzo de sus próximos dos turnos." },
        { id: "perk313", img: "173", source: "wanderersGuide", name: "Respondedor", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { CHA: 8, INT: 7, Nivel: 23 }, reqText: "CHA 8, INT 7, Nivel 23+", desc: "Cuando tenés éxito en una acción de Primeros auxilios durante el combate para estabilizar a un aliado moribundo, ya no necesitás gastar 1 PA para despertarlo. Además, el paciente recupera 6 PG al comienzo de sus próximos tres turnos." },

        { id: "perk314", img: "174", source: "wanderersGuide", name: "Cirujano de campaña", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { CHA: 8, INT: 8, Nivel: 15 }, reqText: "CHA 8, INT 8, Nivel 15+", desc: "Cuando usás un Estimulante, incluido uno diluido o súper, como parte de una acción de Primeros auxilios, podés curar 3 PG por cada PA gastado. Cuando usás RadAway, incluido el diluido, como parte de esa acción, eliminás un punto adicional de daño por radiación por cada PA gastado." },

        { id: "perk315", img: "175", source: "wanderersGuide", name: "Buena estrella", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { CHA: 9, Nivel: 17 }, reqText: "CHA 9, Nivel 17+", desc: "La primera vez por escena que consumís una bebida alcohólica, recuperás 1 punto de Suerte, hasta tu máximo normal de puntos de Suerte." },

        { id: "perk316", img: "176", source: "wanderersGuide", name: "Manos sanadoras", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { CHA: 8, INT: 7, Nivel: 18 }, reqText: "CHA 8, INT 7, Nivel 18+", desc: "Cuando tenés éxito en una acción de Primeros auxilios durante el combate para estabilizar a un aliado moribundo, ese aliado también elimina una cantidad de daño por radiación igual a tu rango en Medicina." },

        { id: "perk317", img: "177", source: "wanderersGuide", name: "Excesivamente generoso", rank: 1, ranks: 1, perkRequired: [], perkExclusive: [], reqs: { CHA: 7, Nivel: 12, NoInmuneRadiacion: true }, reqText: "CHA 7, Nivel 12+, no ser inmune a la radiación", desc: "Cuando tu daño por radiación alcanza o supera un cuarto de tu PG máximo, tus ataques cuerpo a cuerpo obtienen el efecto de daño Radiactivo." },

        { id: "perk318", img: "178", source: "wanderersGuide", name: "Sanador espiritual", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { CHA: 7, Nivel: 6 }, reqText: "CHA 7, Nivel 6+", desc: "Cuando tenés éxito en una acción de Primeros auxilios para estabilizar a un aliado moribundo, recuperás 1 PG." },
        { id: "perk319", img: "178", source: "wanderersGuide", name: "Sanador espiritual", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { CHA: 7, Nivel: 15 }, reqText: "CHA 7, Nivel 15+", desc: "Cuando tenés éxito en una acción de Primeros auxilios para estabilizar a un aliado moribundo, recuperás 2 PG y otros 2 PG al comienzo de tu próximo turno." },
        { id: "perk320", img: "178", source: "wanderersGuide", name: "Sanador espiritual", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { CHA: 7, Nivel: 24 }, reqText: "CHA 7, Nivel 24+", desc: "Cuando tenés éxito en una acción de Primeros auxilios para estabilizar a un aliado moribundo, recuperás 3 PG y otros 3 PG al comienzo de cada uno de tus próximos dos turnos." },

        { id: "perk321", img: "179", source: "wanderersGuide", name: "Supresor", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { CHA: 6, Nivel: 10 }, reqText: "CHA 6, Nivel 10+", desc: "Cuando atacás con éxito a un enemigo, podés gastar 1 PA para suprimirlo hasta el final de su próximo turno. Mientras esté suprimido, el daño que inflige con sus ataques se reduce en 1 CD." },
        { id: "perk322", img: "179", source: "wanderersGuide", name: "Supresor", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { CHA: 6, Nivel: 20 }, reqText: "CHA 6, Nivel 20+", desc: "Cuando atacás con éxito a un enemigo, podés gastar 1 PA para suprimirlo hasta el final de su próximo turno. Mientras esté suprimido, el daño que inflige con sus ataques se reduce en 2 CD." },
        { id: "perk323", img: "179", source: "wanderersGuide", name: "Supresor", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { CHA: 6, Nivel: 30 }, reqText: "CHA 6, Nivel 30+", desc: "Cuando atacás con éxito a un enemigo, podés gastar 1 PA para suprimirlo hasta el final de su próximo turno. Mientras esté suprimido, el daño que inflige con sus ataques se reduce en 3 CD." },

        { id: "perk324", img: "180", source: "wanderersGuide", name: "Ablandador", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { CHA: 7, Nivel: 8 }, reqText: "CHA 7, Nivel 8+", desc: "Cuando impactás a un enemigo con un ataque cuerpo a cuerpo o a distancia, podés gastar 1 PA para volverlo vulnerable hasta el final de su próximo turno. Mientras sea vulnerable, cada ataque contra él inflige +1 CD de daño." },
        { id: "perk325", img: "180", source: "wanderersGuide", name: "Ablandador", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { CHA: 7, Nivel: 18 }, reqText: "CHA 7, Nivel 18+", desc: "Cuando impactás a un enemigo con un ataque cuerpo a cuerpo o a distancia, podés gastar 1 PA para volverlo vulnerable hasta el final de su próximo turno. Mientras sea vulnerable, cada ataque contra él inflige +2 CD de daño." },
        { id: "perk326", img: "180", source: "wanderersGuide", name: "Ablandador", rank: 3, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { CHA: 7, Nivel: 28 }, reqText: "CHA 7, Nivel 28+", desc: "Cuando impactás a un enemigo con un ataque cuerpo a cuerpo o a distancia, podés gastar 1 PA para volverlo vulnerable hasta el final de su próximo turno. Mientras sea vulnerable, cada ataque contra él inflige +3 CD de daño." },

