        { id: "perk151", img: "084", source:"coreBook" , name: "El Tamaño Importa", rank: 1, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { END: 7, AGI: 6 }, reqText: "END 7, AGI 6", desc: "Cuando realizás un ataque a distancia con cualquier arma pesada, agregás +1 CD al daño del arma.", system: [ {type: "extraRangeDamage", value: 1, condition: {weaponCategory: {"arma pesada"}}} ] },
        { id: "perk152", img: "084", source:"coreBook" , name: "El Tamaño Importa", rank: 2, ranks: 3, perkRequired: [], perkExclusive: [], reqs: { END: 7, AGI: 6, Nivel: 4 }, reqText: "END 7, AGI 6, Nivel 4+", desc: "Cuando realizás un ataque a distancia con cualquier arma pesada, agregás +2 CD al daño del arma.", system: [ {type: "extraRangeDamage", value: 2, condition: {weaponCategory: {"arma pesada"}}} ] },
